/* The base reset, layered under TacticalToybox.uss on every screen.

   This file used to carry a second, hand-written copy of the whole palette:
   forty-odd rgb() literals that disagreed with the tokens by a few points each
   (text #E0E9EB against #D6DBDD, edge #3C353E against #393839, disabled text at
   4.01:1 where the token cleared AA). The Toybox rules win on specificity
   wherever both define a property, so most of that copy was invisible — but the
   gameplay unit cards sit outside .toybox-ui on purpose, which meant the in-match
   HUD inherited the divergent values and the menus did not. Two sources of truth,
   one of them silently authoritative for the part of the game people look at
   most. Everything below now reads the tokens. */
@import url("TacticalToyboxTokens.uss");

/* Rubik is the interface family. This default matters beyond the menus: the gameplay unit and
   ability cards sit outside .toybox-ui scope on purpose, so they inherit their type from here
   rather than from the Toybox component library. */
:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Rubik/Rubik-VariableFont_wght UI SDF.asset");
    color: var(--toy-text);
    font-size: 12px;
}

/* Tabular figures for relay codes, counts, and timers only. Prose never takes this. */
.mono {
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
}

.screen {
    flex-grow: 1;
    background-color: var(--toy-ground);
    color: var(--toy-text);
}

.screen-frame {
    flex-grow: 1;
    padding: 38px 54px;
}

.command-ribbon {
    height: 36px;
    min-height: 36px;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    background-color: var(--toy-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--toy-divider);
}

.command-ribbon__beacon {
    width: 8px;
    height: 8px;
    margin-right: 11px;
    background-color: var(--toy-primary);
}

.command-ribbon__text {
    font-size: 11px;
    color: var(--toy-text-copy);
    letter-spacing: 1px;
}

.command-ribbon__route {
    margin-left: auto;
    font-size: 11px;
    color: var(--toy-text-muted);
    letter-spacing: 1px;
}

.brand-mark {
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
}

.panel {
    padding: 28px;
    background-color: var(--toy-panel);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-radius: 10px;
}

.panel--quiet {
    background-color: var(--toy-surface-pressed);
    border-color: var(--toy-divider);
}

.panel--blue {
    border-color: var(--toy-select);
}

.panel--amber {
    border-color: var(--toy-primary);
}

.title-xl {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--toy-text);
    letter-spacing: 1px;
}

.title-lg {
    font-size: 25px;
    -unity-font-style: bold;
    color: var(--toy-text);
}

.title-md {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--toy-text);
}

.label {
    font-size: 14px;
    color: var(--toy-text-copy);
}

.label--muted {
    color: var(--toy-text-muted);
}

.label--danger {
    color: var(--toy-danger-copy);
}

.label--amber {
    color: var(--toy-primary-copy);
}

.label--blue {
    color: var(--toy-team-friendly-copy);
}

.section-label {
    margin-bottom: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--toy-text-muted);
    letter-spacing: 1px;
}

.divider {
    height: 1px;
    margin-top: 18px;
    margin-bottom: 18px;
    background-color: var(--toy-divider);
}

.button {
    min-height: 44px;
    padding: 10px 18px;
    background-color: var(--toy-surface-raised);
    color: var(--toy-text);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-radius: 8px;
    -unity-font-style: bold;
    font-size: 14px;
    transition-duration: 0.12s;
    transition-property: background-color, border-color, color, opacity;
}

.button:hover {
    background-color: var(--toy-surface-hover);
    border-color: var(--toy-edge-strong);
}

.button:active {
    background-color: var(--toy-surface-pressed);
    border-color: var(--toy-edge-strong);
}

.button:focus {
    border-width: 2px;
    border-color: var(--toy-focus);
}

/* Opacity stays at 1: the disabled fill and the muted label already say the
   control is unavailable, and dimming on top of them dropped the text to
   4.01:1, the one AA failure in the project. */
.button:disabled {
    background-color: var(--toy-disabled-surface);
    border-color: var(--toy-disabled-border);
    color: var(--toy-text-muted);
    opacity: 1;
}

.button--primary {
    background-color: var(--toy-primary);
    border-color: var(--toy-primary-pressed);
    color: var(--toy-text-on-accent);
}

.button--primary:hover {
    background-color: var(--toy-primary-hover);
    border-color: var(--toy-text);
}

.button--primary:focus {
    border-color: var(--toy-text-on-accent);
}

.button--primary:disabled,
.button--primary:disabled:hover,
.button--primary:disabled:active {
    opacity: 1;
    background-color: var(--toy-disabled-surface);
    border-width: 1px;
    border-color: var(--toy-disabled-border);
    color: var(--toy-text-muted);
}

.button--danger {
    background-color: var(--toy-danger);
    border-color: var(--toy-danger-pressed);
    color: var(--toy-text-on-deep);
}

.button--danger:hover {
    background-color: var(--toy-danger-hover);
    border-color: var(--toy-edge-strong);
}

.button--selected {
    background-color: var(--toy-select);
    border-color: var(--toy-select-pressed);
    color: var(--toy-text-on-deep);
}

.button--selected:hover {
    background-color: var(--toy-select-hover);
    border-color: var(--toy-edge-strong);
}

.button--flat {
    background-color: var(--toy-transparent);
    border-color: var(--toy-transparent);
    color: var(--toy-text-muted);
}

.button--flat:hover {
    background-color: var(--toy-text-wash);
    border-color: var(--toy-text-border);
    color: var(--toy-text);
}

.text-field {
    margin-top: 6px;
    margin-bottom: 12px;
    color: var(--toy-text);
}

.text-field > .unity-base-text-field__input {
    min-height: 46px;
    padding: 10px 12px;
    background-color: var(--toy-inset);
    color: var(--toy-text);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-radius: 8px;
    font-size: 18px;
}

.text-field > .unity-base-text-field__input:hover {
    border-color: var(--toy-edge-strong);
}

.text-field > .unity-base-text-field__input:focus {
    border-color: var(--toy-focus);
}

.toggle {
    min-height: 36px;
    flex-direction: row;
    align-items: center;
    color: var(--toy-text);
    font-size: 14px;
}

.toggle > .unity-toggle__input {
    min-height: 22px;
    background-color: var(--toy-transparent);
    border-width: 0;
}

.toggle > .unity-toggle__input > .unity-toggle__checkmark {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin-right: 10px;
    background-image: none;
    background-color: var(--toy-inset);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-radius: 6px;
}

.toggle:hover > .unity-toggle__input > .unity-toggle__checkmark {
    border-color: var(--toy-edge-strong);
}

.toggle:focus > .unity-toggle__input > .unity-toggle__checkmark {
    border-color: var(--toy-focus);
}

.toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: var(--toy-select);
    border-color: var(--toy-select-pressed);
}

.modal-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 42px;
    background-color: var(--toy-scrim);
}

.modal {
    width: 680px;
    max-width: 92%;
    max-height: 88%;
    padding: 30px;
    background-color: var(--toy-surface);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-radius: 12px;
}

.modal:focus {
    border-color: var(--toy-focus);
}

.modal__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.modal-close {
    align-self: flex-end;
    min-width: 140px;
    margin-top: 24px;
}

.controls-panel {
    width: 760px;
    height: 680px;
    max-width: 92%;
    max-height: 88%;
}

.controls-scroll {
    flex-grow: 1;
    min-height: 0;
}

.controls-scroll .unity-scroll-view__content-container {
    padding-right: 12px;
}

.controls-scroll .unity-scroller--vertical {
    width: 12px;
    background-color: var(--toy-inset);
}

.controls-scroll .unity-base-slider__tracker {
    background-color: var(--toy-surface-pressed);
    border-color: var(--toy-divider);
}

.controls-scroll .unity-base-slider__dragger {
    background-color: var(--toy-text-muted);
    border-color: var(--toy-edge-strong);
}

.control-section {
    margin-bottom: 10px;
}

.control-section__label {
    margin-top: 4px;
    margin-bottom: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--toy-text-muted);
    letter-spacing: 1px;
}

.control-row {
    min-height: 48px;
    flex-direction: row;
    align-items: flex-start;
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--toy-divider);
}

.control-key {
    width: 176px;
    min-width: 176px;
    padding-right: 18px;
    color: var(--toy-text);
    -unity-font-style: bold;
}

.control-copy {
    flex-grow: 1;
    min-width: 0;
    color: var(--toy-text-copy);
    white-space: normal;
}

.control-row--last {
    border-bottom-width: 0;
}

.controls-panel .modal-close {
    margin-top: 16px;
}

.status-line {
    min-height: 24px;
    margin-top: 6px;
    margin-bottom: 8px;
    white-space: normal;
}

.hidden {
    display: none;
}

.compact .screen-frame {
    padding: 24px 30px;
}

.compact .panel {
    padding: 22px;
}

.compact .title-xl {
    font-size: 29px;
}

.narrow .command-ribbon__route {
    display: none;
}

.phone .screen-frame {
    padding-left: 16px;
    padding-right: 16px;
}

.phone .modal-shade {
    padding: 16px;
}

.phone .modal {
    max-width: 100%;
    padding: 22px;
}

.phone .controls-panel {
    padding: 18px;
}

.phone .control-row {
    min-height: 0;
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: 8px;
}

.phone .control-key {
    width: auto;
    min-width: 0;
    margin-bottom: 4px;
    padding-right: 0;
}

.phone .controls-panel .modal-close {
    width: 100%;
}

.short .screen-frame {
    padding-top: 18px;
    padding-bottom: 18px;
}

.short .controls-panel {
    height: 92%;
    max-height: 92%;
}
