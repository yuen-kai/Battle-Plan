/* Battle Plan — FIELD DAY base layer.
   Loaded before TacticalToybox.uss on every screen. Owns the element reset, the
   type scale from Palette §9.5 and the unscoped atoms. ArtDirection §3.3 delegates the
   scale to that table rather than restating it.

   Two engine limits shape everything below:
   - USS has no line-height, so Palette §9.5's line-height column is unreachable.
   - USS has no cubic-bezier(), so the Palette §9.6 easing tokens ship keywords rather than
     curves and rules reference them directly. ease-out-back's overshoot is fixed,
     so --bp-ease-snap cannot be dialled to its intended 56%. Plain `linear` stays
     literal: it marks a colour cross-fade with no motion to ease, and has no token. */

@import url("TacticalToyboxTokens.uss");

:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Rubik/Rubik-VariableFont_wght UI SDF.asset");
    color: var(--bp-text);
    font-size: var(--bp-type-body);
}

.screen {
    flex-grow: 1;
    background-color: var(--bp-transparent);
    color: var(--bp-text);
}

.screen-frame {
    flex-grow: 1;
}

.hidden {
    display: none;
}

/* --- Type ---------------------------------------------------------------- */

.type-hero {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-ExtraBold UI SDF.asset");
    font-size: var(--bp-type-hero);
    color: var(--bp-text);
    letter-spacing: 2px;
}

.title-xl {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-SemiBold UI SDF.asset");
    font-size: var(--bp-type-display);
    color: var(--bp-text);
    letter-spacing: 0.5px;
}

.title-lg {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-SemiBold UI SDF.asset");
    font-size: var(--bp-type-title);
    color: var(--bp-text);
    letter-spacing: 0.5px;
}

.title-md {
    font-size: var(--bp-type-title);
    -unity-font-style: bold;
    color: var(--bp-text);
}

.label {
    font-size: var(--bp-type-body);
    color: var(--bp-text-2);
}

.label--sm {
    font-size: var(--bp-type-body-sm);
}

.label--muted {
    color: var(--bp-text-2);
}

.label--danger {
    color: var(--bp-red-hi);
}

.label--amber {
    color: var(--bp-amber-hi);
}

.label--blue {
    color: var(--bp-blue);
}

.label--success {
    color: var(--bp-green-hi);
}

.section-label {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-SemiBold UI SDF.asset");
    margin-bottom: var(--bp-s2);
    font-size: var(--bp-type-label);
    color: var(--bp-text-3);
    letter-spacing: 1.6px;
}

.readout-key {
    font-size: var(--bp-type-label);
    -unity-font-style: bold;
    color: var(--bp-text-3);
    letter-spacing: 0.6px;
}

.state-word {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-ExtraBold UI SDF.asset");
    font-size: var(--bp-type-micro);
    letter-spacing: 1.5px;
}

/* Cascadia carries every number so digit width never changes between 10 and 9. */
.num {
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
}

/* --- Structure ------------------------------------------------------------ */

.divider {
    height: var(--bp-bw-hair);
    margin-top: var(--bp-s4);
    margin-bottom: var(--bp-s5);
    background-color: var(--bp-line-2);
}

.panel {
    padding: var(--bp-s5);
    background-color: var(--bp-deck-1);
    border-width: var(--bp-bw-hair);
    border-top-color: var(--bp-line-1);
    border-right-color: var(--bp-line-2);
    border-left-color: var(--bp-line-2);
    border-bottom-width: var(--bp-edge);
    border-bottom-color: var(--bp-edge-dark);
    border-radius: var(--bp-r-lg);
}

.card {
    padding: var(--bp-s4);
    background-color: var(--bp-deck-2);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
}

/* --- Button --------------------------------------------------------------- */

.button {
    min-height: var(--bp-target-lg);
    padding: 0 var(--bp-s4);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: var(--bp-deck-2);
    color: var(--bp-text);
    border-width: var(--bp-bw-hair);
    border-top-color: var(--bp-line-1);
    border-right-color: var(--bp-line-2);
    border-left-color: var(--bp-line-2);
    border-bottom-width: var(--bp-edge);
    border-bottom-color: var(--bp-edge-dark);
    border-radius: var(--bp-r-md);
    -unity-font-style: bold;
    font-size: var(--bp-type-body);
    letter-spacing: 0.3px;
    transition-property: background-color, border-color, border-width, color, translate;
    transition-duration: var(--bp-t-fast);
    transition-timing-function: var(--bp-ease-out);
}

.button:hover {
    background-color: var(--bp-deck-3);
    border-top-color: var(--bp-line-3);
    border-right-color: var(--bp-line-3);
    border-left-color: var(--bp-line-3);
}

.button:active {
    background-color: var(--bp-deck-4);
    border-bottom-width: var(--bp-bw-hair);
    translate: 0 1px;
    transition-duration: var(--bp-t-instant);
}

.button:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
    transition-duration: var(--bp-t-instant);
}

.button:disabled,
.button:disabled:hover,
.button:disabled:active {
    opacity: 1;
    background-color: var(--bp-deck-1);
    color: var(--bp-text-3);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-1);
    translate: 0 0;
    transition-timing-function: linear;
}

.button--primary {
    background-color: var(--bp-amber);
    color: var(--bp-text-on-accent);
    border-top-color: var(--bp-amber-deep);
    border-right-color: var(--bp-amber-deep);
    border-left-color: var(--bp-amber-deep);
}

.button--primary:hover {
    background-color: var(--bp-amber-hover);
    border-top-color: var(--bp-amber-deep);
    border-right-color: var(--bp-amber-deep);
    border-left-color: var(--bp-amber-deep);
}

.button--primary:active {
    background-color: var(--bp-amber-deep);
}

.button--primary:focus {
    border-color: var(--bp-focus-dark);
}

.button--ghost {
    min-height: var(--bp-target);
    background-color: var(--bp-transparent);
    color: var(--bp-text-2);
    border-width: 0;
    border-bottom-width: var(--bp-bw-hair);
    border-bottom-color: var(--bp-line-1);
}

.button--ghost:hover {
    background-color: var(--bp-line-1);
    color: var(--bp-text);
}

.button--ghost:active {
    background-color: var(--bp-line-2);
    translate: 0 1px;
}

.button--ghost:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.button--text {
    min-height: var(--bp-target-sm);
    padding: 0;
    justify-content: flex-start;
    background-color: var(--bp-transparent);
    color: var(--bp-text-3);
    border-width: 0;
    font-size: var(--bp-type-body-sm);
}

.button--text:hover {
    background-color: var(--bp-transparent);
    color: var(--bp-text-2);
}

.button--text:active {
    background-color: var(--bp-transparent);
    translate: 0 0;
}

.button--text:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

/* --- Text input ------------------------------------------------------------ */

.text-field {
    margin-top: var(--bp-s1);
    margin-bottom: var(--bp-s3);
    color: var(--bp-text);
}

.text-field > .unity-base-text-field__input {
    min-height: var(--bp-target-lg);
    padding: 0 var(--bp-s3);
    background-color: var(--bp-deck-0);
    color: var(--bp-text);
    --unity-cursor-color: var(--bp-blue);
    border-width: var(--bp-bw);
    border-color: var(--bp-line-3);
    border-radius: var(--bp-r-md);
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    font-size: var(--bp-type-num-lg);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 5px;
    transition-property: border-color, border-width;
    transition-duration: var(--bp-t-fast);
    transition-timing-function: var(--bp-ease-out);
}

.text-field > .unity-base-text-field__input:hover {
    border-color: var(--bp-paint);
}

.text-field > .unity-base-text-field__input:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.text-field--error > .unity-base-text-field__input {
    border-color: var(--bp-red);
}

.text-field.text-field--caret-hidden > .unity-base-text-field__input {
    --unity-cursor-color: var(--bp-transparent);
}

/* --- Toggle ---------------------------------------------------------------- */

.toggle {
    min-height: var(--bp-target);
    flex-direction: row;
    align-items: flex-start;
    color: var(--bp-text);
    font-size: var(--bp-type-body);
    -unity-font-style: bold;
}

/* The inline text lives inside the input, so this must keep its width. */
.toggle > .unity-toggle__input {
    min-height: 20px;
    align-items: flex-start;
    background-color: var(--bp-transparent);
    border-width: 0;
}

.toggle > .unity-toggle__input > .unity-toggle__checkmark {
    width: 20px;
    min-width: 20px;
    height: 20px;
    margin-top: 2px;
    margin-right: var(--bp-icon-gap);
    background-image: none;
    background-color: var(--bp-deck-0);
    border-width: var(--bp-bw);
    border-color: var(--bp-line-3);
    border-radius: var(--bp-r-sm);
    -unity-background-image-tint-color: var(--bp-text-on-accent);
    transition-property: background-color, border-color, border-width;
    transition-duration: var(--bp-t-fast);
    transition-timing-function: var(--bp-ease-out);
}

.toggle:hover > .unity-toggle__input > .unity-toggle__checkmark {
    border-color: var(--bp-paint);
}

.toggle:focus > .unity-toggle__input > .unity-toggle__checkmark {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: url("project://database/Assets/UI/Shared/Icons/check.svg");
    background-color: var(--bp-blue);
    border-color: var(--bp-blue);
    -unity-background-scale-mode: scale-to-fit;
}

.toggle:checked:focus > .unity-toggle__input > .unity-toggle__checkmark {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.toggle:disabled {
    opacity: 1;
    color: var(--bp-text-3);
}

.toggle:disabled > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: var(--bp-deck-1);
    border-color: var(--bp-line-1);
}

/* --- Status line ------------------------------------------------------------ */

.status-line {
    min-height: 20px;
    margin-top: var(--bp-s2);
    font-size: var(--bp-type-body-sm);
    color: var(--bp-text-2);
    white-space: normal;
    transition-property: color;
    transition-duration: var(--bp-t-fast);
    transition-timing-function: linear;
}

.status-line--busy {
    color: var(--bp-blue);
}

/* Fill and rule appear immediately — a fading error box reads as a bug. */
.status-line--success {
    padding: 6px var(--bp-s3);
    background-color: var(--bp-green-surface);
    color: var(--bp-green-hi);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-green);
    border-radius: var(--bp-r-sm);
}

.status-line.label--danger,
.status-line--danger {
    padding: 6px var(--bp-s3);
    background-color: var(--bp-red-surface);
    color: var(--bp-red-hi);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-red);
    border-radius: var(--bp-r-sm);
}

/* --- Dialog ------------------------------------------------------------------ */

.modal-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--bp-s6);
    background-color: var(--bp-scrim);
}

.modal {
    width: 680px;
    max-width: 92%;
    max-height: 90%;
    padding: var(--bp-s6);
    background-color: var(--bp-deck-1);
    border-width: var(--bp-bw-hair);
    border-top-color: var(--bp-line-1);
    border-right-color: var(--bp-line-2);
    border-left-color: var(--bp-line-2);
    border-bottom-width: var(--bp-edge);
    border-bottom-color: var(--bp-edge-dark);
    border-radius: var(--bp-r-lg);
}

.modal:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.modal__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.modal-close {
    align-self: flex-end;
    min-width: 140px;
    margin-top: var(--bp-s5);
}

.controls-panel {
    width: 760px;
    height: 680px;
    max-width: 92%;
    max-height: 90%;
}

.controls-scroll {
    flex-grow: 1;
    min-height: 0;
}

.controls-scroll .unity-scroll-view__content-container {
    padding-right: var(--bp-s3);
}

.control-section {
    margin-bottom: var(--bp-s3);
}

.control-section__label {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-SemiBold UI SDF.asset");
    margin-top: var(--bp-s1);
    margin-bottom: var(--bp-s2);
    font-size: var(--bp-type-label);
    color: var(--bp-amber);
    letter-spacing: 1.6px;
}

.control-row {
    min-height: 44px;
    flex-direction: row;
    align-items: flex-start;
    padding-top: var(--bp-s3);
    padding-bottom: var(--bp-s3);
    border-bottom-width: var(--bp-bw-hair);
    border-bottom-color: var(--bp-line-1);
}

.control-key {
    width: 176px;
    min-width: 176px;
    padding-right: var(--bp-s4);
    color: var(--bp-text);
    -unity-font-style: bold;
}

.control-copy {
    flex-grow: 1;
    min-width: 0;
    color: var(--bp-text-2);
    white-space: normal;
}

.control-row--last {
    border-bottom-width: 0;
}

.controls-panel .modal-close {
    margin-top: var(--bp-s4);
}

/* --- Scrollbars ---------------------------------------------------------------- */

.unity-scroller--vertical {
    width: var(--bp-scroll);
    background-color: var(--bp-deck-0);
    border-width: 0;
}

.unity-scroller--horizontal {
    height: var(--bp-scroll);
    background-color: var(--bp-deck-0);
    border-width: 0;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-base-slider__tracker {
    background-color: var(--bp-transparent);
    border-width: 0;
}

.unity-base-slider__dragger {
    background-color: var(--bp-deck-4);
    border-width: 0;
    border-radius: var(--bp-r-sm);
}

.unity-base-slider__dragger:hover {
    background-color: var(--bp-deck-5);
}

/* --- Responsive ------------------------------------------------------------------ */

.phone .modal-shade {
    padding: var(--bp-s4);
}

.phone .modal {
    max-width: 100%;
    padding: var(--bp-s5);
}

.phone .controls-panel {
    padding: var(--bp-s4);
}

.phone .control-row {
    min-height: 0;
    flex-direction: column;
    padding-top: var(--bp-s2);
    padding-bottom: var(--bp-s2);
}

.phone .control-key {
    width: auto;
    min-width: 0;
    margin-bottom: var(--bp-s1);
    padding-right: 0;
}

.phone .controls-panel .modal-close {
    width: 100%;
}

.phone .button {
    min-height: var(--bp-target-phone);
}

.phone .button--ghost,
.phone .button--text {
    min-height: var(--bp-target);
}

.short .controls-panel {
    height: 92%;
    max-height: 92%;
}
