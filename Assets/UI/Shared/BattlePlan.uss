/* The base reset, layered under TacticalToybox.uss on every screen.

   This file used to carry a second, hand-written copy of the whole palette:
   forty-odd rgb() literals that disagreed with the tokens by a few points each.
   The Toybox rules win on specificity wherever both define a property, so most
   of that copy was invisible — but the gameplay unit cards sit outside
   .toybox-ui on purpose, which meant the in-match HUD inherited the divergent
   values and the menus did not. Two sources of truth, one of them silently
   authoritative for the part of the game people look at most. Everything below
   now reads the tokens. */
@import url("TacticalToyboxTokens.uss");

/* Jost is the reading face: a geometric sans in the place Overwatch uses
   Futura. It is the default because prose must never be caught by the caps
   face, and because the in-match unit and ability cards sit outside the
   .toybox-ui scope on purpose and inherit their type from here.

   Anything that is chrome rather than prose asks for the display face
   explicitly. There is no shorthand for it: USS cannot put a var() inside a
   url(), so the path is written out at each call site. */
:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Jost/Jost-Regular UI SDF.asset");
    color: var(--toy-text);
    font-size: 12px;
    letter-spacing: var(--toy-track-body);
}

/* Numerals, codes and timers. Condensed caps rather than a typewriter face:
   a countdown in this interface should look like the one over an Overwatch
   objective, and Oswald's digits are uniform enough not to jitter as they
   count. */
.mono {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    letter-spacing: var(--toy-track-label);
}

.screen {
    flex-grow: 1;
    background-color: var(--toy-ground);
    color: var(--toy-text);
}

.screen-frame {
    flex-grow: 1;
    padding: 38px 54px;
}

.command-ribbon {
    height: 34px;
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    background-color: var(--toy-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--toy-divider);
}

.command-ribbon__beacon {
    width: 8px;
    height: 8px;
    margin-right: 11px;
    background-color: var(--toy-primary);
}

.command-ribbon__text {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 12px;
    color: var(--toy-text-copy);
    letter-spacing: var(--toy-track-label);
}

.command-ribbon__route {
    margin-left: auto;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 12px;
    color: var(--toy-text-muted);
    letter-spacing: var(--toy-track-label);
}

.brand-mark {
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
}

.panel {
    padding: 26px;
    background-color: var(--toy-panel);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-top-color: var(--toy-edge-strong);
    border-radius: var(--toy-radius-md);
}

.panel--quiet {
    background-color: var(--toy-surface-pressed);
    border-color: var(--toy-divider);
}

.panel--blue {
    border-color: var(--toy-team-friendly);
}

.panel--amber {
    border-top-width: var(--toy-accent-rule);
    border-top-color: var(--toy-primary);
}

/* The oblique cut, available to the gameplay subtrees that sit outside the
   component library's scope. Reserved for the big moments — a verdict, a
   callout — never for a control. */
.toy-oblique {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCapsObl-Regular UI SDF.asset");
}

.title-xl {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCapsObl-Regular UI SDF.asset");
    font-size: 38px;
    color: var(--toy-text);
    letter-spacing: var(--toy-track-display);
    text-shadow: 0 2px 6px var(--toy-shadow-stage);
}

.title-lg {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 27px;
    color: var(--toy-text);
    letter-spacing: var(--toy-track-title);
}

.title-md {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 19px;
    color: var(--toy-text);
    letter-spacing: var(--toy-track-title);
}

.label {
    font-size: 14px;
    color: var(--toy-text-copy);
}

.label--muted {
    color: var(--toy-text-muted);
}

.label--danger {
    color: var(--toy-danger-copy);
}

.label--amber {
    color: var(--toy-primary-copy);
}

.section-label {
    margin-bottom: 10px;
    padding-left: 9px;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 12px;
    color: var(--toy-text-muted);
    letter-spacing: var(--toy-track-label);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-primary);
}

.divider {
    height: 1px;
    margin-top: 18px;
    margin-bottom: 18px;
    background-color: var(--toy-divider);
}

.button {
    min-height: 44px;
    padding: 10px 18px;
    background-color: var(--toy-surface-raised);
    color: var(--toy-text);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-md);
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 15px;
    letter-spacing: var(--toy-track-label);
    transition-duration: var(--toy-motion-fast);
    transition-property: background-color, border-color, color;
}

.button:hover {
    background-color: var(--toy-select);
    color: var(--toy-text-on-deep);
    border-color: var(--toy-select);
}

.button:active {
    background-color: var(--toy-select-pressed);
    color: var(--toy-text-on-deep);
    border-color: var(--toy-select-pressed);
}

.button:focus {
    border-width: 2px;
    border-color: var(--toy-focus);
}

/* Opacity stays at 1: the disabled fill and the muted label already say the
   control is unavailable, and dimming on top of them dropped the text to
   4.01:1, the one AA failure in the project. */
.button:disabled {
    background-color: var(--toy-disabled-surface);
    border-color: var(--toy-disabled-border);
    color: var(--toy-text-muted);
    opacity: 1;
}

.button--primary {
    background-color: var(--toy-primary);
    border-color: var(--toy-primary);
    color: var(--toy-text-on-primary);
}

.button--primary:hover {
    background-color: var(--toy-primary-hover);
    border-color: var(--toy-primary-hover);
    color: var(--toy-text-on-primary);
}

.button--primary:focus {
    border-color: var(--toy-text-on-accent);
}

.button--primary:disabled,
.button--primary:disabled:hover,
.button--primary:disabled:active {
    opacity: 1;
    background-color: var(--toy-disabled-surface);
    border-width: 1px;
    border-color: var(--toy-disabled-border);
    color: var(--toy-text-muted);
}

/* The red plate stays red in both themes, so its ink cannot be the one that
   flips with them: --toy-text-on-deep turns near-black on the HUD and lands at
   3.8:1 on this fill. */
.button--danger {
    background-color: var(--toy-danger);
    border-color: var(--toy-danger);
    color: var(--toy-text-on-danger);
}

.button--danger:hover {
    background-color: var(--toy-danger-hover);
    border-color: var(--toy-danger-hover);
    color: var(--toy-text-on-danger);
}

.button--selected {
    background-color: var(--toy-select);
    border-color: var(--toy-select);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-primary);
    color: var(--toy-text-on-deep);
}

.button--selected:hover {
    background-color: var(--toy-select-hover);
    border-color: var(--toy-select-hover);
    border-left-color: var(--toy-primary);
}

.button--flat {
    background-color: var(--toy-transparent);
    border-color: var(--toy-transparent);
    color: var(--toy-text-muted);
}

.button--flat:hover {
    background-color: var(--toy-select);
    border-color: var(--toy-select);
    color: var(--toy-text-on-deep);
}

.text-field {
    margin-top: 6px;
    margin-bottom: 12px;
    color: var(--toy-text);
}

.text-field > .unity-base-text-field__input {
    min-height: 46px;
    padding: 10px 12px;
    background-color: var(--toy-inset);
    color: var(--toy-text);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-md);
    font-size: 18px;
}

.text-field > .unity-base-text-field__input:hover {
    border-color: var(--toy-edge-strong);
}

.text-field > .unity-base-text-field__input:focus {
    border-color: var(--toy-focus);
}

.toggle {
    min-height: 36px;
    flex-direction: row;
    align-items: center;
    color: var(--toy-text);
    font-size: 14px;
}

.toggle > .unity-toggle__input {
    min-height: 22px;
    background-color: var(--toy-transparent);
    border-width: 0;
}

.toggle > .unity-toggle__input > .unity-toggle__checkmark {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin-right: 10px;
    background-image: none;
    background-color: var(--toy-inset);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-sm);
}

.toggle:hover > .unity-toggle__input > .unity-toggle__checkmark {
    border-color: var(--toy-edge-strong);
}

.toggle:focus > .unity-toggle__input > .unity-toggle__checkmark {
    border-color: var(--toy-focus);
}

.toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: var(--toy-primary);
    border-color: var(--toy-primary);
}

.modal-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 42px;
    background-color: var(--toy-scrim);
}

.modal {
    width: 680px;
    max-width: 92%;
    max-height: 88%;
    padding: 30px;
    background-color: var(--toy-panel-sheer);
    border-width: 1px;
    border-color: var(--toy-edge);
    border-top-width: var(--toy-accent-rule);
    border-top-color: var(--toy-primary);
    border-radius: var(--toy-radius-lg);
}

.modal:focus {
    border-color: var(--toy-edge-strong);
    border-top-color: var(--toy-primary);
}

.modal__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.modal-close {
    align-self: flex-end;
    min-width: 160px;
    margin-top: 24px;
}

.controls-panel {
    width: 760px;
    height: 680px;
    max-width: 92%;
    max-height: 88%;
}

.controls-scroll {
    flex-grow: 1;
    min-height: 0;
}

.controls-scroll .unity-scroll-view__content-container {
    padding-right: 12px;
}

.controls-scroll .unity-scroller--vertical {
    width: var(--toy-scroll-size);
    background-color: var(--toy-inset);
}

.controls-scroll .unity-base-slider__tracker {
    background-color: var(--toy-inset);
    border-color: var(--toy-divider);
}

.controls-scroll .unity-base-slider__dragger {
    background-color: var(--toy-text-muted);
    border-width: 0;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.control-section {
    margin-bottom: 10px;
}

.control-section__label {
    margin-top: 4px;
    margin-bottom: 6px;
    padding-left: 9px;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 11px;
    color: var(--toy-primary-copy);
    letter-spacing: var(--toy-track-label);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-primary);
}

.control-row {
    min-height: 48px;
    flex-direction: row;
    align-items: flex-start;
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--toy-divider);
}

.control-key {
    width: 176px;
    min-width: 176px;
    padding-right: 18px;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    color: var(--toy-text);
    letter-spacing: var(--toy-track-label);
}

.control-copy {
    flex-grow: 1;
    min-width: 0;
    color: var(--toy-text-copy);
    white-space: normal;
}

.control-row--last {
    border-bottom-width: 0;
}

.controls-panel .modal-close {
    margin-top: 16px;
}

.status-line {
    min-height: 24px;
    margin-top: 6px;
    margin-bottom: 8px;
    white-space: normal;
}

.hidden {
    display: none;
}

.compact .screen-frame {
    padding: 24px 30px;
}

.compact .panel {
    padding: 22px;
}

.compact .title-xl {
    font-size: 32px;
}

.narrow .command-ribbon__route {
    display: none;
}

.phone .screen-frame {
    padding-left: 16px;
    padding-right: 16px;
}

.phone .modal-shade {
    padding: 16px;
}

.phone .modal {
    max-width: 100%;
    padding: 22px;
}

.phone .controls-panel {
    padding: 18px;
}

.phone .control-row {
    min-height: 0;
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: 8px;
}

.phone .control-key {
    width: auto;
    min-width: 0;
    margin-bottom: 4px;
    padding-right: 0;
}

.phone .controls-panel .modal-close {
    width: 100%;
}

.short .screen-frame {
    padding-top: 18px;
    padding-bottom: 18px;
}

.short .controls-panel {
    height: 92%;
    max-height: 92%;
}
