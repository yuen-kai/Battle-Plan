:root {
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    color: rgb(231, 236, 240);
    font-size: 12px;
}

.screen {
    flex-grow: 1;
    background-color: rgb(5, 9, 15);
    color: rgb(231, 236, 240);
}

.screen-frame {
    flex-grow: 1;
    padding: 38px 54px;
}

.command-ribbon {
    height: 36px;
    min-height: 36px;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(11, 18, 27);
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 66, 82);
}

.command-ribbon__beacon {
    width: 8px;
    height: 8px;
    margin-right: 11px;
    background-color: rgb(229, 160, 55);
}

.command-ribbon__text {
    font-size: 11px;
    color: rgb(166, 180, 193);
    letter-spacing: 1px;
}

.command-ribbon__route {
    margin-left: auto;
    font-size: 11px;
    color: rgb(111, 130, 147);
    letter-spacing: 1px;
}

.brand-mark {
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
}

.panel {
    padding: 28px;
    background-color: rgba(12, 20, 30, 0.98);
    border-width: 1px;
    border-color: rgb(45, 62, 78);
    border-radius: 3px;
}

.panel--quiet {
    background-color: rgba(8, 14, 22, 0.92);
    border-color: rgb(31, 45, 58);
}

.panel--blue {
    border-color: rgb(48, 111, 158);
}

.panel--amber {
    border-color: rgb(133, 97, 39);
}

.title-xl {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(245, 247, 249);
    letter-spacing: 1px;
}

.title-lg {
    font-size: 25px;
    -unity-font-style: bold;
    color: rgb(245, 247, 249);
}

.title-md {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(232, 237, 241);
}

.label {
    font-size: 14px;
    color: rgb(199, 209, 218);
}

.label--muted {
    color: rgb(151, 166, 180);
}

.label--danger {
    color: rgb(255, 126, 118);
}

.label--amber {
    color: rgb(238, 180, 80);
}

.label--blue {
    color: rgb(108, 191, 244);
}

.section-label {
    margin-bottom: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(162, 177, 190);
    letter-spacing: 1px;
}

.divider {
    height: 1px;
    margin-top: 18px;
    margin-bottom: 18px;
    background-color: rgb(42, 57, 71);
}

.button {
    min-height: 44px;
    padding: 10px 18px;
    background-color: rgb(25, 39, 52);
    color: rgb(234, 239, 243);
    border-width: 1px;
    border-color: rgb(69, 89, 107);
    border-radius: 2px;
    -unity-font-style: bold;
    font-size: 14px;
    transition-duration: 0.12s;
    transition-property: background-color, border-color, color, opacity;
}

.button:hover {
    background-color: rgb(34, 51, 66);
    border-color: rgb(99, 128, 151);
}

.button:active {
    background-color: rgb(19, 30, 41);
    border-color: rgb(229, 160, 55);
}

.button:focus {
    border-color: rgb(237, 174, 65);
}

.button:disabled {
    background-color: rgb(16, 24, 33);
    border-color: rgb(42, 54, 65);
    color: rgb(112, 124, 135);
    opacity: 0.78;
}

.button--primary {
    background-color: rgb(24, 91, 142);
    border-color: rgb(82, 169, 230);
    color: rgb(248, 251, 253);
}

.button--primary:hover {
    background-color: rgb(29, 108, 166);
    border-color: rgb(124, 202, 249);
}

.button--danger {
    background-color: rgb(91, 28, 35);
    border-color: rgb(185, 69, 78);
}

.button--danger:hover {
    background-color: rgb(112, 34, 42);
    border-color: rgb(225, 91, 100);
}

.button--selected {
    background-color: rgb(77, 56, 21);
    border-color: rgb(237, 174, 65);
    color: rgb(255, 232, 188);
}

.button--selected:hover {
    background-color: rgb(91, 66, 25);
    border-color: rgb(251, 191, 84);
}

.button--flat {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: rgb(171, 185, 198);
}

.button--flat:hover {
    background-color: rgb(20, 31, 42);
    border-color: rgb(54, 72, 88);
    color: rgb(237, 241, 244);
}

.text-field {
    margin-top: 6px;
    margin-bottom: 12px;
    color: rgb(226, 232, 237);
}

.text-field > .unity-base-text-field__input {
    min-height: 46px;
    padding: 10px 12px;
    background-color: rgb(7, 13, 20);
    color: rgb(243, 246, 248);
    border-width: 1px;
    border-color: rgb(58, 76, 92);
    border-radius: 2px;
    font-size: 18px;
}

.text-field > .unity-base-text-field__input:hover {
    border-color: rgb(88, 111, 131);
}

.text-field > .unity-base-text-field__input:focus {
    border-color: rgb(237, 174, 65);
}

.toggle {
    min-height: 36px;
    flex-direction: row;
    align-items: center;
    color: rgb(214, 222, 229);
    font-size: 14px;
}

.toggle > .unity-toggle__input {
    min-height: 22px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.toggle > .unity-toggle__input > .unity-toggle__checkmark {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin-right: 10px;
    background-image: none;
    background-color: rgb(8, 14, 22);
    border-width: 1px;
    border-color: rgb(72, 91, 108);
    border-radius: 2px;
}

.toggle:hover > .unity-toggle__input > .unity-toggle__checkmark {
    border-color: rgb(109, 137, 160);
}

.toggle:focus > .unity-toggle__input > .unity-toggle__checkmark {
    border-color: rgb(237, 174, 65);
}

.toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: rgb(31, 112, 166);
    border-color: rgb(103, 194, 247);
}

.modal-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 42px;
    background-color: rgba(2, 5, 9, 0.9);
}

.modal {
    width: 680px;
    max-width: 92%;
    max-height: 88%;
    padding: 30px;
    background-color: rgb(12, 20, 30);
    border-width: 1px;
    border-color: rgb(76, 99, 119);
    border-radius: 3px;
}

.modal:focus {
    border-color: rgb(102, 129, 151);
}

.modal__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.modal-close {
    align-self: flex-end;
    min-width: 140px;
    margin-top: 24px;
}

.status-line {
    min-height: 24px;
    margin-top: 6px;
    margin-bottom: 8px;
    white-space: normal;
}

.hidden {
    display: none;
}

.compact .screen-frame {
    padding: 24px 30px;
}

.compact .panel {
    padding: 22px;
}

.compact .title-xl {
    font-size: 29px;
}

.narrow .command-ribbon__route {
    display: none;
}

.phone .screen-frame {
    padding-left: 16px;
    padding-right: 16px;
}

.phone .modal-shade {
    padding: 16px;
}

.phone .modal {
    max-width: 100%;
    padding: 22px;
}

.short .screen-frame {
    padding-top: 18px;
    padding-bottom: 18px;
}
