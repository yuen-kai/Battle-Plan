@import url("TacticalToyboxTokens.uss");

.toybox-ui {
    -unity-font-definition: url("project://database/Assets/Fonts/Rubik/Rubik-VariableFont_wght UI SDF.asset");
    color: var(--toy-text);
    font-size: var(--toy-type-body);
    background-color: var(--toy-transparent);
}

.toybox-ui .toy-panel,
.toybox-ui .panel {
    padding: var(--toy-space-panel);
    background-color: var(--toy-panel);
    border-width: var(--toy-stroke-thin);
    border-bottom-width: var(--toy-depth-panel);
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-lg);
}

.toybox-ui .toy-panel--compact {
    padding: var(--toy-space-panel-compact);
    border-bottom-width: var(--toy-depth-pressed);
    border-radius: var(--toy-radius-md);
}

.toybox-ui .button {
    min-height: var(--toy-target);
    padding: var(--toy-space-control-top) var(--toy-space-control-x) var(--toy-space-control-bottom) var(--toy-space-control-x);
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--toy-surface-raised);
    color: var(--toy-text);
    border-width: var(--toy-focus-width);
    border-bottom-width: var(--toy-depth-rest);
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-md);
    -unity-font-style: bold;
    font-size: var(--toy-type-body);
    transition-duration: var(--toy-motion-fast);
    transition-property: background-color, border-color, color, opacity;
}

.toybox-ui .button:hover {
    background-color: var(--toy-surface-hover);
    border-color: var(--toy-edge-strong);
}

.toybox-ui .button:active {
    padding-top: var(--toy-space-control-active-top);
    padding-bottom: var(--toy-space-control-active-bottom);
    border-bottom-width: var(--toy-depth-pressed);
    background-color: var(--toy-surface-pressed);
}

/* Flat theme: the ring is a uniform two-pixel border rather than a thickening of
   three sides around an offset bottom edge. */
.toybox-ui .button:focus {
    border-width: var(--toy-focus-emphasis);
    border-color: var(--toy-focus);
}

/* Focus reads as primary orange everywhere except on the primary fill itself.
   An orange ring would vanish there, and a light one only reaches 2:1 against
   the orange; a dark ring clears 7:1. */
.toybox-ui .button--primary:focus,
.toybox-ui .button--primary:hover:focus,
.toybox-ui .button--primary:active:focus {
    border-color: var(--toy-text-on-accent);
}

.toybox-ui .button:disabled,
.toybox-ui .button:disabled:hover,
.toybox-ui .button:disabled:active {
    padding-top: var(--toy-space-control-top);
    padding-bottom: var(--toy-space-control-bottom);
    background-color: var(--toy-disabled-surface);
    color: var(--toy-text-muted);
    border-width: var(--toy-focus-width);
    border-bottom-width: var(--toy-focus-width);
    border-color: var(--toy-disabled-border);
    opacity: 1;
}

.toybox-ui .button--primary {
    background-color: var(--toy-primary);
    color: var(--toy-text-on-accent);
    border-color: var(--toy-edge);
}

.toybox-ui .button--primary:hover {
    background-color: var(--toy-primary-hover);
    border-color: var(--toy-edge-strong);
}

.toybox-ui .button--primary:active {
    background-color: var(--toy-primary-pressed);
}

.toybox-ui .button--selected,
.toybox-ui .button--selected:hover {
    background-color: var(--toy-select);
    color: var(--toy-text-on-deep);
    border-color: var(--toy-edge-strong);
}

.toybox-ui .button--selected:focus {
    background-color: var(--toy-select-pressed);
    border-color: var(--toy-focus);
}

.toybox-ui .button--selected:active {
    background-color: var(--toy-select-pressed);
}

.toybox-ui .button--danger {
    background-color: var(--toy-danger);
    color: var(--toy-text-on-deep);
}

.toybox-ui .button--danger:hover {
    background-color: var(--toy-danger-hover);
    border-color: var(--toy-edge-strong);
}

.toybox-ui .button--danger:active {
    background-color: var(--toy-danger-pressed);
}

.toybox-ui .button--flat {
    min-height: var(--toy-target-compact);
    padding: var(--toy-space-sm) var(--toy-space-md);
    background-color: var(--toy-transparent);
    color: var(--toy-text);
    border-bottom-width: var(--toy-focus-width);
    border-color: var(--toy-text-border);
}

.toybox-ui .button--flat:hover {
    background-color: var(--toy-text-wash);
    border-color: var(--toy-edge-strong);
}

.toybox-ui .button--primary:disabled,
.toybox-ui .button--primary:disabled:hover,
.toybox-ui .button--selected:disabled,
.toybox-ui .button--selected:disabled:hover,
.toybox-ui .button--danger:disabled,
.toybox-ui .button--danger:disabled:hover {
    background-color: var(--toy-disabled-surface);
    color: var(--toy-text-muted);
    border-color: var(--toy-disabled-border);
}

/* Primary is deliberately absent here; its own rule above keeps a light ring. */
.toybox-ui .button:hover:focus,
.toybox-ui .button:active:focus,
.toybox-ui .button--selected:hover:focus,
.toybox-ui .button--danger:hover:focus,
.toybox-ui .button--flat:hover:focus {
    border-color: var(--toy-focus);
}

.toybox-ui .toy-icon {
    width: var(--toy-icon-size);
    min-width: var(--toy-icon-size);
    height: var(--toy-icon-size);
    margin-right: var(--toy-icon-gap);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--toy-text);
}

.toybox-ui .button:disabled .toy-icon {
    -unity-background-image-tint-color: var(--toy-text-muted);
}

.toybox-ui .button:disabled .toy-button__label {
    color: var(--toy-text-muted);
}

.toybox-ui .toy-icon--play {
    background-image: url("project://database/Assets/UI/Shared/Icons/play.svg");
}

.toybox-ui .toy-icon--controls {
    background-image: url("project://database/Assets/UI/Shared/Icons/controls.svg");
}

.toybox-ui .toy-icon--settings {
    background-image: url("project://database/Assets/UI/Shared/Icons/settings.svg");
}

.toybox-ui .toy-icon--credits {
    background-image: url("project://database/Assets/UI/Shared/Icons/credits.svg");
}

.toybox-ui .toy-icon--back {
    background-image: url("project://database/Assets/UI/Shared/Icons/back.svg");
}

.toybox-ui .toy-icon--create {
    background-image: url("project://database/Assets/UI/Shared/Icons/create.svg");
}

.toybox-ui .toy-icon--join {
    background-image: url("project://database/Assets/UI/Shared/Icons/join.svg");
}

.toybox-ui .toy-icon--elimination {
    background-image: url("project://database/Assets/UI/Shared/Icons/elimination.svg");
}

.toybox-ui .toy-icon--hill {
    background-image: url("project://database/Assets/UI/Shared/Icons/hill.svg");
}

.toybox-ui .toy-icon--flag {
    background-image: url("project://database/Assets/UI/Shared/Icons/flag.svg");
}

.toybox-ui .toy-icon--player {
    background-image: url("project://database/Assets/UI/Shared/Icons/player.svg");
}

.toybox-ui .toy-icon--bot {
    background-image: url("project://database/Assets/UI/Shared/Icons/bot.svg");
}

.toybox-ui .toy-icon--fog {
    background-image: url("project://database/Assets/UI/Shared/Icons/fog.svg");
}

.toybox-ui .toy-icon--check {
    background-image: url("project://database/Assets/UI/Shared/Icons/check.svg");
}

.toybox-ui .toy-icon--chevron-left {
    background-image: url("project://database/Assets/UI/Shared/Icons/chevron-left.svg");
}

.toybox-ui .toy-icon--chevron-right {
    background-image: url("project://database/Assets/UI/Shared/Icons/chevron-right.svg");
}

.toybox-ui .title-xl {
    font-size: var(--toy-type-display);
    -unity-font-style: bold;
    color: var(--toy-text);
    letter-spacing: -0.5px;
}

.toybox-ui .title-lg {
    font-size: var(--toy-type-title-lg);
    -unity-font-style: bold;
    color: var(--toy-text);
    letter-spacing: -0.25px;
}

.toybox-ui .title-md {
    font-size: var(--toy-type-title);
    -unity-font-style: bold;
    color: var(--toy-text);
}

.toybox-ui .label {
    font-size: var(--toy-type-body);
    color: var(--toy-text-copy);
}

.toybox-ui .label--muted {
    color: var(--toy-text-muted);
}

.toybox-ui .label--danger {
    color: var(--toy-danger-copy);
}

.toybox-ui .label--amber {
    color: var(--toy-primary-copy);
}

.toybox-ui .label--blue {
    color: var(--toy-team-friendly-copy);
}

.toybox-ui .section-label {
    margin-bottom: var(--toy-space-sm);
    font-size: var(--toy-type-label);
    -unity-font-style: bold;
    color: var(--toy-text);
    letter-spacing: 0;
}

.toybox-ui .divider {
    height: var(--toy-stroke-thin);
    margin-top: var(--toy-space-control-x);
    margin-bottom: var(--toy-space-panel-compact);
    background-color: var(--toy-divider);
}

.toybox-ui .toy-readout {
    padding: var(--toy-space-md) var(--toy-space-control-x);
    background-color: var(--toy-panel);
    border-width: var(--toy-stroke-thin);
    border-bottom-width: var(--toy-depth-panel);
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-md);
}

.toybox-ui .toy-readout__label {
    font-size: var(--toy-type-caption);
    -unity-font-style: bold;
    color: var(--toy-text-muted);
}

.toybox-ui .toy-readout__value {
    font-size: var(--toy-type-title);
    -unity-font-style: bold;
    color: var(--toy-text);
}

.toybox-ui .toy-chip {
    min-height: var(--toy-target-status);
    padding: var(--toy-space-xs) 9px;
    align-items: center;
    justify-content: center;
    background-color: var(--toy-surface-quiet);
    color: var(--toy-text);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-sm);
    font-size: var(--toy-type-caption);
    -unity-font-style: bold;
}

.toybox-ui .toy-chip--selected {
    background-color: var(--toy-select);
    color: var(--toy-text-on-deep);
}

.toybox-ui .toy-chip--info {
    border-color: var(--toy-primary);
}

.toybox-ui .toy-chip--danger {
    background-color: var(--toy-danger);
    color: var(--toy-text-on-deep);
}

.toybox-ui .text-field {
    margin-top: 7px;
    margin-bottom: var(--toy-space-md);
    color: var(--toy-text);
}

.toybox-ui .text-field > .unity-base-text-field__input {
    min-height: var(--toy-target);
    padding: var(--toy-space-control-top) 14px;
    background-color: var(--toy-inset);
    color: var(--toy-text);
    --unity-cursor-color: var(--toy-text);
    border-width: var(--toy-focus-width);
    border-color: var(--toy-edge);
    border-radius: 9px;
    font-size: var(--toy-type-mono);
}

.toybox-ui .text-field > .unity-base-text-field__input:hover {
    border-color: var(--toy-text-muted);
}

.toybox-ui .text-field > .unity-base-text-field__input:focus {
    border-width: var(--toy-focus-emphasis);
    border-color: var(--toy-focus);
}

.toybox-ui .text-field.text-field--caret-hidden > .unity-base-text-field__input {
    --unity-cursor-color: var(--toy-transparent);
}

.toybox-ui .toggle {
    min-height: var(--toy-target-compact);
    color: var(--toy-text);
    font-size: var(--toy-type-body);
    -unity-font-style: bold;
}

.toybox-ui .toggle > .unity-toggle__input > .unity-toggle__checkmark {
    width: var(--toy-icon-size);
    min-width: var(--toy-icon-size);
    height: var(--toy-icon-size);
    margin-right: var(--toy-icon-gap);
    background-image: none;
    background-color: var(--toy-inset);
    border-width: var(--toy-focus-width);
    border-color: var(--toy-edge);
    border-radius: 7px;
}

.toybox-ui .toggle:hover > .unity-toggle__input > .unity-toggle__checkmark {
    border-color: var(--toy-edge-strong);
}

.toybox-ui .toggle:focus > .unity-toggle__input > .unity-toggle__checkmark {
    border-width: var(--toy-focus-emphasis);
    border-color: var(--toy-focus);
}

.toybox-ui .toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: var(--toy-select);
    border-color: var(--toy-edge-strong);
}

.toybox-ui .toggle:checked:focus > .unity-toggle__input > .unity-toggle__checkmark {
    border-width: var(--toy-focus-emphasis);
    border-color: var(--toy-focus);
}

/* Volume-style slider. The built-in template is a hairline track with a small round pill, and it
   positions both of those absolutely, so each one is given its own geometry here rather than
   nudged: an inset channel and a handle wide enough to grab or to see from across a room. */
.toybox-ui .toy-slider {
    min-height: var(--toy-target-compact);
    margin: 0;
}

.toybox-ui .toy-slider .unity-base-slider__input {
    min-height: var(--toy-target-compact);
    flex-grow: 1;
    align-items: center;
}

/* The channel and the handle hang off this box, so it carries the height they centre on and the
   full width they travel across. */
.toybox-ui .toy-slider .unity-base-slider__drag-container {
    width: 100%;
    height: 28px;
    min-height: 28px;
    flex-grow: 1;
}

.toybox-ui .toy-slider .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 8px;
    margin-top: -4px;
    background-color: var(--toy-inset);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-sm);
}

/* The handle draws its own outline, so the template's separate border box is redundant. */
.toybox-ui .toy-slider .unity-base-slider__dragger-border {
    display: none;
}

.toybox-ui .toy-slider .unity-base-slider__dragger {
    position: absolute;
    top: 50%;
    width: 18px;
    height: 28px;
    margin-top: -14px;
    background-color: var(--toy-text-muted);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-sm);
    transition-duration: var(--toy-motion-fast);
    transition-property: background-color, border-color;
}

.toybox-ui .toy-slider:hover .unity-base-slider__tracker {
    border-color: var(--toy-edge-strong);
}

.toybox-ui .toy-slider:hover .unity-base-slider__dragger {
    background-color: var(--toy-text);
}

/* Focus brightens the handle and the channel edge together: a ring alone on an 18px box is not a
   cue you can find, and a light ring on a light handle would not be one at all. */
.toybox-ui .toy-slider:focus .unity-base-slider__tracker,
.toybox-ui .toy-slider .unity-base-slider__input:focus .unity-base-slider__tracker {
    border-color: var(--toy-focus);
}

.toybox-ui .toy-slider:focus .unity-base-slider__dragger,
.toybox-ui .toy-slider .unity-base-slider__input:focus .unity-base-slider__dragger {
    background-color: var(--toy-focus);
}

.toybox-ui .toy-slider:disabled {
    opacity: 1;
}

.toybox-ui .toy-slider:disabled .unity-base-slider__tracker {
    background-color: var(--toy-disabled-surface);
    border-color: var(--toy-disabled-border);
}

.toybox-ui .toy-slider:disabled .unity-base-slider__dragger {
    background-color: var(--toy-disabled-border);
    border-color: var(--toy-disabled-border);
}

.toybox-ui.modal-shade,
.toybox-ui .modal-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--toy-space-xl);
    background-color: var(--toy-scrim);
}

.toybox-ui .modal {
    width: 680px;
    max-width: 92%;
    max-height: 90%;
    padding: var(--toy-space-modal);
    background-color: var(--toy-surface);
    border-width: var(--toy-focus-width);
    border-bottom-width: var(--toy-depth-modal);
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-lg);
}

.toybox-ui .modal:focus {
    border-width: var(--toy-focus-emphasis);
    border-color: var(--toy-focus);
}

.toybox-ui .modal__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.toybox-ui .modal-close {
    align-self: flex-end;
    min-width: 140px;
    margin-top: var(--toy-space-panel);
}

.toybox-ui .controls-panel {
    width: 760px;
    height: 680px;
    max-width: 92%;
    max-height: 90%;
}

.toybox-ui .controls-scroll {
    flex-grow: 1;
    min-height: 0;
}

.toybox-ui .controls-scroll .unity-scroll-view__content-container {
    padding-right: var(--toy-space-md);
}

.toybox-ui .control-section {
    margin-bottom: 10px;
}

.toybox-ui .control-section__label {
    margin-top: var(--toy-space-xs);
    margin-bottom: var(--toy-space-xs);
    font-size: var(--toy-type-caption);
    -unity-font-style: bold;
    color: var(--toy-primary-copy);
    letter-spacing: 0;
}

.toybox-ui .control-row {
    min-height: 46px;
    flex-direction: row;
    align-items: flex-start;
    padding-top: var(--toy-space-control-top);
    padding-bottom: var(--toy-space-control-top);
    border-bottom-width: var(--toy-stroke-thin);
    border-bottom-color: var(--toy-divider);
}

.toybox-ui .control-key {
    width: 176px;
    min-width: 176px;
    padding-right: var(--toy-space-panel-compact);
    color: var(--toy-text);
    -unity-font-style: bold;
}

.toybox-ui .control-copy {
    flex-grow: 1;
    min-width: 0;
    color: var(--toy-text-copy);
    white-space: normal;
}

.toybox-ui .control-row--last {
    border-bottom-width: 0;
}

.toybox-ui .controls-panel .modal-close {
    margin-top: var(--toy-space-control-x);
}

.toybox-ui .status-line {
    min-height: var(--toy-icon-size);
    margin-top: 6px;
    margin-bottom: 8px;
    color: var(--toy-text-muted);
    white-space: normal;
}

.toybox-ui .status-line--busy {
    color: var(--toy-primary-copy);
}

.toybox-ui .status-line--success {
    color: var(--toy-select-copy);
}

.toybox-ui .status-line.label--danger,
.toybox-ui .status-line--danger {
    color: var(--toy-danger-copy);
}

.toybox-ui .unity-scroller--vertical,
.toybox-ui .unity-scroller--horizontal {
    background-color: var(--toy-inset);
}

.toybox-ui .unity-scroller__low-button,
.toybox-ui .unity-scroller__high-button {
    background-color: var(--toy-surface-raised);
    border-color: var(--toy-divider);
}

.toybox-ui .unity-base-slider__tracker {
    background-color: var(--toy-surface-quiet);
    border-color: var(--toy-divider);
}

.toybox-ui .unity-base-slider__dragger {
    background-color: var(--toy-text-muted);
    border-color: var(--toy-text-border);
}

.toybox-ui .plan-path {
    height: 22px;
    flex-direction: row;
    align-items: center;
}

.toybox-ui .plan-path__start,
.toybox-ui .plan-path__stop {
    width: 12px;
    height: 12px;
    background-color: var(--toy-primary);
    border-width: 2px;
    border-color: var(--toy-edge);
}

.toybox-ui .plan-path__start {
    border-radius: var(--toy-radius-sm);
}

.toybox-ui .plan-path__line {
    width: 74px;
    height: 4px;
    background-color: var(--toy-primary);
}

.phone .toybox-ui .toy-panel {
    padding: var(--toy-space-panel-compact);
}

.phone .toybox-ui.modal-shade,
.phone .toybox-ui .modal-shade {
    padding: var(--toy-space-md);
}

.phone .toybox-ui .modal {
    max-width: 100%;
    padding: var(--toy-space-modal-phone);
}

.phone .toybox-ui .controls-panel {
    padding: var(--toy-space-panel-compact);
}

.phone .toybox-ui .control-row {
    min-height: 0;
    flex-direction: column;
    padding-top: var(--toy-space-sm);
    padding-bottom: var(--toy-space-sm);
}

.phone .toybox-ui .control-key {
    width: auto;
    min-width: 0;
    margin-bottom: var(--toy-space-xs);
    padding-right: 0;
}

.phone .toybox-ui .controls-panel .modal-close {
    width: 100%;
}

.phone .toybox-ui .button {
    min-height: var(--toy-target-phone);
    font-size: var(--toy-type-body-lg);
}

.short .toybox-ui .controls-panel {
    height: 92%;
    max-height: 92%;
}
