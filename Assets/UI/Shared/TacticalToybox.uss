/* Battle Plan — FIELD DAY component library.
   Everything here is scoped to .toybox-ui so the match HUD's card subtree can opt
   out. Colour comes from tokens only; see BattlePlan.uss for the base atoms and
   for the easing-keyword mapping. */

@import url("TacticalToyboxTokens.uss");

.toybox-ui {
    -unity-font-definition: url("project://database/Assets/Fonts/Rubik/Rubik-VariableFont_wght UI SDF.asset");
    color: var(--bp-text);
    font-size: var(--bp-type-body);
    background-color: var(--bp-transparent);
}

/* --- Surfaces -------------------------------------------------------------- */

.toybox-ui .toy-panel,
.toybox-ui .panel {
    padding: var(--bp-s5);
    background-color: var(--bp-deck-1);
    border-width: var(--bp-bw-hair);
    border-top-color: var(--bp-line-1);
    border-right-color: var(--bp-line-2);
    border-left-color: var(--bp-line-2);
    border-bottom-width: var(--bp-edge);
    border-bottom-color: var(--bp-edge-dark);
    border-radius: var(--bp-r-lg);
}

/* A raised region inside a panel is a card: one rung up, no bottom edge. */
.toybox-ui .toy-card,
.toybox-ui .toy-panel--compact {
    padding: var(--bp-s4);
    background-color: var(--bp-deck-2);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-bottom-width: var(--bp-bw-hair);
    border-radius: var(--bp-r-md);
}

.toybox-ui .toy-plate {
    background-color: var(--bp-deck-0);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
}

/* --- Selected control ------------------------------------------------------- */

.toybox-ui .button--selected,
.toybox-ui .button--selected:hover {
    background-color: var(--bp-deck-3);
    color: var(--bp-text);
    border-top-color: var(--bp-blue-line);
    border-right-color: var(--bp-blue-line);
    border-bottom-color: var(--bp-edge-dark);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-blue);
    transition-duration: var(--bp-t-base);
}

.toybox-ui .button--selected:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.toybox-ui .button--selected:active {
    background-color: var(--bp-deck-4);
}

.toybox-ui .button--selected:disabled,
.toybox-ui .button--selected:disabled:hover {
    opacity: 1;
    background-color: var(--bp-deck-1);
    color: var(--bp-text-3);
    border-color: var(--bp-line-1);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-blue-dim);
}

/* --- Icons ------------------------------------------------------------------ */

.toybox-ui .toy-icon {
    width: var(--bp-icon);
    min-width: var(--bp-icon);
    height: var(--bp-icon);
    margin-right: var(--bp-icon-gap);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--bp-text);
    transition-property: -unity-background-image-tint-color;
    transition-duration: var(--bp-t-fast);
    transition-timing-function: var(--bp-ease-out);
}

.toybox-ui .toy-icon--sm {
    width: var(--bp-icon-sm);
    min-width: var(--bp-icon-sm);
    height: var(--bp-icon-sm);
}

.toybox-ui .button--primary .toy-icon {
    -unity-background-image-tint-color: var(--bp-text-on-accent);
}

.toybox-ui .button--ghost .toy-icon,
.toybox-ui .button--text .toy-icon {
    -unity-background-image-tint-color: var(--bp-text-2);
}

.toybox-ui .button:disabled .toy-icon {
    -unity-background-image-tint-color: var(--bp-text-3);
}

.toybox-ui .button:disabled .toy-button__label {
    color: var(--bp-text-3);
}

.toybox-ui .toy-button__label {
    -unity-font-style: bold;
    color: var(--bp-text);
}

.toybox-ui .button--primary .toy-button__label {
    color: var(--bp-text-on-accent);
}

.toybox-ui .button--ghost .toy-button__label,
.toybox-ui .button--text .toy-button__label {
    color: var(--bp-text-2);
}

.toybox-ui .button--ghost:hover .toy-button__label {
    color: var(--bp-text);
}

.toybox-ui .toy-icon--play {
    background-image: url("project://database/Assets/UI/Shared/Icons/play.svg");
}

.toybox-ui .toy-icon--controls {
    background-image: url("project://database/Assets/UI/Shared/Icons/controls.svg");
}

.toybox-ui .toy-icon--settings {
    background-image: url("project://database/Assets/UI/Shared/Icons/settings.svg");
}

.toybox-ui .toy-icon--credits {
    background-image: url("project://database/Assets/UI/Shared/Icons/credits.svg");
}

.toybox-ui .toy-icon--back {
    background-image: url("project://database/Assets/UI/Shared/Icons/back.svg");
}

.toybox-ui .toy-icon--create {
    background-image: url("project://database/Assets/UI/Shared/Icons/create.svg");
}

.toybox-ui .toy-icon--join {
    background-image: url("project://database/Assets/UI/Shared/Icons/join.svg");
}

.toybox-ui .toy-icon--elimination {
    background-image: url("project://database/Assets/UI/Shared/Icons/elimination.svg");
}

.toybox-ui .toy-icon--hill {
    background-image: url("project://database/Assets/UI/Shared/Icons/hill.svg");
}

.toybox-ui .toy-icon--flag {
    background-image: url("project://database/Assets/UI/Shared/Icons/flag.svg");
}

.toybox-ui .toy-icon--player {
    background-image: url("project://database/Assets/UI/Shared/Icons/player.svg");
}

.toybox-ui .toy-icon--bot {
    background-image: url("project://database/Assets/UI/Shared/Icons/bot.svg");
}

.toybox-ui .toy-icon--fog {
    background-image: url("project://database/Assets/UI/Shared/Icons/fog.svg");
}

.toybox-ui .toy-icon--check {
    background-image: url("project://database/Assets/UI/Shared/Icons/check.svg");
}

.toybox-ui .toy-icon--chevron-down {
    background-image: url("project://database/Assets/UI/Shared/Icons/chevron-down.svg");
}

/* --- Readouts ---------------------------------------------------------------- */

.toybox-ui .toy-readout {
    padding: var(--bp-s3) var(--bp-s4);
    background-color: var(--bp-panel);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
}

.toybox-ui .toy-readout__label {
    font-size: var(--bp-type-label);
    -unity-font-style: bold;
    color: var(--bp-text-3);
    letter-spacing: 0.6px;
}

.toybox-ui .toy-readout__value {
    font-size: var(--bp-type-body);
    -unity-font-style: bold;
    color: var(--bp-text);
}

.toybox-ui .toy-chip {
    min-height: 22px;
    padding: 0 var(--bp-s2);
    align-items: center;
    justify-content: center;
    background-color: var(--bp-deck-0);
    color: var(--bp-text);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-3);
    border-radius: var(--bp-r-sm);
    font-size: var(--bp-type-micro);
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

/* --- Section rules -------------------------------------------------------------- */

.toybox-ui .divider {
    height: var(--bp-bw-hair);
    margin-top: var(--bp-s4);
    margin-bottom: var(--bp-s5);
    background-color: var(--bp-line-2);
}

/* --- Checkbox ------------------------------------------------------------------- */

.toybox-ui .toggle {
    min-height: var(--bp-target);
}

.toybox-ui .toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: var(--bp-blue);
    border-color: var(--bp-blue);
}

.toybox-ui .toggle:checked:focus > .unity-toggle__input > .unity-toggle__checkmark {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

/* --- Status line ------------------------------------------------------------------ */

.toybox-ui .status-line {
    min-height: 20px;
    margin-top: var(--bp-s2);
    font-size: var(--bp-type-body-sm);
    color: var(--bp-text-2);
    white-space: normal;
}

.toybox-ui .status-line--busy {
    color: var(--bp-blue);
}

.toybox-ui .status-line--success {
    color: var(--bp-green-hi);
}

.toybox-ui .status-line.label--danger,
.toybox-ui .status-line--danger {
    color: var(--bp-red-hi);
}

/* --- Dialog -------------------------------------------------------------------------- */

.toybox-ui.modal-shade,
.toybox-ui .modal-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--bp-s6);
    background-color: var(--bp-scrim);
    transition-property: opacity;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.toybox-ui .modal {
    width: 680px;
    max-width: 92%;
    max-height: 90%;
    padding: var(--bp-s6);
    background-color: var(--bp-deck-1);
    border-width: var(--bp-bw-hair);
    border-top-color: var(--bp-line-1);
    border-right-color: var(--bp-line-2);
    border-left-color: var(--bp-line-2);
    border-bottom-width: var(--bp-edge);
    border-bottom-color: var(--bp-edge-dark);
    border-radius: var(--bp-r-lg);
}

.toybox-ui .modal:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.toybox-ui .modal__title {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-SemiBold UI SDF.asset");
    font-size: var(--bp-type-title);
    color: var(--bp-text);
    letter-spacing: 0.5px;
}

.toybox-ui .modal__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.toybox-ui .modal-close {
    align-self: flex-end;
    min-width: 140px;
    margin-top: var(--bp-s5);
}

.toybox-ui .controls-panel {
    width: 760px;
    height: 680px;
    max-width: 92%;
    max-height: 90%;
}

.toybox-ui .controls-scroll {
    flex-grow: 1;
    min-height: 0;
}

.toybox-ui .controls-scroll .unity-scroll-view__content-container {
    padding-right: var(--bp-s3);
}

.toybox-ui .controls-panel .modal-close {
    margin-top: var(--bp-s4);
}

/* --- Responsive ------------------------------------------------------------------------ */

.phone .toybox-ui .toy-panel {
    padding: var(--bp-s4);
}

.phone .toybox-ui.modal-shade,
.phone .toybox-ui .modal-shade {
    padding: var(--bp-s4);
}

.phone .toybox-ui .modal {
    max-width: 100%;
    padding: var(--bp-s5);
}

.phone .toybox-ui .controls-panel {
    padding: var(--bp-s4);
}

.phone .toybox-ui .control-row {
    min-height: 0;
    flex-direction: column;
    padding-top: var(--bp-s2);
    padding-bottom: var(--bp-s2);
}

.phone .toybox-ui .control-key {
    width: auto;
    min-width: 0;
    margin-bottom: var(--bp-s1);
    padding-right: 0;
}

.phone .toybox-ui .controls-panel .modal-close {
    width: 100%;
}

.phone .toybox-ui .button {
    min-height: var(--bp-target-phone);
}

.phone .toybox-ui .button--ghost,
.phone .toybox-ui .button--text {
    min-height: var(--bp-target);
}

.short .toybox-ui .controls-panel {
    height: 92%;
    max-height: 92%;
}
