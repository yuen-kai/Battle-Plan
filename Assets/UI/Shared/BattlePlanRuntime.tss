@import url("unity-theme://default");
@import url("TacticalToyboxTokens.uss");

VisualElement {}

.unity-base-dropdown {
    -unity-font-definition: url("project://database/Assets/Fonts/Rubik/Rubik-VariableFont_wght UI SDF.asset");
    background-color: var(--bp-deck-2);
    color: var(--bp-text);
    font-size: var(--bp-type-body);
}

.unity-base-dropdown__container-outer {
    background-color: var(--bp-deck-2);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
}

.unity-base-dropdown__container-inner {
    background-color: var(--bp-deck-2);
}

.unity-base-dropdown__item {
    min-height: 40px;
    padding: 0 var(--bp-s3);
    align-items: center;
    background-color: var(--bp-transparent);
    color: var(--bp-text-2);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-transparent);
    font-size: var(--bp-type-body);
    transition-property: background-color, border-color, color;
    transition-duration: var(--bp-t-fast);
    transition-timing-function: var(--bp-ease-out);
}

.unity-base-dropdown__item:hover {
    background-color: var(--bp-deck-3);
    color: var(--bp-text);
}

.unity-base-dropdown__item:active {
    background-color: var(--bp-deck-4);
    color: var(--bp-text);
}

.unity-base-dropdown__item:checked {
    background-color: var(--bp-deck-3);
    color: var(--bp-text);
    border-left-color: var(--bp-blue);
}

.unity-base-dropdown__item:checked:hover {
    background-color: var(--bp-deck-4);
    color: var(--bp-text);
}

.unity-base-dropdown__item:focus,
.unity-base-dropdown__item:hover:focus,
.unity-base-dropdown__item:active:focus,
.unity-base-dropdown__item:checked:focus {
    background-color: var(--bp-deck-3);
    border-left-color: var(--bp-focus-light);
}

.unity-base-dropdown__item:disabled,
.unity-base-dropdown__item:disabled:hover,
.unity-base-dropdown__item:disabled:focus,
.unity-base-dropdown__item:disabled:active {
    opacity: 1;
    background-color: var(--bp-deck-1);
    color: var(--bp-text-3);
    border-left-color: var(--bp-transparent);
}

.unity-base-dropdown__item:checked:disabled,
.unity-base-dropdown__item:checked:disabled:hover,
.unity-base-dropdown__item:checked:disabled:focus,
.unity-base-dropdown__item:checked:disabled:active {
    background-color: var(--bp-deck-1);
    color: var(--bp-text-3);
    border-left-color: var(--bp-blue-dim);
}

.unity-base-dropdown__label {
    color: var(--bp-text-2);
    font-size: var(--bp-type-body);
}

.unity-base-dropdown__item:hover .unity-base-dropdown__label,
.unity-base-dropdown__item:checked .unity-base-dropdown__label {
    color: var(--bp-text);
}

.unity-base-dropdown__item:disabled .unity-base-dropdown__label {
    color: var(--bp-text-3);
}

/* The 3px left rule already carries the checked state; the tick would repeat it. */
.unity-base-dropdown__checkmark {
    display: none;
}

.unity-base-dropdown__separator {
    height: var(--bp-bw-hair);
    background-color: var(--bp-line-2);
}
