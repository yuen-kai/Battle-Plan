@import url("unity-theme://default");
VisualElement {}

.unity-base-dropdown {
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    background-color: rgb(5, 9, 15);
    color: rgb(231, 236, 240);
}

.unity-base-dropdown__container-outer {
    background-color: rgb(5, 9, 15);
    border-width: 1px;
    border-color: rgb(76, 99, 119);
    border-radius: 2px;
}

.unity-base-dropdown__container-inner {
    background-color: rgb(12, 20, 30);
}

.unity-base-dropdown__item {
    min-height: 36px;
    padding: 8px 12px;
    background-color: rgb(12, 20, 30);
    color: rgb(231, 236, 240);
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    font-size: 14px;
}

.unity-base-dropdown__item:hover {
    background-color: rgb(25, 39, 52);
    color: rgb(245, 247, 249);
    border-left-color: rgb(229, 160, 55);
}

.unity-base-dropdown__item:focus {
    background-color: rgb(25, 39, 52);
    color: rgb(245, 247, 249);
    border-left-color: rgb(237, 174, 65);
}

.unity-base-dropdown__item:checked {
    background-color: rgb(24, 34, 44);
    color: rgb(245, 247, 249);
    border-left-color: rgb(229, 160, 55);
}

.unity-base-dropdown__label {
    color: rgb(231, 236, 240);
    font-size: 14px;
}

.unity-base-dropdown__checkmark {
    color: rgb(237, 174, 65);
}

.unity-base-dropdown__separator {
    background-color: rgb(45, 62, 78);
}
