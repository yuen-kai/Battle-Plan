<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../Shared/BattlePlan.uss" />
    <ui:Style src="../Shared/TacticalToybox.uss" />
    <ui:Style src="../Shared/Settings.uss" />
    <ui:Style src="TitleScreen.uss" />
    <ui:VisualElement name="screen" class="screen toybox-screen toybox-ui title-screen">
        <ui:VisualElement class="toy-vignette" picking-mode="Ignore" />
        <ui:VisualElement class="toy-scrim-left title-scrim" picking-mode="Ignore" />
        <ui:VisualElement class="title-layout">
            <ui:VisualElement class="title-rail">
                <ui:VisualElement class="toy-hatch" picking-mode="Ignore" />
                <ui:VisualElement class="title-masthead" picking-mode="Ignore">
                    <ui:Label text="Simultaneous-turn tactics" class="section-label title-eyebrow" picking-mode="Ignore" />
                    <ui:Label name="game-logo" text="Battle Plan" class="title-wordmark" picking-mode="Ignore" />
                    <ui:VisualElement class="plan-path title-plan-path" picking-mode="Ignore">
                        <ui:VisualElement class="plan-path__start" />
                        <ui:VisualElement class="plan-path__line" />
                        <ui:VisualElement class="plan-path__stop" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="title-actions">
                    <ui:Button name="play-button" class="button button--primary title-action title-play">
                        <ui:VisualElement class="toy-icon toy-icon--play" picking-mode="Ignore" />
                        <ui:Label text="Play" class="toy-button__label title-action__label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="tutorial-button" class="button title-action title-action--ghost">
                        <ui:VisualElement class="toy-icon toy-icon--flag" picking-mode="Ignore" />
                        <ui:Label text="Tutorial" class="toy-button__label title-action__label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="characters-button" class="button title-action title-action--ghost">
                        <ui:VisualElement class="toy-icon toy-icon--player" picking-mode="Ignore" />
                        <ui:Label text="Characters" class="toy-button__label title-action__label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="settings-button" class="button title-action title-action--ghost">
                        <ui:VisualElement class="toy-icon toy-icon--settings" picking-mode="Ignore" />
                        <ui:Label text="Settings" class="toy-button__label title-action__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="title-footer">
                    <ui:Button name="credits-button" text="Credits" class="title-quiet-action" />
                    <ui:Button name="quit-button" text="Quit" class="title-quiet-action" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="title-model-stage" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="settings-modal" class="modal-shade hidden">
            <ui:VisualElement name="settings-modal-panel" class="modal settings-panel" focusable="true" tabindex="-1">
                <ui:Label text="Settings" class="title-lg" picking-mode="Ignore" />
                <ui:VisualElement class="divider" picking-mode="Ignore" />
                <ui:ScrollView name="settings-scroll" mode="Vertical" class="settings-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                    <ui:Label text="Volume" class="section-label settings-section-label settings-section-label--first" picking-mode="Ignore" />
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="Master" class="setting-row__label" picking-mode="Ignore" />
                        <ui:Slider name="master-volume-slider" low-value="0" high-value="1" value="1" class="toy-slider setting-row__control" />
                        <ui:Label name="master-volume-value" text="100%" class="setting-row__value mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="Music" class="setting-row__label" picking-mode="Ignore" />
                        <ui:Slider name="music-volume-slider" low-value="0" high-value="1" value="1" class="toy-slider setting-row__control" />
                        <ui:Label name="music-volume-value" text="100%" class="setting-row__value mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="Effects" class="setting-row__label" picking-mode="Ignore" />
                        <ui:Slider name="sfx-volume-slider" low-value="0" high-value="1" value="1" class="toy-slider setting-row__control" />
                        <ui:Label name="sfx-volume-value" text="100%" class="setting-row__value mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label text="Display" class="section-label settings-section-label" picking-mode="Ignore" />
                    <ui:VisualElement class="setting-row setting-row--single">
                        <ui:Label text="Quality" class="setting-row__label" picking-mode="Ignore" />
                        <ui:DropdownField name="quality-dropdown" class="quality-dropdown setting-row__control" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Button name="settings-close-button" text="Close" class="button button--primary modal-close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="credits-modal" class="modal-shade hidden">
            <ui:VisualElement name="credits-modal-panel" class="modal" focusable="true" tabindex="-1">
                <ui:Label text="Credits" class="title-lg" picking-mode="Ignore" />
                <ui:VisualElement class="divider" picking-mode="Ignore" />
                <ui:VisualElement class="credit-row" picking-mode="Ignore">
                    <ui:Label text="Yuen Kai" class="title-md credit-name" picking-mode="Ignore" />
                    <ui:Label text="Programming and game design" class="label label--muted credit-role" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="credit-row credit-row--last" picking-mode="Ignore">
                    <ui:Label text="Logan Suite" class="title-md credit-name" picking-mode="Ignore" />
                    <ui:Label text="3D art, animation, music, and code" class="label label--muted credit-role" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="credits-close-button" text="Close" class="button button--primary modal-close" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
