.title-screen {
    background-color: var(--toy-transparent);
}

.title-layout {
    flex-direction: row;
    align-items: center;
    padding: 48px 56px;
}

.toybox-ui.title-screen .title-board {
    width: 430px;
    min-width: 430px;
    padding: var(--toy-space-xl);
    background-color: var(--toy-panel);
}

.title-wordmark {
    font-size: 66px;
    -unity-font-style: bold;
    color: var(--toy-text);
    letter-spacing: -1.5px;
    white-space: normal;
}

.title-plan-path {
    margin-top: var(--toy-space-sm);
    margin-bottom: var(--toy-space-panel);
}

.title-actions {
    width: 100%;
}

/* Unity's built-in Button style carries a 3px side margin. Left unzeroed it
   insets every action from the divider and the credits row below, and it is
   what pushed the half-width row past the panel edge. */
.title-action {
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 0;
    margin-right: 0;
}

.toybox-ui.title-screen .title-play {
    min-height: 70px;
    font-size: 22px;
}

.toybox-ui.title-screen .title-play .toy-icon {
    width: 30px;
    min-width: 30px;
    height: 30px;
    margin-right: 14px;
}

.title-action__label {
    -unity-font-style: bold;
    color: var(--toy-text);
}

.button--primary .title-action__label {
    color: var(--toy-text-on-accent);
}

.title-action-row {
    width: 100%;
    flex-direction: row;
}

/* Split the row by growth rather than by a 50% width: two halves plus the
   10px between them add up to more than the row, and the excess spilled to
   the right of Play instead of shrinking. */
.title-action--half {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 5px;
}

.title-action--row-last {
    margin-right: 0;
    margin-left: 5px;
}

/* Credits and Quit are not choices the player came here to make, so they are text under a
   rule rather than a third pair of buttons competing with Play. */
.title-rule {
    height: 1px;
    width: 100%;
    margin-top: var(--toy-space-md);
    background-color: var(--toy-text-border);
}

.title-action-row--quiet {
    margin-top: var(--toy-space-sm);
    justify-content: flex-start;
}

.title-quiet-action {
    flex-direction: row;
    align-items: center;
    min-height: auto;
    min-width: auto;
    width: auto;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 0;
    padding-right: 0;
    margin: 0;
    margin-right: var(--toy-space-lg);
    background-color: var(--toy-transparent);
    border-width: 0;
    color: var(--toy-text-muted);
    font-size: var(--toy-type-label);
    -unity-font-style: normal;
}

.title-quiet-action--last {
    margin-right: 0;
}

.title-quiet-action:hover {
    background-color: var(--toy-transparent);
    color: var(--toy-text);
}

.title-quiet-action:active {
    background-color: var(--toy-transparent);
    color: var(--toy-text);
}

.title-quiet-action__label {
    color: var(--toy-text-muted);
    font-size: var(--toy-type-label);
}

.title-quiet-action:hover .title-quiet-action__label {
    color: var(--toy-text);
}

.toybox-ui.title-screen .toy-icon--sm {
    width: 14px;
    min-width: 14px;
    height: 14px;
    margin-right: var(--toy-space-xs);
    -unity-background-image-tint-color: var(--toy-text-muted);
}

.toybox-ui.title-screen .title-quiet-action:hover .toy-icon--sm {
    -unity-background-image-tint-color: var(--toy-text);
}

.title-model-stage {
    flex-grow: 1;
    min-width: 320px;
    height: 100%;
}

/* The settings panel's rows, columns, and quality field live in Assets/UI/Shared/Settings.uss so
   the in-match overlay draws the same panel. */

.credit-row {
    margin-top: var(--toy-space-sm);
    margin-bottom: 14px;
}

.credit-name {
    margin-bottom: 3px;
}

.credit-role {
    white-space: normal;
}

.compact .title-layout {
    padding: 36px;
}

.compact .title-screen .title-board {
    width: 390px;
    min-width: 390px;
    padding: 26px;
}

.compact .title-wordmark {
    font-size: 56px;
}

.narrow .title-layout {
    align-items: flex-end;
    justify-content: flex-end;
    padding: 28px;
}

.narrow .title-screen .title-board {
    width: 410px;
    min-width: 0;
}

.narrow .title-model-stage {
    display: none;
}

.phone .title-layout {
    align-items: stretch;
    justify-content: flex-end;
    padding: var(--toy-space-control-x);
}

.phone .title-screen .title-board {
    width: 100%;
    min-width: 0;
    padding: var(--toy-space-lg);
    background-color: var(--toy-panel);
}

.phone .title-wordmark {
    font-size: 48px;
}

.phone .title-action-row {
    flex-direction: column;
}

/* The row stacks on phone, so growth would apply to height and collapse both
   buttons against an auto-height row. */
.phone .title-action--half {
    width: 100%;
    flex-grow: 0;
    flex-basis: auto;
    margin-left: 0;
    margin-right: 0;
}

.short .title-layout {
    padding-top: 14px;
    padding-bottom: 14px;
}

.short .title-screen .title-board {
    padding-top: var(--toy-space-panel-compact);
    padding-bottom: var(--toy-space-panel-compact);
}

.short .title-wordmark {
    font-size: 42px;
}

.short .title-plan-path {
    margin-top: 2px;
    margin-bottom: var(--toy-space-sm);
}

.short .title-screen .title-action {
    min-height: 46px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.short .title-screen .title-play {
    min-height: var(--toy-target-phone);
}

.phone.short .title-screen .title-action {
    min-height: var(--toy-target-phone);
}
