/* Title — a --bp-deck-1 card-stock column carrying the wordmark and one primary action
   (ArtDirection §5.5, "Title"). §5.5 puts that stock "over the table"; here the screen root is
   transparent and .title-model-stage reserves the right side, so the live 3D scene is the table. */

.title-screen {
    background-color: var(--bp-transparent);
}

.title-layout {
    flex-direction: row;
    align-items: stretch;
    padding: 0;
}

.toybox-ui.title-screen .title-column {
    width: 420px;
    min-width: 420px;
    padding: var(--bp-s7) var(--bp-s6);
    background-color: var(--bp-deck-1);
    border-right-width: var(--bp-bw-hair);
    border-right-color: var(--bp-line-2);
}

/* 96px from the top edge of the column: --bp-s7 of padding plus --bp-s7 again. */
.title-wordmark {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-ExtraBold UI SDF.asset");
    margin-top: var(--bp-s7);
    font-size: var(--bp-type-hero);
    color: var(--bp-text);
    letter-spacing: 2px;
    white-space: normal;
}

.title-actions {
    width: 100%;
    margin-top: var(--bp-s7);
}

.toybox-ui.title-screen .title-play {
    width: 100%;
    min-height: var(--bp-target-lg);
}

.title-action-row {
    width: 100%;
    flex-direction: row;
    margin-top: var(--bp-s3);
}

.toybox-ui.title-screen .title-action--half {
    flex-grow: 1;
    flex-basis: 0;
    width: 0;
    min-width: 0;
    min-height: var(--bp-target);
    margin-right: var(--bp-s2);
}

.toybox-ui.title-screen .title-action--row-last {
    margin-right: 0;
}

.title-rule {
    height: var(--bp-bw-hair);
    margin-top: var(--bp-s4);
    background-color: var(--bp-line-1);
}

.title-action-row--quiet {
    justify-content: flex-start;
    margin-top: var(--bp-s3);
}

.toybox-ui.title-screen .title-quiet-action {
    flex-grow: 0;
    width: auto;
    min-height: var(--bp-target-sm);
    margin-right: var(--bp-s5);
}

.toybox-ui.title-screen .title-quiet-action--last {
    margin-right: 0;
}

.title-model-stage {
    flex-grow: 1;
    min-width: 320px;
}

/* --- Quality dropdown --------------------------------------------------- */

.quality-dropdown {
    margin-bottom: var(--bp-s2);
    color: var(--bp-text);
    font-size: var(--bp-type-body);
}

.quality-dropdown > .unity-base-field__input {
    min-height: var(--bp-target-lg);
    padding: 0 var(--bp-s3);
    background-color: var(--bp-deck-0);
    color: var(--bp-text);
    border-width: var(--bp-bw);
    border-color: var(--bp-line-3);
    border-radius: var(--bp-r-md);
    transition-property: border-color, border-width;
    transition-duration: var(--bp-t-fast);
    transition-timing-function: var(--bp-ease-out);
}

.quality-dropdown > .unity-base-field__input:hover {
    border-color: var(--bp-paint);
}

.quality-dropdown:focus > .unity-base-field__input,
.quality-dropdown > .unity-base-field__input:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.quality-dropdown .unity-base-popup-field__text {
    color: var(--bp-text);
    font-size: var(--bp-type-body);
}

.quality-dropdown .unity-base-popup-field__arrow {
    width: var(--bp-icon-sm);
    min-width: var(--bp-icon-sm);
    height: var(--bp-icon-sm);
    background-image: url("project://database/Assets/UI/Shared/Icons/chevron-down.svg");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--bp-text-3);
}

.quality-dropdown:disabled {
    opacity: 1;
    color: var(--bp-text-3);
}

.quality-dropdown:disabled > .unity-base-field__input,
.quality-dropdown:disabled > .unity-base-field__input:hover {
    background-color: var(--bp-deck-1);
    color: var(--bp-text-3);
    border-color: var(--bp-line-1);
}

/* --- Credits -------------------------------------------------------------- */

.credit-row {
    padding-top: var(--bp-s3);
    padding-bottom: var(--bp-s3);
    border-bottom-width: var(--bp-bw-hair);
    border-bottom-color: var(--bp-line-1);
}

.credit-row--last {
    border-bottom-width: 0;
}

.credit-name {
    margin-bottom: var(--bp-s1);
    font-size: var(--bp-type-body);
    -unity-font-style: bold;
    color: var(--bp-text);
}

.credit-role {
    color: var(--bp-text-2);
    white-space: normal;
}

/* --- Responsive ------------------------------------------------------------- */

.compact .toybox-ui.title-screen .title-column {
    width: 380px;
    min-width: 380px;
    padding: var(--bp-s6) var(--bp-s5);
}

.compact .title-wordmark {
    margin-top: var(--bp-s6);
    font-size: 48px;
}

.compact .title-actions {
    margin-top: var(--bp-s6);
}

.narrow .toybox-ui.title-screen .title-column {
    width: 360px;
    min-width: 0;
}

.narrow .title-model-stage {
    display: none;
}

.phone .title-layout {
    flex-direction: column;
    justify-content: flex-end;
}

.phone .toybox-ui.title-screen .title-column {
    width: 100%;
    min-width: 0;
    padding: var(--bp-s5) var(--bp-s4);
    border-right-width: 0;
    border-top-width: var(--bp-bw-hair);
    border-top-color: var(--bp-line-2);
}

.phone .title-wordmark {
    margin-top: 0;
    font-size: 44px;
}

.phone .title-actions {
    margin-top: var(--bp-s5);
}

.phone .title-model-stage {
    flex-grow: 1;
    min-width: 0;
}

.phone .title-action-row {
    flex-direction: column;
}

.phone .toybox-ui.title-screen .title-action--half {
    width: 100%;
    flex-basis: auto;
    margin-right: 0;
    margin-bottom: var(--bp-s2);
}

.phone .title-action-row--quiet {
    flex-direction: row;
}

.short .toybox-ui.title-screen .title-column {
    padding-top: var(--bp-s5);
    padding-bottom: var(--bp-s5);
}

.short .title-wordmark {
    margin-top: 0;
    font-size: 40px;
}

.short .title-actions {
    margin-top: var(--bp-s5);
}

.short .title-rule {
    margin-top: var(--bp-s3);
}
