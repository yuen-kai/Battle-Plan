.title-screen {
    background-color: var(--toy-transparent);
}

.title-layout {
    flex-direction: row;
    align-items: center;
    padding: 48px 56px;
}

.toybox-ui.title-screen .title-board {
    width: 430px;
    min-width: 430px;
    padding: var(--toy-space-xl);
    background-color: var(--toy-panel);
}

.title-wordmark {
    font-size: 66px;
    -unity-font-style: bold;
    color: var(--toy-text);
    letter-spacing: -1.5px;
    white-space: normal;
}

.title-plan-path {
    margin-top: var(--toy-space-sm);
    margin-bottom: var(--toy-space-panel);
}

.title-actions {
    width: 100%;
}

.title-action {
    margin-top: 5px;
    margin-bottom: 5px;
}

.toybox-ui.title-screen .title-play {
    min-height: 70px;
    font-size: 22px;
}

.toybox-ui.title-screen .title-play .toy-icon {
    width: 30px;
    min-width: 30px;
    height: 30px;
    margin-right: 14px;
}

.title-action__label {
    -unity-font-style: bold;
    color: var(--toy-text);
}

.button--primary .title-action__label {
    color: var(--toy-text-on-accent);
}

.title-action-row {
    width: 100%;
    flex-direction: row;
}

.title-action--half {
    width: 50%;
    min-width: 0;
    margin-right: 5px;
}

.title-action--row-last {
    margin-right: 0;
    margin-left: 5px;
}

/* Credits and Quit are not choices the player came here to make, so they are text under a
   rule rather than a third pair of buttons competing with Play. */
.title-rule {
    height: 1px;
    width: 100%;
    margin-top: var(--toy-space-md);
    background-color: var(--toy-text-border);
}

.title-action-row--quiet {
    margin-top: var(--toy-space-sm);
    justify-content: flex-start;
}

.title-quiet-action {
    flex-direction: row;
    align-items: center;
    min-height: auto;
    min-width: auto;
    width: auto;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 0;
    padding-right: 0;
    margin: 0;
    margin-right: var(--toy-space-lg);
    background-color: var(--toy-transparent);
    border-width: 0;
    color: var(--toy-text-muted);
    font-size: var(--toy-type-label);
    -unity-font-style: normal;
}

.title-quiet-action--last {
    margin-right: 0;
}

.title-quiet-action:hover {
    background-color: var(--toy-transparent);
    color: var(--toy-text);
}

.title-quiet-action:active {
    background-color: var(--toy-transparent);
    color: var(--toy-text);
}

.title-quiet-action__label {
    color: var(--toy-text-muted);
    font-size: var(--toy-type-label);
}

.title-quiet-action:hover .title-quiet-action__label {
    color: var(--toy-text);
}

.toybox-ui.title-screen .toy-icon--sm {
    width: 14px;
    min-width: 14px;
    height: 14px;
    margin-right: var(--toy-space-xs);
    -unity-background-image-tint-color: var(--toy-text-muted);
}

.toybox-ui.title-screen .title-quiet-action:hover .toy-icon--sm {
    -unity-background-image-tint-color: var(--toy-text);
}

.title-model-stage {
    flex-grow: 1;
    min-width: 320px;
    height: 100%;
}

.quality-dropdown {
    min-height: var(--toy-target);
    margin-bottom: var(--toy-space-sm);
    color: var(--toy-text);
    font-size: var(--toy-type-body-lg);
}

.quality-dropdown > .unity-base-field__input {
    min-height: var(--toy-target);
    padding-left: 14px;
    background-color: var(--toy-inset);
    color: var(--toy-text);
    border-width: var(--toy-focus-width);
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-md);
}

.quality-dropdown > .unity-base-field__input:hover {
    border-color: var(--toy-edge-strong);
}

.quality-dropdown:focus > .unity-base-field__input,
.quality-dropdown > .unity-base-field__input:focus {
    border-color: var(--toy-focus);
}

.quality-dropdown:disabled {
    color: var(--toy-text-muted);
    opacity: 1;
}

.quality-dropdown:disabled > .unity-base-field__input,
.quality-dropdown:disabled > .unity-base-field__input:hover {
    background-color: var(--toy-disabled-surface);
    color: var(--toy-text-muted);
    border-color: var(--toy-disabled-border);
}

.credit-row {
    margin-top: var(--toy-space-sm);
    margin-bottom: 14px;
}

.credit-name {
    margin-bottom: 3px;
}

.credit-role {
    white-space: normal;
}

.compact .title-layout {
    padding: 36px;
}

.compact .title-screen .title-board {
    width: 390px;
    min-width: 390px;
    padding: 26px;
}

.compact .title-wordmark {
    font-size: 56px;
}

.narrow .title-layout {
    align-items: flex-end;
    justify-content: flex-end;
    padding: 28px;
}

.narrow .title-screen .title-board {
    width: 410px;
    min-width: 0;
}

.narrow .title-model-stage {
    display: none;
}

.phone .title-layout {
    align-items: stretch;
    justify-content: flex-end;
    padding: var(--toy-space-control-x);
}

.phone .title-screen .title-board {
    width: 100%;
    min-width: 0;
    padding: var(--toy-space-lg);
    background-color: var(--toy-panel);
}

.phone .title-wordmark {
    font-size: 48px;
}

.phone .title-action-row {
    flex-direction: column;
}

.phone .title-action--half {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
}

.short .title-layout {
    padding-top: 14px;
    padding-bottom: 14px;
}

.short .title-screen .title-board {
    padding-top: var(--toy-space-panel-compact);
    padding-bottom: var(--toy-space-panel-compact);
}

.short .title-wordmark {
    font-size: 42px;
}

.short .title-plan-path {
    margin-top: 2px;
    margin-bottom: var(--toy-space-sm);
}

.short .title-screen .title-action {
    min-height: 46px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.short .title-screen .title-play {
    min-height: var(--toy-target-phone);
}

.phone.short .title-screen .title-action {
    min-height: var(--toy-target-phone);
}
