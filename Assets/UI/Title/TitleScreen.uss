/* The title screen.

   One composition: a full-height rail flush to the left edge of the window, and
   the lit character stage open beside it. The rail carries no plate of its own —
   a card with a hard right edge cuts the stage in half and puts the crew behind
   a window — so the darkening is a wide scrim that is still fading at twice the
   width of the menu, and the two halves meet in the middle of a gradient
   instead of at a border.

   The menu is rows rather than buttons in boxes: a line of type and a hairline
   until you touch one, and then the row inverts to a white plate with dark ink
   and takes the orange rule on its leading edge. That single behaviour is what
   places this screen, so most of the sheet below exists to keep it exact
   through hover, focus and press, on the label and on the icon alike. */

/* --------------------------------------------------------------- the stage */

/* The ground stays transparent: the characters are lit geometry in the scene
   behind this panel, not an image in it. */
.title-screen {
    background-color: var(--toy-transparent);
}

/* Wide on purpose. A scrim that ended near the menu would draw the edge of the
   card this screen is trying not to be. */
.title-scrim {
    width: 46%;
}

/* No .screen-frame on the layout row. Its padding — and the three breakpoint
   rules that change it — would have to be zeroed four times over to keep the
   rail against the window edge. */
.title-layout {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

/* Room held for the crew. Nothing is drawn here; hiding it only gives the space
   back to the rail. */
.title-model-stage {
    flex-grow: 1;
    min-width: 320px;
}

/* ---------------------------------------------------------------- the rail */

.title-rail {
    width: 440px;
    min-width: 440px;
    padding-top: 46px;
    padding-bottom: 28px;
    justify-content: space-between;
}

/* ---------------------------------------------------------------- the mark */

/* The rail has no horizontal padding of its own, because the menu rows have to
   bleed past it to the window edge. The blocks that are not rows carry the
   inset instead, and every one of them lands on the same 56px line. */
.title-masthead {
    padding-left: 56px;
    padding-right: 44px;
}

/* The tick hangs back into the margin so the eyebrow's text and the wordmark
   share one left edge rather than stepping by the width of a rule. */
/* Full ink, not copy. The scrim is still a gradient this far up and the stage
   under it is a lit render, so the backdrop here is around 0.43 luminance
   rather than the paper the copy step is tuned against: at 12px it measured
   4.06:1. The crew screen's eyebrow already takes full ink for the same
   reason — type on the stage does not get the panel's de-emphasis. */
.toybox-ui.title-screen .title-eyebrow {
    margin-left: -12px;
    margin-bottom: var(--toy-space-md);
    color: var(--toy-text);
    white-space: normal;
}

/* White type over a lit render loses its edges wherever the two agree in value,
   and the character behind this moves. The glow is what keeps the wordmark in
   front of the stage instead of dissolving into it. */
/* The oblique cut, because a wordmark is the one thing on the screen that is
   allowed to be a logo. Upright it read as a heading. */
.title-wordmark {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCapsObl-Regular UI SDF.asset");
    font-size: 88px;
    -unity-font-style: normal;
    color: var(--toy-text);
    letter-spacing: var(--toy-track-display);
    white-space: normal;
    text-shadow: 0 0 14px var(--toy-shadow-stage);
}

/* Two waypoints and the run between them: the game in one glyph, and the only
   orange in the masthead. It is longer here than on a card because it is
   reading as a rule under a wordmark rather than as a route on a board. */
.title-plan-path {
    margin-top: var(--toy-space-lg);
}

.toybox-ui.title-screen .title-plan-path .plan-path__line {
    width: 132px;
}

/* ---------------------------------------------------------------- the menu */

/* The row runs off the left edge of the window, so the leading rule and the
   inverted plate both start at the edge itself. The 56px the labels stand on is
   the row's own padding plus that rule, which is what keeps them in line with
   the wordmark above and the links below. */
.toybox-ui.title-screen .title-action {
    min-height: 62px;
    margin: 0;
    padding-top: var(--toy-space-md);
    padding-right: 44px;
    padding-bottom: var(--toy-space-md);
    padding-left: 53px;
    justify-content: flex-start;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: var(--toy-accent-rule);
}

/* No colour on the label. It inherits the row's, which is what lets one rule
   invert the whole row instead of four, and is why the invert cannot fall out
   of step with itself. */
.title-action__label {
    font-size: 24px;
    letter-spacing: var(--toy-track-title);
    transition-duration: var(--toy-motion-fast);
    transition-property: color;
}

.toybox-ui.title-screen .title-action .toy-icon {
    width: 24px;
    min-width: 24px;
    height: 24px;
    margin-right: var(--toy-space-lg);
}

/* The one thing anybody opened the game for: the only large warm fill on the
   screen, and the only row that keeps a plate at rest.

   Its ring's width is carried at rest so that taking focus recolours a border
   that is already there. Grown on focus instead, it would resize the plate and
   nudge the label sideways on the control that holds focus from load. */
.toybox-ui.title-screen .title-play {
    min-height: 78px;
    margin-bottom: var(--toy-space-md);
    border-top-width: var(--toy-focus-emphasis);
    border-right-width: var(--toy-focus-emphasis);
    border-bottom-width: var(--toy-focus-emphasis);
}

.toybox-ui.title-screen .title-play .title-action__label {
    font-size: 28px;
}

.toybox-ui.title-screen .title-play .toy-icon {
    width: 30px;
    min-width: 30px;
    height: 30px;
}

/* At rest a row is a line of type and a hairline, and nothing else. The leading
   rule is carried transparent rather than added on hover: added, it would shove
   every label three pixels right the moment the pointer arrived. */
.toybox-ui.title-screen .title-action--ghost {
    background-color: var(--toy-transparent);
    border-bottom-width: var(--toy-stroke-thin);
    border-top-color: var(--toy-transparent);
    border-right-color: var(--toy-transparent);
    border-bottom-color: var(--toy-divider);
    border-left-color: var(--toy-transparent);
}

/* The invert. Focus takes the same treatment as hover because on a pad there is
   no pointer to say which row is live, and a row that only answered the mouse
   would leave the gamepad with nothing at all.

   The widths are restated because the shared focus ring is a uniform two-pixel
   border, which on a row that is drawn by one hairline would box it in on all
   four sides. */
.toybox-ui.title-screen .title-action--ghost:hover,
.toybox-ui.title-screen .title-action--ghost:focus,
.toybox-ui.title-screen .title-action--ghost:hover:focus {
    background-color: var(--toy-select);
    color: var(--toy-text-on-deep);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: var(--toy-stroke-thin);
    border-left-width: var(--toy-accent-rule);
    border-top-color: var(--toy-transparent);
    border-right-color: var(--toy-transparent);
    border-bottom-color: var(--toy-select);
    border-left-color: var(--toy-primary);
}

/* Pressing steps the plate down. The rule stays orange through it — the shared
   press state recolours every edge, and it would take the rule with it. */
.toybox-ui.title-screen .title-action--ghost:active,
.toybox-ui.title-screen .title-action--ghost:active:focus {
    background-color: var(--toy-select-pressed);
    color: var(--toy-text-on-deep);
    border-bottom-color: var(--toy-select-pressed);
    border-left-color: var(--toy-primary);
}

/* Tint does not inherit, so the icon is flipped by hand or the row comes up as
   a white plate with a white icon on it. The shared library covers hover; focus
   and press are ours. */
.toybox-ui.title-screen .title-action--ghost:hover .toy-icon,
.toybox-ui.title-screen .title-action--ghost:focus .toy-icon,
.toybox-ui.title-screen .title-action--ghost:active .toy-icon {
    -unity-background-image-tint-color: var(--toy-text-on-deep);
}

/* -------------------------------------------------------------- the footer */

/* Neither of these is why anyone opened the game, so they are text under a rule
   rather than two more rows competing with Play. The inset is short by the
   width of a link's own padding so the words still land on the 56px line. */
.title-footer {
    flex-direction: row;
    align-items: center;
    padding-top: var(--toy-space-md);
    padding-right: 44px;
    padding-left: 46px;
    border-top-width: var(--toy-stroke-thin);
    border-top-color: var(--toy-edge);
}

.toybox-ui.title-screen .title-quiet-action {
    width: auto;
    min-width: auto;
    min-height: auto;
    margin-top: 0;
    margin-right: var(--toy-space-xs);
    margin-bottom: 0;
    margin-left: 0;
    padding: 7px 12px;
    background-color: var(--toy-transparent);
    color: var(--toy-text-copy);
    border-width: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-body);
    -unity-font-style: normal;
    letter-spacing: var(--toy-track-label);
    transition-duration: var(--toy-motion-fast);
    transition-property: background-color, color;
}

/* Small, but it still inverts. One hover behaviour across the whole screen is
   worth more than a second, quieter one nobody has to learn — and it is the
   only focus cue these two have, since they are not shared buttons. */
.toybox-ui.title-screen .title-quiet-action:hover,
.toybox-ui.title-screen .title-quiet-action:focus {
    background-color: var(--toy-select);
    color: var(--toy-text-on-deep);
}

.toybox-ui.title-screen .title-quiet-action:active {
    background-color: var(--toy-select-pressed);
    color: var(--toy-text-on-deep);
}

/* The footer carried a "Prototype" build tag. It was development residue, it
   was the least legible thing on the screen, and a title screen has no reason
   to advertise its own unfinishedness — removed rather than restyled. */

/* ------------------------------------------------------------- the credits */

/* The settings panel's rows, columns and quality field live in
   Assets/UI/Shared/Settings.uss so the in-match overlay draws the same panel. */

.credit-row {
    padding-top: var(--toy-space-md);
    padding-bottom: var(--toy-space-md);
    border-bottom-width: var(--toy-stroke-thin);
    border-bottom-color: var(--toy-divider);
}

/* The close button follows, and a rule immediately above it reads as the top of
   a second panel. */
.credit-row--last {
    border-bottom-width: 0;
}

.credit-name {
    margin-bottom: 3px;
}

.credit-role {
    white-space: normal;
}

/* ------------------------------------------------------------- breakpoints */

.compact .title-rail {
    width: 400px;
    min-width: 400px;
    padding-top: 36px;
}

.compact .title-wordmark {
    font-size: 76px;
}

/* Under a thousand points the stage has no room left to hold a character, so it
   gives its share back and the rail becomes the window. With nothing left to
   compose against, the rail can finally afford the plate it refuses at full
   width, and the scrim has to reach the far edge or the menu ends up half over
   a gradient and half over a lit floor. */
.narrow .title-model-stage {
    display: none;
}

.narrow .title-rail {
    width: 100%;
    min-width: 0;
    background-color: var(--toy-panel);
}

.narrow .title-scrim {
    width: 100%;
}

.phone .title-rail {
    padding-top: 28px;
    padding-bottom: 20px;
}

.phone .title-masthead {
    padding-left: 20px;
    padding-right: 20px;
}

.phone .title-wordmark {
    font-size: 62px;
}

.phone .toybox-ui.title-screen .title-action {
    min-height: var(--toy-target-phone);
    padding-right: 20px;
    padding-left: 17px;
}

.phone .toybox-ui.title-screen .title-action .toy-icon {
    margin-right: var(--toy-space-md);
}

.phone .toybox-ui.title-screen .title-play {
    min-height: 66px;
}

.phone .title-action__label {
    font-size: 21px;
}

.phone .toybox-ui.title-screen .title-play .title-action__label {
    font-size: 24px;
}

.phone .title-footer {
    padding-right: 20px;
    padding-left: 10px;
}

.short .title-rail {
    padding-top: 26px;
    padding-bottom: 18px;
}

.short .toybox-ui.title-screen .title-eyebrow {
    margin-bottom: var(--toy-space-sm);
}

/* Small enough that the wordmark stops wrapping and gives the rail back a whole
   line of height, which is the only place a short window has left to find it. */
.short .title-wordmark {
    font-size: 54px;
}

.short .title-plan-path {
    margin-top: var(--toy-space-sm);
}

.short .toybox-ui.title-screen .title-action {
    min-height: 52px;
}

.short .toybox-ui.title-screen .title-play {
    min-height: 62px;
    margin-bottom: var(--toy-space-sm);
}

.short .title-action__label {
    font-size: 21px;
}

.short .toybox-ui.title-screen .title-play .title-action__label {
    font-size: 24px;
}

.short .title-footer {
    padding-top: var(--toy-space-sm);
}

/* A handset in landscape is short and narrow at once, and the row is still the
   thing a thumb has to hit. Play is left out of it: it is already taller than
   the target, and catching it here would flatten it to the height of everything
   it is supposed to outrank. */
.phone.short .toybox-ui.title-screen .title-action--ghost {
    min-height: var(--toy-target-phone);
}
