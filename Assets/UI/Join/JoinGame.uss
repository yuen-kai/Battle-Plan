.join-screen {
    background-color: var(--toy-ground);
}

.join-layout {
    flex-direction: row;
    align-items: stretch;
    padding: 34px 42px;
}

.join-workbench {
    width: 64%;
    max-width: 980px;
    min-width: 660px;
}

.join-header {
    min-height: 70px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.join-back-button {
    width: 112px;
    min-width: 112px;
    margin-right: var(--toy-space-panel-compact);
}

.join-back-label,
.join-tab__label {
    -unity-font-style: bold;
    color: var(--toy-text);
}

.button--selected .join-tab__label {
    color: var(--toy-text-on-deep);
}

.join-heading {
    flex-grow: 1;
}

.join-tabs {
    width: 100%;
    max-width: 520px;
    flex-direction: row;
    margin-bottom: 14px;
}

.join-tab {
    width: 50%;
    margin-right: 6px;
}

.join-tab--last {
    margin-right: 0;
    margin-left: 6px;
}

.join-content {
    flex-grow: 1;
    min-height: 0;
}

.join-content .unity-scroll-view__content-container {
    width: 100%;
    flex-grow: 1;
}

.join-content .unity-scroller--horizontal {
    display: none;
}

.join-content .unity-scroller--vertical {
    width: var(--toy-scroll-size);
    background-color: var(--toy-inset);
}

.join-panel {
    width: 100%;
    justify-content: flex-start;
}

.join-section-label {
    margin-top: var(--toy-space-lg);
}

.mode-row {
    flex-direction: row;
    margin-bottom: 2px;
}

.toybox-ui.join-screen .mode-option {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 92px;
    margin-top: 0;
    margin-right: var(--toy-space-sm);
    margin-bottom: 0;
    margin-left: 0;
    align-items: center;
    padding: var(--toy-space-md);
    white-space: normal;
}

.toybox-ui.join-screen .mode-option--last {
    margin-right: 0;
}

.mode-option__icon {
    width: 30px;
    min-width: 30px;
    height: 30px;
}

.option-copy {
    flex-grow: 1;
    min-width: 0;
}

.option-copy .toy-button__label {
    width: 100%;
    -unity-text-align: middle-left;
}

.mode-option__name,
.opponent-option__name {
    font-size: var(--toy-type-body);
    -unity-font-style: bold;
    color: var(--toy-text);
    white-space: normal;
}

.mode-option__detail,
.opponent-option__detail {
    margin-top: 3px;
    font-size: var(--toy-type-caption);
    color: var(--toy-text-copy);
    white-space: normal;
}

.mode-option__status {
    margin-top: 3px;
    font-size: var(--toy-type-caption);
    color: var(--toy-text-muted);
}

.button--selected .mode-option__detail,
.button--selected .opponent-option__detail {
    color: var(--toy-text-on-accent-quiet);
}

.button--selected .mode-option__name,
.button--selected .opponent-option__name {
    color: var(--toy-text-on-deep);
}

.mode-option:disabled .mode-option__name {
    color: var(--toy-text-muted);
}

.mode-option:disabled .toy-icon {
    opacity: 0.48;
}

.opponent-row {
    flex-direction: row;
    margin-bottom: 2px;
}

.toybox-ui.join-screen .opponent-option {
    width: 210px;
    min-height: 72px;
    margin-right: var(--toy-space-control-top);
    align-items: center;
    padding-left: 14px;
}

.local-multiplayer-row {
    margin-top: var(--toy-space-md);
    margin-bottom: var(--toy-space-sm);
    padding: var(--toy-space-md) 14px;
    background-color: var(--toy-surface-quiet);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-primary);
    border-radius: var(--toy-radius-md);
}

.join-screen .toggle {
    min-height: var(--toy-target-compact);
}

.local-multiplayer-toggle {
    margin-bottom: 2px;
}

.local-multiplayer-detail {
    padding-left: 35px;
    font-size: var(--toy-type-caption);
    white-space: normal;
}

.fog-row {
    margin-top: 14px;
    margin-bottom: var(--toy-space-xs);
    padding: var(--toy-space-md) 14px;
    flex-direction: row;
    align-items: center;
    background-color: var(--toy-surface-quiet);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-divider);
    border-radius: var(--toy-radius-md);
}

.fog-icon {
    width: 30px;
    min-width: 30px;
    height: 30px;
    margin-right: var(--toy-space-md);
}

.fog-copy {
    flex-grow: 1;
}

.fog-toggle {
    margin-bottom: 0;
}

.fog-detail {
    font-size: var(--toy-type-caption);
    white-space: normal;
}

.create-action {
    width: 280px;
    margin-top: 6px;
    justify-content: center;
}

.relay-code-panel {
    margin-top: var(--toy-space-panel-compact);
    padding: var(--toy-space-md) 14px;
    background-color: var(--toy-surface-quiet);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-divider);
    border-radius: var(--toy-radius-md);
}

/* Trailing letter-spacing pads the right edge, so the box is cut narrower there. */
.relay-code {
    align-self: flex-start;
    margin-top: var(--toy-space-xs);
    margin-bottom: var(--toy-space-md);
    padding: 6px 10px 6px 15px;
    background-color: var(--toy-inset);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-select-pressed);
    border-radius: 9px;
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--toy-text);
    letter-spacing: 5px;
}

.relay-status {
    min-height: 20px;
    margin-bottom: 6px;
    white-space: normal;
}

.relay-cancel,
.join-cancel {
    width: 280px;
    margin-top: var(--toy-space-sm);
}

.join-code-input {
    max-width: 430px;
}

.join-stage {
    flex-grow: 1;
    min-width: 300px;
    justify-content: center;
    margin-left: 32px;
}

.join-stage__picture {
    width: 100%;
    max-width: 620px;
    height: 420px;
    background-image: url("project://database/Assets/Images/JoinToyboxStage.png");
    -unity-background-scale-mode: scale-and-crop;
    border-width: 4px;
    border-bottom-width: 9px;
    border-color: var(--toy-edge);
    border-radius: 16px;
}

.compact .join-layout {
    padding: 26px;
}

.compact .join-workbench {
    width: 68%;
    min-width: 600px;
}

.compact .join-stage {
    min-width: 240px;
    margin-left: 22px;
}

.compact .join-stage__picture {
    height: 340px;
}

.narrow .join-layout {
    padding: 24px;
}

.narrow .join-workbench {
    width: 100%;
    min-width: 0;
}

.narrow .join-stage {
    display: none;
}

.phone .join-layout {
    padding: 14px;
}

.phone .join-header {
    align-items: flex-start;
}

.phone .join-screen .join-back-button {
    width: 54px;
    min-width: 54px;
    padding-left: 11px;
    padding-right: var(--toy-space-sm);
}

.phone .join-back-label {
    display: none;
}

.phone .join-tabs {
    max-width: none;
}

.phone .mode-row,
.phone .opponent-row {
    flex-direction: column;
}

.phone .join-screen .mode-option,
.phone .join-screen .opponent-option {
    width: 100%;
    min-width: 0;
    flex-grow: 0;
    flex-basis: auto;
    min-height: 68px;
    margin-right: 0;
    margin-bottom: var(--toy-space-sm);
}

.phone .create-action,
.phone .relay-cancel,
.phone .join-cancel {
    width: 100%;
}

.short .join-layout {
    padding-top: 12px;
    padding-bottom: 12px;
}

.short .join-header {
    min-height: 54px;
    margin-bottom: 6px;
}

.short .join-tabs {
    margin-bottom: var(--toy-space-sm);
}

.short .join-section-label {
    margin-top: var(--toy-space-control-top);
}

.short .join-screen .mode-option {
    min-height: 68px;
}

.short .mode-option__detail,
.short .opponent-option__detail,
.short .fog-detail {
    display: none;
}

.short .fog-row {
    margin-top: var(--toy-space-sm);
    padding-top: 6px;
    padding-bottom: 6px;
}
