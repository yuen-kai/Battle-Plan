/* Match setup — 520px operating column, stage on the right (ArtDirection §5.5, "Match setup"). */

.join-screen {
    background-color: var(--bp-table);
}

.join-layout {
    flex-direction: row;
    align-items: stretch;
    padding: 0;
}

.toybox-ui.join-screen .join-column {
    width: 520px;
    min-width: 520px;
    padding: var(--bp-s7) var(--bp-s6);
    background-color: var(--bp-deck-1);
    border-right-width: var(--bp-bw-hair);
    border-right-color: var(--bp-line-2);
}

.toybox-ui.join-screen .join-back-button {
    align-self: flex-start;
    min-height: 40px;
    margin-bottom: var(--bp-s5);
    padding-left: var(--bp-s2);
    padding-right: var(--bp-s3);
    color: var(--bp-text-3);
}

.toybox-ui.join-screen .join-back-button .toy-button__label {
    color: var(--bp-text-3);
}

.toybox-ui.join-screen .join-back-button:hover .toy-button__label {
    color: var(--bp-text);
}

.join-heading {
    margin-bottom: var(--bp-s5);
}

/* --- Segmented control ------------------------------------------------------ */

.join-tabs {
    width: 100%;
    height: var(--bp-target);
    flex-direction: row;
    margin-bottom: var(--bp-s5);
    padding: 0;
    background-color: var(--bp-deck-1);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
}

.toybox-ui.join-screen .join-tab {
    flex-grow: 1;
    flex-basis: 0;
    width: 0;
    min-width: 0;
    min-height: 42px;
    background-color: var(--bp-transparent);
    border-width: 0;
    border-radius: 0;
    color: var(--bp-text-3);
}

.toybox-ui.join-screen .join-tab .toy-button__label {
    color: var(--bp-text-3);
}

.toybox-ui.join-screen .join-tab .toy-icon {
    -unity-background-image-tint-color: var(--bp-text-3);
}

.toybox-ui.join-screen .join-tab:hover {
    background-color: var(--bp-line-1);
}

.toybox-ui.join-screen .join-tab:hover .toy-button__label {
    color: var(--bp-text-2);
}

.toybox-ui.join-screen .join-tab:hover .toy-icon {
    -unity-background-image-tint-color: var(--bp-text-2);
}

/* Active tab: one rung up plus a 2px amber rule inset to the tab's own width. */
.toybox-ui.join-screen .join-tab.button--selected,
.toybox-ui.join-screen .join-tab.button--selected:hover {
    background-color: var(--bp-deck-3);
    border-width: 0;
    border-bottom-width: var(--bp-bw);
    border-bottom-color: var(--bp-amber);
    transition-property: background-color, border-color;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.toybox-ui.join-screen .join-tab.button--selected .toy-button__label {
    color: var(--bp-text);
}

.toybox-ui.join-screen .join-tab.button--selected .toy-icon {
    -unity-background-image-tint-color: var(--bp-text);
}

.toybox-ui.join-screen .join-tab:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.toybox-ui.join-screen .join-tab:active {
    translate: 0 0;
}

/* --- Views ------------------------------------------------------------------- */

.join-content {
    flex-grow: 1;
    min-height: 0;
}

.join-content .unity-scroll-view__content-container {
    width: 100%;
}

.join-content .unity-scroller--horizontal {
    display: none;
}

.join-panel {
    width: 100%;
    padding-right: var(--bp-s2);
}

.join-view-heading {
    margin-bottom: var(--bp-s4);
}

.join-section-label {
    margin-top: var(--bp-s4);
}

/* --- Option rows --------------------------------------------------------------- */

.mode-row,
.opponent-row {
    margin-bottom: var(--bp-s2);
}

.toybox-ui.join-screen .mode-option,
.toybox-ui.join-screen .opponent-option {
    width: 100%;
    min-width: 0;
    min-height: 64px;
    margin-bottom: var(--bp-s2);
    padding: 0 var(--bp-s4);
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--bp-deck-1);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
}

.toybox-ui.join-screen .opponent-option {
    min-height: 56px;
}

.toybox-ui.join-screen .mode-option--last,
.toybox-ui.join-screen .opponent-option--last {
    margin-bottom: 0;
}

.toybox-ui.join-screen .mode-option:hover,
.toybox-ui.join-screen .opponent-option:hover {
    background-color: var(--bp-deck-2);
    border-color: var(--bp-line-3);
}

.toybox-ui.join-screen .mode-option:active,
.toybox-ui.join-screen .opponent-option:active {
    background-color: var(--bp-deck-3);
}

.toybox-ui.join-screen .mode-option:focus,
.toybox-ui.join-screen .opponent-option:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.toybox-ui.join-screen .mode-option.button--selected,
.toybox-ui.join-screen .mode-option.button--selected:hover,
.toybox-ui.join-screen .opponent-option.button--selected,
.toybox-ui.join-screen .opponent-option.button--selected:hover {
    background-color: var(--bp-blue-surface);
    border-color: var(--bp-blue-line);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-blue);
    padding-left: 14px;
}

.toybox-ui.join-screen .mode-option.button--selected .toy-icon,
.toybox-ui.join-screen .opponent-option.button--selected .toy-icon {
    -unity-background-image-tint-color: var(--bp-blue);
}

.toybox-ui.join-screen .mode-option.button--selected:focus,
.toybox-ui.join-screen .opponent-option.button--selected:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

/* Capture the Flag is permanently unavailable: no hover, no focus ring, no pick. */
.toybox-ui.join-screen .mode-option--unavailable,
.toybox-ui.join-screen .mode-option--unavailable:hover,
.toybox-ui.join-screen .mode-option--unavailable:focus,
.toybox-ui.join-screen .mode-option--unavailable:disabled,
.toybox-ui.join-screen .mode-option--unavailable:disabled:hover {
    opacity: 1;
    background-color: var(--bp-deck-1);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-1);
}

.mode-option--unavailable .option-name,
.mode-option--unavailable .option-detail {
    color: var(--bp-text-3);
}

.option-icon {
    margin-right: var(--bp-s3);
    -unity-background-image-tint-color: var(--bp-text-2);
}

.option-copy {
    flex-grow: 1;
    min-width: 0;
}

.option-name {
    font-size: var(--bp-type-body);
    -unity-font-style: bold;
    color: var(--bp-text);
    -unity-text-align: middle-left;
    white-space: normal;
}

.option-detail {
    margin-top: 2px;
    font-size: var(--bp-type-body-sm);
    color: var(--bp-text-2);
    -unity-text-align: middle-left;
    white-space: normal;
}

/* --- Checkboxes ------------------------------------------------------------------ */

.check-row {
    margin-top: var(--bp-s3);
}

.check-detail {
    margin-left: 30px;
    margin-top: 2px;
    font-size: var(--bp-type-body-sm);
    color: var(--bp-text-2);
    white-space: normal;
}

/* UI Toolkit's Toggle owns the box-then-label order, so the fog glyph leads the
   row instead of sitting between them. */
.fog-row {
    flex-direction: row;
    align-items: flex-start;
}

.fog-lead {
    padding-top: 2px;
}

.fog-icon {
    margin-right: var(--bp-s2);
    -unity-background-image-tint-color: var(--bp-text-2);
}

.fog-copy {
    flex-grow: 1;
    min-width: 0;
}

.fog-row .check-detail {
    margin-left: 30px;
}

/* --- Actions ----------------------------------------------------------------------- */

.create-action {
    width: 100%;
    margin-top: var(--bp-s3);
}

/* --- Connection readout -------------------------------------------------------------- */

.toybox-ui.join-screen .relay-code-panel {
    margin-top: var(--bp-s4);
}

.relay-code {
    min-height: var(--bp-target-lg);
    margin-top: var(--bp-s2);
    background-color: var(--bp-deck-0);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    font-size: var(--bp-type-num-lg);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--bp-text);
    letter-spacing: 5px;
}

.relay-status {
    margin-bottom: var(--bp-s3);
}

.toybox-ui.join-screen .relay-cancel,
.toybox-ui.join-screen .join-cancel {
    width: 100%;
    margin-top: var(--bp-s2);
}

.join-input-label {
    margin-bottom: 6px;
}

.join-code-input {
    width: 100%;
    margin-top: 0;
}

/* --- Stage ------------------------------------------------------------------------------ */

.join-stage {
    flex-grow: 1;
    min-width: 320px;
    background-color: var(--bp-table);
    overflow: hidden;
}

.join-stage__picture {
    flex-grow: 1;
    background-image: url("project://database/Assets/Images/JoinToyboxStage.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* --- Responsive ---------------------------------------------------------------------------- */

.compact .toybox-ui.join-screen .join-column {
    width: 480px;
    min-width: 480px;
    padding: var(--bp-s6) var(--bp-s5);
}

.narrow .toybox-ui.join-screen .join-column {
    width: 100%;
    min-width: 0;
    border-right-width: 0;
}

.narrow .join-stage {
    display: none;
}

.phone .toybox-ui.join-screen .join-column {
    width: 100%;
    min-width: 0;
    padding: var(--bp-s5) var(--bp-s4);
}

.phone .join-heading {
    font-size: 28px;
}

.short .toybox-ui.join-screen .join-column {
    padding-top: var(--bp-s5);
    padding-bottom: var(--bp-s5);
}

.short .toybox-ui.join-screen .join-back-button {
    margin-bottom: var(--bp-s3);
}

.short .join-heading {
    margin-bottom: var(--bp-s3);
}

.short .join-tabs {
    margin-bottom: var(--bp-s3);
}

.short .join-section-label {
    margin-top: var(--bp-s3);
}

.short .toybox-ui.join-screen .mode-option {
    min-height: 52px;
}

.short .toybox-ui.join-screen .opponent-option {
    min-height: 48px;
}

.short .option-detail,
.short .check-detail {
    display: none;
}
