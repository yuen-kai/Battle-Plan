.game-screen {
    background-color: rgba(0, 0, 0, 0);
}

.hud-flash {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-color: rgba(255, 255, 255, 0.15);
    transition-duration: 0.14s;
    transition-property: opacity;
}

.hud-flash--active {
    opacity: 1;
}

.hud-top {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 20px;
    height: 100px;
}

.hud-top .phase-cluster {
    position: absolute;
    top: 0;
    left: 50%;
    width: 380px;
    min-height: 72px;
    margin-left: -190px;
    align-items: center;
    justify-content: center;
    padding: 10px 28px 12px 28px;
    background-color: var(--toy-panel);
    border-color: var(--toy-ink);
    border-bottom-width: var(--toy-depth-panel);
    border-radius: var(--toy-radius-lg);
}

.hud-top .phase-cluster__mark {
    position: absolute;
    top: 12px;
    left: 14px;
    width: 10px;
    height: 10px;
    background-color: var(--toy-orange);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-ink);
    border-radius: var(--toy-radius-sm);
}

.hud-top .phase-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--toy-cream);
    letter-spacing: 0;
    -unity-text-align: middle-center;
}

.hud-top .phase-label--friendly {
    color: var(--toy-orange-hover);
}

.hud-top .phase-label--enemy {
    color: var(--toy-tomato-copy);
}

.hud-top .phase-label--neutral {
    color: var(--toy-cream);
}

.hud-top .timer-label {
    min-height: 22px;
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--toy-orange);
}

.hud-top .timer-label--urgent {
    color: var(--toy-tomato-copy);
}

.hud-top .hill-status-readout {
    position: absolute;
    top: 0;
    right: 0;
    width: 260px;
    min-height: 72px;
    align-items: stretch;
    padding: 10px 14px 12px 14px;
}

.hud-top .hill-status-readout__key {
    margin-bottom: 5px;
    letter-spacing: 0;
}

.hud-top .hill-status-readout__value {
    align-self: flex-start;
    font-size: var(--toy-type-caption);
    -unity-font-style: bold;
    color: var(--toy-orange-hover);
    letter-spacing: 0;
}

.hud-top .hill-status--blue {
    color: var(--toy-cream);
    border-color: var(--toy-sky);
}

.hud-top .hill-status--red {
    color: var(--toy-cream);
    border-color: var(--toy-tomato);
}

.hud-top .hill-status--contested {
    color: var(--toy-cream);
    border-color: var(--toy-orange);
}

.hud-dock {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 8px;
    min-height: 0;
    padding: 8px 16px;
    background-color: rgba(7, 12, 19, 0.94);
    border-width: 1px;
    border-color: rgb(48, 65, 80);
    border-radius: 3px;
}

.hud-dock__header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.planning-copy {
    flex-grow: 1;
    min-width: 0;
    padding-right: 16px;
}

.planning-message-slot {
    position: relative;
    height: 24px;
    min-height: 24px;
}

.planning-help {
    font-size: 11px;
    color: rgb(157, 172, 185);
    white-space: normal;
}

.target-feedback {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    min-height: 24px;
    padding: 3px 8px;
    background-color: rgb(13, 21, 29);
    color: rgb(225, 231, 235);
    border-left-width: 3px;
    border-left-color: rgb(123, 141, 156);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
}

.target-feedback--visible {
    opacity: 1;
}

.target-feedback--error {
    background-color: rgb(42, 20, 23);
    color: rgb(255, 211, 207);
    border-left-color: rgb(255, 126, 118);
}

.target-feedback--success {
    background-color: rgb(41, 32, 17);
    color: rgb(255, 231, 188);
    border-left-color: rgb(235, 174, 69);
}

.hud-header-actions {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
}

.hud-key {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-right: 12px;
}

.hud-key__swatch {
    width: 9px;
    height: 9px;
    margin-right: 7px;
}

.hud-key__swatch--amber {
    background-color: rgb(229, 158, 45);
}

.hud-key__label {
    font-size: 11px;
    color: rgb(147, 162, 175);
    letter-spacing: 1px;
}

.planning-commit {
    min-height: 44px;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-right: 8px;
    padding-left: 10px;
    background-color: rgb(13, 21, 29);
    border-left-width: 2px;
    border-left-color: rgb(226, 157, 46);
}

.planning-commit__status {
    min-width: 72px;
    flex-shrink: 0;
    margin-right: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(235, 178, 76);
    letter-spacing: 1px;
    white-space: nowrap;
}

.planning-commit__button {
    min-width: 112px;
    min-height: 44px;
    flex-shrink: 0;
    padding: 8px 14px;
    font-size: 12px;
}

.planning-commit--ready .planning-commit__status {
    color: rgb(235, 178, 76);
}

.planning-commit--sending .planning-commit__status,
.planning-commit--waiting .planning-commit__status,
.planning-commit--unlocking .planning-commit__status {
    color: rgb(112, 187, 236);
}

.planning-commit--locked {
    border-left-color: rgb(100, 193, 249);
}

.planning-commit--locked .planning-commit__status {
    color: rgb(139, 208, 245);
}

.hud-controls-button {
    min-height: 44px;
    flex-shrink: 0;
    padding: 6px 11px;
    font-size: 11px;
}

.enemy-status-strip {
    margin-top: 6px;
}

.enemy-status-strip__header {
    min-height: 15px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.enemy-status-strip__label,
.enemy-status-strip__summary {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.enemy-status-strip__label {
    color: rgb(255, 139, 132);
}

.enemy-status-strip__summary {
    color: rgb(146, 162, 176);
}

.enemy-unit-cards {
    flex-grow: 0;
    height: 78px;
    margin-top: 3px;
}

.enemy-unit-cards .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-direction: row;
}

.unit-cards {
    flex-grow: 0;
    height: 104px;
    margin-top: 8px;
}

.unit-cards .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-direction: row;
}

.unit-card-host {
    flex-grow: 1;
    flex-shrink: 0;
    width: 0;
    min-width: 264px;
    max-width: 360px;
    min-height: 96px;
    margin-right: 8px;
}

.unit-card-host--last {
    margin-right: 0;
}

.enemy-unit-card-host {
    flex-grow: 1;
    flex-shrink: 0;
    width: 0;
    min-width: 220px;
    max-width: 320px;
    min-height: 72px;
    margin-right: 6px;
}

.enemy-unit-card-host--last {
    margin-right: 0;
}

.unit-card {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 96px;
    flex-direction: row;
    overflow: hidden;
    background-color: rgb(13, 22, 31);
    border-width: 1px;
    border-color: rgb(48, 65, 80);
    border-radius: 2px;
}

.unit-card__state-mark {
    display: none;
    position: absolute;
    left: 8px;
    top: 8px;
    width: 7px;
    height: 7px;
    background-color: rgb(232, 167, 58);
}

.unit-card--selected {
    background-color: rgb(25, 37, 47);
    border-color: rgb(231, 167, 58);
}

.unit-card--ability {
    background-color: rgb(59, 35, 20);
    border-color: rgb(177, 108, 43);
}

.unit-card--ability.unit-card--selected {
    border-color: rgb(255, 190, 92);
}

.unit-card--selected .unit-card__state-mark {
    display: flex;
}

.unit-card--disabled {
    opacity: 0.55;
    border-color: rgb(92, 56, 60);
}

.unit-card__select {
    position: relative;
    flex-grow: 1;
    width: 100%;
    min-width: 0;
    padding: 0;
    flex-direction: row;
    align-items: stretch;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    transition-duration: 0.14s;
    transition-property: background-color, border-color;
}

.unit-card__select:hover {
    background-color: rgb(23, 36, 48);
}

.unit-card__select:focus {
    background-color: rgb(27, 41, 54);
    border-color: rgb(237, 174, 65);
}

.unit-card--ability .unit-card__select {
    background-color: rgb(59, 35, 20);
}

.unit-card--ability .unit-card__select:hover {
    background-color: rgb(76, 44, 23);
}

.unit-card--ability .unit-card__select:focus {
    background-color: rgb(71, 41, 22);
    border-color: rgb(255, 208, 134);
}

.unit-card__ability-vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-image: url("project://database/Assets/UI/Shared/Icons/ability-flare.svg");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(242, 165, 74);
    transition-duration: 0.14s;
    transition-property: opacity;
}

.unit-card--ability .unit-card__ability-vignette {
    opacity: 0.42;
}

.unit-card__portrait {
    position: relative;
    width: 80px;
    min-width: 80px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(7, 13, 20);
}

.unit-card__copy {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
    padding: 8px 40px 8px 8px;
}

.unit-card__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(239, 243, 246);
    white-space: normal;
}

.unit-card__health {
    min-height: 13px;
    margin-top: 3px;
    flex-direction: row;
    align-items: center;
}

.unit-card__health-track {
    flex-grow: 1;
    height: 5px;
    margin-right: 7px;
    overflow: hidden;
    background-color: rgb(48, 31, 36);
    border-radius: 1px;
}

.unit-card__health-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(226, 82, 82);
}

.unit-card__health-value {
    min-width: 68px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(229, 235, 240);
    -unity-text-align: middle-right;
}

.unit-card__ability {
    margin-top: 4px;
    font-size: 11px;
    color: rgb(159, 174, 187);
    white-space: normal;
}

.unit-card--ability .unit-card__ability {
    color: rgb(255, 210, 143);
    -unity-font-style: bold;
}

.unit-card--ability-cooldown .unit-card__ability {
    color: rgb(126, 137, 147);
}

.unit-card__state {
    min-height: 0;
    margin-top: 4px;
    font-size: 11px;
    color: rgb(255, 126, 118);
    letter-spacing: 1px;
}

.unit-card__flip-indicator {
    position: absolute;
    right: 8px;
    bottom: 6px;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    opacity: 0.68;
    transition-duration: 0.14s;
    transition-property: opacity;
}

.unit-card__flip-icon {
    position: absolute;
    width: 22px;
    height: 22px;
    background-image: url("project://database/Assets/UI/Shared/Icons/flip-card.svg");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(205, 216, 225);
}

.unit-card__cooldown {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(225, 231, 235);
}

.unit-card--selected .unit-card__flip-indicator {
    opacity: 1;
}

.unit-card__select:hover .unit-card__flip-indicator {
    opacity: 0.9;
}

.unit-card--selected .unit-card__flip-icon {
    -unity-background-image-tint-color: rgb(231, 167, 58);
}

.unit-card--ability .unit-card__flip-icon {
    -unity-background-image-tint-color: rgb(255, 210, 143);
}

.unit-card__flip-indicator--cooldown,
.unit-card--selected .unit-card__flip-indicator--cooldown {
    opacity: 0.72;
}

.unit-card__flip-indicator--cooldown .unit-card__flip-icon,
.unit-card--selected .unit-card__flip-indicator--cooldown .unit-card__flip-icon {
    opacity: 0.22;
    -unity-background-image-tint-color: rgb(126, 137, 147);
}

.unit-card__flip-indicator--cooldown .unit-card__cooldown {
    color: rgb(171, 181, 189);
}

.unit-card--disabled .unit-card__flip-indicator {
    opacity: 0.45;
}

.unit-card--enemy {
    min-height: 72px;
    background-color: rgb(24, 16, 22);
    border-color: rgb(107, 55, 62);
}

.unit-card--enemy-active {
    border-color: rgb(168, 70, 75);
}

.unit-card--enemy-eliminated {
    background-color: rgb(16, 15, 19);
    border-color: rgb(74, 62, 68);
}

.unit-card--enemy .unit-card__select {
    min-width: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    opacity: 1;
}

.unit-card--enemy .unit-card__select:disabled {
    background-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

.unit-card--enemy .unit-card__portrait {
    width: 52px;
    min-width: 52px;
    background-color: rgb(12, 10, 14);
}

.unit-card--enemy .unit-card__copy {
    position: relative;
    justify-content: center;
    padding: 5px 7px;
}

.unit-card--enemy .unit-card__name {
    padding-right: 82px;
    font-size: 12px;
    white-space: nowrap;
}

.unit-card--enemy .unit-card__ability {
    margin-top: 2px;
    font-size: 10px;
    white-space: normal;
}

.unit-card--enemy .unit-card__state {
    position: absolute;
    top: 0;
    right: 0;
    min-height: 13px;
    margin-top: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(255, 139, 132);
    letter-spacing: 0;
}

.unit-card--enemy-eliminated .unit-card__name,
.unit-card--enemy-eliminated .unit-card__ability,
.unit-card--enemy-eliminated .unit-card__health-value {
    color: rgb(136, 144, 151);
}

.unit-card--enemy-eliminated .unit-card__health-fill {
    background-color: rgb(91, 66, 70);
}

.unit-card--enemy-eliminated .unit-card__state {
    color: rgb(196, 139, 139);
}

.unit-card--enemy .unit-card__flip-indicator,
.unit-card--enemy .unit-card__ability-vignette {
    display: none;
}

.deployment-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--toy-space-xl);
    background-color: var(--toy-ink);
}

.toybox-ui.deployment-overlay .deployment-overlay__content {
    width: 620px;
    max-width: 92%;
    align-items: center;
    padding: var(--toy-space-xl);
}

.deployment-overlay__mark {
    width: 82px;
    height: 6px;
    margin-bottom: var(--toy-space-lg);
    background-color: var(--toy-orange);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-ink);
    border-radius: var(--toy-radius-sm);
}

.deployment-overlay__title {
    font-size: var(--toy-type-title-lg);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--toy-cream);
}

.deployment-overlay__status {
    margin-top: var(--toy-space-md);
    font-size: var(--toy-type-body);
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--toy-muted);
}

.results-overlay {
    background-color: var(--toy-shade);
}

.controls-overlay {
    background-color: var(--toy-shade);
}

.toybox-ui.results-overlay .results-panel {
    width: 620px;
    align-items: stretch;
}

.results-scroll {
    min-height: 0;
    max-height: 320px;
}

.results-scroll .unity-scroll-view__content-container {
    padding-right: var(--toy-space-md);
}

.results-mark {
    width: 92px;
    height: 6px;
    margin-top: var(--toy-space-sm);
    margin-bottom: var(--toy-space-md);
    background-color: var(--toy-orange);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-ink);
    border-radius: var(--toy-radius-sm);
}

.results-status {
    margin-bottom: var(--toy-space-sm);
    font-size: var(--toy-type-display);
    -unity-font-style: bold;
    color: var(--toy-cream);
    white-space: normal;
}

.results-actions {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
}

.results-button {
    min-width: 170px;
    margin-left: var(--toy-space-sm);
}

.compact .hud-dock {
    left: 16px;
    right: 16px;
    bottom: 8px;
}

.compact .unit-card-host {
    width: 0;
    min-width: 240px;
    max-width: 300px;
}

.compact .enemy-unit-card-host {
    min-width: 210px;
    max-width: 280px;
}

.compact .unit-card__select {
    flex-grow: 1;
    width: 100%;
    min-width: 0;
}

.compact .unit-card__portrait {
    width: 48px;
    min-width: 48px;
}

.compact .unit-card__copy {
    padding: 6px 36px 6px 6px;
}

.compact .unit-card__name {
    font-size: 12px;
}

.compact .unit-card__ability {
    font-size: 10px;
}

.compact .unit-card__state {
    font-size: 9px;
}

.compact .unit-card--enemy .unit-card__name {
    padding-right: 76px;
}

.compact .unit-card--enemy .unit-card__state,
.compact .unit-card--enemy .unit-card__health-value {
    font-size: 10px;
}

.compact .unit-card__flip-indicator {
    right: 7px;
    bottom: 5px;
    width: 26px;
    height: 26px;
}

.compact .unit-card__flip-icon {
    width: 19px;
    height: 19px;
}

.compact .unit-card__cooldown {
    font-size: 12px;
}

.compact .hud-dock__header .section-label,
.compact .planning-help,
.compact .hud-key {
    display: none;
}

.compact .phase-cluster {
    width: 350px;
    margin-left: -175px;
}

.narrow .hud-dock {
    left: 12px;
    right: 12px;
    bottom: 12px;
}

.narrow .unit-card-host {
    width: 220px;
    min-width: 220px;
    max-width: 220px;
}

.narrow .enemy-unit-card-host {
    width: 210px;
    min-width: 210px;
}

.narrow .unit-card__portrait {
    display: none;
}

.narrow .unit-card__select {
    min-width: 0;
}

.narrow .phase-cluster {
    width: 330px;
    margin-left: -165px;
}

.narrow .hill-status-readout {
    width: 244px;
}

.phone .hud-dock {
    padding-left: 10px;
    padding-right: 10px;
}

.phone .hud-dock__header {
    flex-direction: column;
    align-items: stretch;
}

.phone .unit-cards {
    flex-grow: 1;
    height: auto;
}

.phone .hud-key {
    display: none;
}

.phone .planning-copy {
    width: 100%;
    padding-right: 0;
}

.phone .hud-header-actions {
    width: 100%;
    justify-content: flex-end;
}

.phone .planning-commit {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 6px;
    padding-left: 8px;
}

.phone .planning-commit__status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 6px;
    font-size: 9px;
}

.phone .planning-commit__button {
    min-width: 88px;
    padding-left: 10px;
    padding-right: 10px;
}

.phone .hud-controls-button {
    min-height: 44px;
    padding-left: 8px;
    padding-right: 8px;
}

.phone .unit-card-host {
    width: 184px;
    min-width: 184px;
    max-width: 184px;
    margin-right: 6px;
}

.phone .unit-card-host--last {
    margin-right: 0;
}

.phone .unit-card {
    min-height: 112px;
}

.phone .unit-card__select {
    width: 100%;
    min-width: 0;
    min-height: 104px;
}

.phone .unit-card__copy {
    padding: 8px 36px 8px 8px;
}

.phone .unit-card__name {
    font-size: 12px;
}

.phone .unit-card__ability {
    font-size: 11px;
}

.phone .enemy-unit-cards {
    flex-grow: 0;
    height: 78px;
}

.phone .enemy-unit-card-host {
    width: 210px;
    min-width: 210px;
}

.phone .unit-card--enemy {
    min-height: 72px;
    flex-direction: row;
}

.phone .unit-card--enemy .unit-card__select {
    width: 100%;
    min-height: 0;
}

.phone .unit-card--enemy .unit-card__copy {
    padding: 5px 7px;
}

.phone .unit-card--enemy .unit-card__name {
    padding-right: 76px;
    font-size: 12px;
}

.phone .unit-card--enemy .unit-card__ability,
.phone .unit-card--enemy .unit-card__state,
.phone .unit-card--enemy .unit-card__health-value {
    font-size: 10px;
}

.phone .phase-cluster {
    top: 0;
    left: 0;
    right: 0;
    width: auto;
    min-height: 54px;
    margin-left: 0;
    padding-top: 6px;
    padding-bottom: 8px;
}

.phone .hill-status-readout {
    top: 62px;
    left: 0;
    right: 0;
    width: auto;
    min-height: 66px;
    padding: 7px 10px 9px 10px;
    flex-direction: column;
    align-items: stretch;
}

.phone .hud-top {
    left: 10px;
    right: 10px;
    top: 10px;
    height: 148px;
}

.phone .hill-status-readout__key {
    display: none;
}

.phone .hill-status-readout__value {
    align-self: stretch;
}

.phone .deployment-overlay {
    padding: var(--toy-space-panel-compact);
}

.phone .deployment-overlay__title {
    font-size: 24px;
}

.phone .results-actions {
    flex-direction: column;
}

.phone .results-button {
    width: 100%;
    margin-left: 0;
    margin-top: var(--toy-space-sm);
}

.short .hud-dock {
    min-height: 0;
    padding-top: 8px;
    padding-bottom: 8px;
}

.short .hud-dock__header {
    min-height: 24px;
    align-items: center;
}

.short .hud-dock__header .section-label,
.short .planning-help,
.short .hud-key {
    display: none;
}

.short .planning-message-slot {
    height: 24px;
    min-height: 24px;
}

.short .target-feedback {
    min-height: 22px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.short .hud-controls-button {
    min-height: 44px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.short .unit-cards {
    margin-top: 0;
}

.short .unit-card-host,
.short .unit-card {
    min-height: 96px;
}

.short .enemy-unit-card-host,
.short .unit-card--enemy {
    min-height: 72px;
}

.short .hud-top {
    top: 12px;
}

.short .phase-cluster {
    top: 0;
    min-height: 54px;
}

.short .phase-label {
    font-size: 20px;
}

.short .hud-top .timer-label {
    font-size: 16px;
}

.phone.short .hud-controls-button {
    min-height: 44px;
    padding-top: 7px;
    padding-bottom: 7px;
}

.phone.short .hud-top {
    left: 10px;
    right: 10px;
    top: 8px;
    height: 72px;
}

.phone.short .phase-cluster {
    left: 0;
    right: auto;
    width: 40%;
    min-height: 54px;
    margin-left: 0;
    padding: 6px 12px 8px 12px;
}

.phone.short .hill-status-readout {
    left: auto;
    right: 0;
    top: 0;
    width: 56%;
    min-height: 54px;
    padding: 6px 10px 8px 10px;
}
