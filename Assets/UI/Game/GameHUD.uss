/* The in-match HUD.
 
   Overwatch puts almost nothing between the player and the fight: two bands of
   near-black chrome, an orange objective banner hanging into the top of the
   frame, and the crew along the bottom. Everything here is one of those three.
 
   One structural constraint shapes the whole sheet: the two bands are not an
   overlay. GameHUDController shrinks the board camera to the strip they leave
   free, so they must be fully opaque — the camera does not paint behind them —
   and only the objective banner is allowed to cross onto the board.
 
   The unit and ability cards at the bottom deliberately sit outside .toybox-ui
   scope, so they take their type from the :root default in BattlePlan.uss and
   their chrome from this file. Anything they need in the display face has to
   ask for it here. */

/* === THE HUD RUNS THE BOARD'S DARK END ===
 
   The front end is built from the deck: pale plates, wall-coloured ink, the
   overlay blue for selection. The match cannot be, and this is the one place
   the two halves of the map's palette meet.
 
   The reason is the board itself. The deck is #A8B3B8 and the two HUD bands are
   opaque by necessity — the camera is shrunk to the gap between them — so bands
   made of the deck against the deck would erase the boundary the whole layout
   depends on. The map already contains the answer: it has a dark end. These
   values are Map_Cover #46525A walked down until type carries on it, the
   hairlines are Map_WallCap #ADC7D1, and the portrait backing is Map_Void
   #5E5346, the table the board stands on. The HUD is the inside of a wall
   looking out at the floor.
 
   The tokens are re-declared rather than the rules rewritten. Custom properties
   inherit, so everything inside #screen — including the unit and ability cards,
   which deliberately sit outside .toybox-ui scope — resolves against these
   instead. Every rule below this block is written once and works in either
   half. Deleting this block puts the HUD on the deck palette; nothing else
   needs to change to do it. */
.game-screen {
    background-color: var(--toy-transparent);

    --toy-ground: rgb(22, 29, 33);
    --toy-surface: rgb(30, 39, 44);
    --toy-surface-raised: rgb(44, 57, 65);
    /* Only the unit card's hover and focus fill. Pulled down a step with the
       ink above it: a card's ability line is --toy-text-copy, and at the old
       lift the softened ladder would have dropped it to 4.1:1 on hover — the
       one state where the player is actually looking at that card. */
    --toy-surface-hover: rgb(53, 68, 75);
    --toy-surface-pressed: rgb(20, 26, 30);
    --toy-surface-quiet: rgb(35, 46, 52);
    --toy-inset: rgb(15, 20, 23);
    --toy-warm: rgb(58, 53, 41);
    --toy-scrim: rgba(15, 20, 23, 0.8);
    --toy-panel: rgba(23, 31, 35, 0.9);
    --toy-panel-sheer: rgba(23, 31, 35, 0.76);
    --toy-scrim-tint: rgb(13, 18, 21);
    --toy-vignette-tint: rgb(15, 20, 23);

    --toy-edge: rgba(173, 199, 209, 0.26);
    --toy-edge-strong: rgba(173, 199, 209, 0.6);
    --toy-divider: rgba(173, 199, 209, 0.14);
    --toy-disabled-surface: rgb(33, 42, 47);
    --toy-disabled-border: rgba(173, 199, 209, 0.18);

    /* The match runs long and this is the one screen a player stares at for all
       of it, so the top of the ladder is an off-white rather than a near-white.
       #EDF3F5 on the chrome measured 15.2:1 — well past legible and into glare,
       which is its own kind of unreadable after twenty minutes. This sits at
       9.2:1 on the ground and 6.4:1 on a unit card, and the whole ladder is
       re-spaced under it rather than only its top step: the old --toy-text-copy
       was lighter than this value and would have inverted the hierarchy.

       The front end does not get this treatment. It is dark ink on paper, where
       the same complaint does not arise and the muted step is already fighting
       for contrast. */
    --toy-text: rgb(180, 193, 197);
    --toy-text-copy: rgb(166, 179, 184);
    --toy-text-muted: rgb(147, 161, 166);
    --toy-text-on-deep: rgb(17, 26, 30);
    --toy-text-on-accent-quiet: rgb(74, 90, 98);
    --toy-text-border: rgba(173, 199, 209, 0.24);
    --toy-text-wash: rgba(173, 199, 209, 0.1);

    /* Lifted again, because against the wall these are line work and labels
       rather than ink on the floor. */
    --toy-primary-copy: rgb(246, 184, 94);
    --toy-primary-tint: rgb(74, 58, 30);
    --toy-primary-wash: rgb(56, 48, 31);
    --toy-select: rgb(220, 231, 235);
    --toy-select-hover: rgb(241, 246, 248);
    --toy-select-pressed: rgb(180, 198, 206);
    --toy-select-copy: rgb(127, 194, 245);
    --toy-danger: rgb(214, 58, 54);
    /* Darkens under the pointer rather than brightening. A red already light
       enough to carry white at 4.7:1 has nowhere lighter to go that still
       does — the old hover step measured 3.8. */
    --toy-danger-hover: rgb(188, 45, 41);
    --toy-danger-pressed: rgb(176, 42, 39);
    --toy-danger-copy: rgb(255, 122, 118);
    --toy-danger-tint: rgb(56, 26, 24);
    --toy-defeat: rgb(150, 168, 176);

    --toy-focus: rgb(180, 193, 197);
    --toy-shadow-stage: rgba(10, 16, 19, 0.7);
}

.hud-flash {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-color: var(--toy-text-wash);
    transition-duration: 0.14s;
    transition-property: opacity;
}

.hud-flash--active {
    opacity: 1;
}

/* The bands are flat black by necessity; the hatch is what keeps them from
   reading as an unpainted letterbox above and below the game. */
.hud-hatch {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.05;
    background-image: url("project://database/Assets/UI/Shared/Textures/Hatch.png");
    background-repeat: repeat;
    background-size: 18px 18px;
    -unity-background-image-tint-color: var(--toy-text-copy);
}

.hud-top {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 16px;
    height: 78px;
}

/* === OBJECTIVE BANNER === */

/* Centred tab hanging off the bottom edge of the top bar. GameHUDController reserves camera space
   for the opaque bars only, so this tab is one of the few pieces that still crosses onto the board;
   deepening it covers more of the grid. */
.phase-notch {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -31px;
    height: 39px;
    flex-direction: row;
    justify-content: center;
}

/* Tinted to the plate rather than the accent: these caps are the banner's own
   silhouette, not decoration sitting beside it.

   Opaque, and the cluster below with it. This is the only chrome that hangs
   over the deck, and --toy-panel's last tenth let #A8B3B8 up through it: the
   plate arrived at #262E32 instead of #171F23, which cost the friendly phase
   label its AA at 19px. The label's blue mirrors TeamPalette and paints units
   on the board, so it is the plate that had to move. */
.phase-notch .phase-notch__cap {
    width: 16px;
    min-width: 16px;
    align-self: stretch;
    -unity-background-image-tint-color: var(--toy-ground);
}

/* No side or top borders: the caps are the edges, and a hairline drawn around
   the middle section would stop dead where the bevel starts. The orange rule
   goes on the bottom, which is the one edge the trapezoid and the plate share. */
.phase-notch .phase-cluster {
    height: 39px;
    flex-direction: row;
    align-items: center;
    padding: 0 18px;
    background-color: var(--toy-ground);
    border-width: 0;
    border-bottom-width: var(--toy-accent-rule);
    border-bottom-color: var(--toy-primary);
    border-radius: var(--toy-radius-sm);
}

.phase-notch .phase-cluster__mark {
    width: 13px;
    min-width: 13px;
    height: 15px;
    margin-right: 11px;
    background-image: url("project://database/Assets/UI/Shared/Icons/hex.svg");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--toy-primary);
}

/* Both labels take the plate for their box and centre their capitals in it,
   instead of arriving as line boxes for the row to centre.

   OswaldCaps reserves 1.193em above the baseline for accents a caps-only face
   never draws, against a cap of 0.811em. At 27px that is a 40px line box asked
   to centre inside a 36px plate: the row clamped the countdown to the top of
   the cluster and the digits ran down through the orange rule and onto the
   board, a whole cap-height below the phase label's baseline. The urgent step
   is 33px and missed by more.

   Fixing the box to the plate is the part that has to scale — the breakpoints
   below restate both sizes, and none of them can reopen this. */
.phase-notch .phase-label,
.phase-notch .timer-label {
    height: 100%;
    -unity-text-align: middle-left;
}

/* Leaned, because this is a callout about the objective and not a label on a
   control — the same distinction the reference draws between "CONTESTING
   POINT!" and the numbers underneath it. */
.phase-notch .phase-label {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCapsObl-Regular UI SDF.asset");
    font-size: 19px;
    color: var(--toy-text);
    letter-spacing: var(--toy-track-title);
}

/* These were amber and red, a pair that sits 1.25:1 apart in luminance and
   collapses to a CIE76 distance of 7 under tritanopia — the phase label was the
   one place the player learns whose turn it is. The team pair is 96 apart at
   worst across all three simulations, and it says the same thing the units on
   the board are already saying. */
.phase-notch .phase-label--friendly {
    color: var(--toy-team-friendly-copy);
}

.phase-notch .phase-label--enemy {
    color: var(--toy-team-enemy-copy);
}

.phase-notch .phase-label--neutral {
    color: var(--toy-text);
}

/* The countdown is the loudest number on screen, which is the only treatment a
   shot clock over an objective has ever had. */
.phase-notch .timer-label {
    margin-left: 18px;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 27px;
    color: var(--toy-primary);
    letter-spacing: var(--toy-track-label);
}

/* Urgency was signalled by hue alone, on a pair that merges under tritanopia and
   is 1.25:1 in luminance — for a five-second warning that is the whole message
   riding on one channel. Size and weight carry it too now, so the timer changes
   even in greyscale. */
.phase-notch .timer-label--urgent {
    font-size: 33px;
    color: var(--toy-danger-copy);
}

/* === TOP-BAR READOUTS === */

.hud-top .hill-status-readout {
    position: absolute;
    top: 0;
    right: 0;
    width: 260px;
    min-height: 72px;
    align-items: stretch;
    padding: 10px 14px 12px 14px;
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-primary);
}

.hud-top .hill-status-readout__key {
    margin-bottom: 6px;
}

.hud-top .hill-status-readout__value {
    align-self: flex-start;
    font-size: var(--toy-type-label);
    color: var(--toy-primary-copy);
}

/* The pad is the one thing both seats must name identically, so this readout
   takes the absolute team colours GameLoop paints the hill with rather than the
   interaction tokens it used to borrow.

   The -copy variants rather than the cores: these are hairlines on dark chrome,
   and the core ultramarine is dark enough that a one-pixel line of it only
   reaches 2.2:1 there. Cores paint fills and unit bodies; line work on the dark
   HUD takes the lifted pair. Both read as unmistakably the team colour. */
.hud-top .hill-status--blue {
    color: var(--toy-text);
    border-color: var(--toy-team-friendly-copy);
}

.hud-top .hill-status--red {
    color: var(--toy-text);
    border-color: var(--toy-team-enemy-copy);
}

.hud-top .hill-status--contested {
    color: var(--toy-text);
    border-color: var(--toy-primary);
}

/* Mirrors the hill readout across the top bar. It has to sit outside the phase notch: the notch
   keeps reporting the round's own phase, and "someone left" is a different question from "what am
   I doing", so overwriting one with the other would cost the player both answers. */
.hud-top .rejoin-notice {
    position: absolute;
    top: 0;
    left: 0;
    width: 260px;
    min-height: 72px;
    align-items: stretch;
    padding: 10px 14px 12px 14px;
    border-color: var(--toy-edge);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-danger);
}

.hud-top .rejoin-notice__key {
    margin-bottom: 6px;
}

.hud-top .rejoin-notice__value {
    align-self: flex-start;
    font-size: var(--toy-type-label);
    color: var(--toy-danger-copy);
    border-color: var(--toy-danger);
}

/* === BANDS === */

.hud-dock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 0;
    padding: 10px 18px;
    background-color: var(--toy-surface);
    border-top-width: 1px;
    border-color: var(--toy-edge-strong);
}

.hud-dock__row {
    flex-direction: row;
    align-items: center;
}

.enemy-status-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding: 16px 16px 8px 16px;
    background-color: var(--toy-surface);
    border-bottom-width: 1px;
    border-color: var(--toy-edge-strong);
}

.enemy-unit-cards {
    flex-grow: 0;
    height: 78px;
}

.enemy-unit-cards .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
}

/* An objective readout floats over the right end of this same band, so any mode
   that carries one keeps the row packed left. */
.koth .enemy-unit-cards .unity-scroll-view__content-container,
.escort .enemy-unit-cards .unity-scroll-view__content-container {
    justify-content: flex-start;
}

/* Shorter than the roster strip it replaced. An ability card carries a name and
   a charge disc rather than a unit dossier, and every row of height given back
   here is board the camera gets to keep. */
.unit-cards {
    flex-grow: 1;
    min-width: 0;
    height: 84px;
}

.unit-cards .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-direction: row;
}

/* === FEEDBACK STRIPS === */

/* Shares the notch's band above the dock, kept left so the two never meet. */
.target-feedback {
    position: absolute;
    left: 0;
    top: -32px;
    max-width: 640px;
    min-height: 30px;
    padding: 6px 12px;
    background-color: var(--toy-panel);
    color: var(--toy-text);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-edge-strong);
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.target-feedback--visible {
    opacity: 1;
}

.target-feedback--error {
    background-color: var(--toy-danger-tint);
    color: var(--toy-danger-copy);
    border-left-color: var(--toy-danger);
}

.target-feedback--success {
    background-color: var(--toy-primary-wash);
    color: var(--toy-primary-copy);
    border-left-color: var(--toy-primary);
}

/* Tutorial coaching line. Rides the band above the target-feedback bar and stays centred, so it
   reads as guidance about the board rather than feedback about the last click. */
.coach-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: -82px;
    align-items: center;
    opacity: 0;
    transition-duration: 0.14s;
    transition-property: opacity;
}

.coach-prompt--visible {
    opacity: 1;
}

/* The leg clock's last call, in the gap between the two bands. Over the board rather than in a
   readout because it is the one message in the match that must not be missable. */
.escort-alert {
    position: absolute;
    left: 0;
    right: 0;
    top: 26%;
    align-items: center;
    opacity: 0;
    transition-duration: 0.22s;
    transition-property: opacity;
}

.escort-alert--visible {
    opacity: 1;
}

/* No plate under it, so it takes the halo the display face gets on the stage. Orange because this
   is the objective's own clock, which is what the accent is reserved for. */
.escort-alert__copy {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 72px;
    -unity-font-style: normal;
    color: var(--toy-primary-copy);
    letter-spacing: var(--toy-track-display);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 24px var(--toy-shadow-stage);
    white-space: nowrap;
}

/* Tutorial lesson. The beats worth stopping to read get a card instead of a strip, sat well above
   the instruction line. Anchored to the dock rather than the screen centre so a lesson never lands
   on top of the fight it is describing. */
.lesson-popup {
    position: absolute;
    left: 0;
    right: 0;
    top: -210px;
    align-items: center;
    opacity: 0;
    transition-duration: 0.16s;
    transition-property: opacity;
}

.lesson-popup--visible {
    opacity: 1;
}

.toybox-ui.lesson-popup .lesson-popup__card {
    max-width: 700px;
    padding: 22px 32px 18px 32px;
    align-items: center;
    border-top-width: var(--toy-accent-rule);
    border-top-color: var(--toy-primary);
}

.lesson-popup__copy {
    font-size: 19px;
    -unity-text-align: middle-center;
    color: var(--toy-text);
    white-space: normal;
}

/* The card waits for the player rather than a clock, so the dismiss is the only timing control. */
.toybox-ui.lesson-popup .lesson-popup__button {
    margin-top: 18px;
    min-width: 150px;
    justify-content: center;
}

.coach-prompt__copy {
    max-width: 560px;
    padding: 10px 18px;
    background-color: var(--toy-panel);
    color: var(--toy-text);
    border-width: var(--toy-stroke-thin);
    border-left-width: var(--toy-accent-rule);
    border-color: var(--toy-edge);
    border-left-color: var(--toy-primary);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* === DOCK ACTIONS === */

.hud-header-actions {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-left: 18px;
}

.planning-commit {
    min-height: 46px;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-right: 8px;
    padding-left: 12px;
    background-color: var(--toy-surface-quiet);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-primary);
}

.planning-commit__status {
    min-width: 86px;
    flex-shrink: 0;
    margin-right: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 13px;
    color: var(--toy-primary-copy);
    letter-spacing: var(--toy-track-label);
    white-space: nowrap;
}

.planning-commit__button {
    min-width: 124px;
    min-height: 46px;
    flex-shrink: 0;
    padding: 8px 16px;
    justify-content: center;
    font-size: 14px;
}

.planning-commit--ready .planning-commit__status {
    color: var(--toy-primary-copy);
}

/* Committed states read as the cool selection blue so they stay distinct from
   the amber "ready to act" state; the accent alone would collapse the two. */
.planning-commit--sending .planning-commit__status,
.planning-commit--waiting .planning-commit__status,
.planning-commit--unlocking .planning-commit__status {
    color: var(--toy-select-copy);
}

.planning-commit--locked {
    border-left-color: var(--toy-select-copy);
}

.planning-commit--locked .planning-commit__status {
    color: var(--toy-select-copy);
}

.hud-exit-button,
.hud-controls-button,
.hud-settings-button {
    min-height: 46px;
    flex-shrink: 0;
    padding: 6px 14px;
    justify-content: center;
    font-size: 14px;
}

/* Each dock chip is spaced by the one on its left, the way the commit cluster spaces itself, so the
   rightmost chip stays flush with the dock's edge. */
.hud-exit-button,
.hud-controls-button {
    margin-right: 8px;
}

/* Leftmost of the three and the only one that ends the match, so it is kept off the two a player
   reaches for mid-round and given the ink a destructive action wears everywhere else. Quiet rather
   than filled: it is a way out, not something the HUD should be recommending. */
.hud-exit-button {
    color: var(--toy-danger-copy);
    border-color: var(--toy-danger-copy);
}

/* === UNIT CARDS === */

.unit-card-host {
    flex-grow: 1;
    flex-shrink: 0;
    width: 0;
    min-width: 264px;
    max-width: 360px;
    min-height: 76px;
    margin-right: 8px;
}

.unit-card-host--last {
    margin-right: 0;
}

.enemy-unit-card-host {
    flex-grow: 1;
    flex-shrink: 0;
    width: 0;
    min-width: 220px;
    max-width: 320px;
    min-height: 72px;
    margin-right: 6px;
}

.enemy-unit-card-host--last {
    margin-right: 0;
}

/* The leading rule is the card's identity: team colour at rest, the selection
   mark while the card is the one being edited, and the accent once its ability
   is the order. A player scanning the dock reads that three-pixel edge long
   before they read the name on the card. */
.unit-card {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 76px;
    flex-direction: row;
    overflow: hidden;
    background-color: var(--toy-surface-raised);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-team-friendly);
    border-radius: var(--toy-radius-md);
}

/* Selection and "ability ordered" were two shades of one orange, which left the
   loudest colour in the interface meaning both "you are pointing at this" and
   "this is what the unit will do with its round". They are separate facts, so
   they are now separate marks. Selection takes --toy-select — on the HUD's dark
   chrome that is the near-white everything else inverts to — and it moves the
   line work only, leaving the accent free to answer the question the dock
   exists for. */
.unit-card--selected {
    border-color: var(--toy-select);
    border-left-color: var(--toy-select);
}

/* Ordered. The only filled card on the strip, so the dock answers "what have I
   already committed" from across the screen without a word being read. */
.unit-card--ability {
    background-color: var(--toy-primary-tint);
    border-color: var(--toy-primary-pressed);
    border-left-color: var(--toy-primary);
}

/* Ordered and being edited at once. The accent keeps the fill and the leading
   rule, selection keeps the outline, and neither fact hides the other. */
.unit-card--ability.unit-card--selected {
    border-color: var(--toy-select);
    border-left-color: var(--toy-primary);
}

/* Fading the card fades its type with it, and which unit is gone is still
   something the player is reading. Held high enough that the ability line stays
   above 4.5:1 against the faded plate; the red rule and the state line are what
   say the card is out. */
.unit-card--disabled {
    opacity: 0.8;
    border-color: var(--toy-danger-pressed);
    border-left-color: var(--toy-danger);
}

.unit-card__select {
    position: relative;
    flex-grow: 1;
    width: 100%;
    min-width: 0;
    padding: 0;
    flex-direction: row;
    align-items: stretch;
    overflow: hidden;
    background-color: var(--toy-transparent);
    color: var(--toy-text);
    border-width: 1px;
    border-color: var(--toy-transparent);
    border-radius: 0;
    transition-duration: var(--toy-motion-fast);
    transition-property: background-color, border-color;
}

.unit-card__select:hover {
    background-color: var(--toy-surface-hover);
}

.unit-card__select:focus {
    background-color: var(--toy-surface-hover);
    border-color: var(--toy-focus);
}

.unit-card--ability .unit-card__select {
    background-color: var(--toy-primary-tint);
}

.unit-card--ability .unit-card__select:hover {
    background-color: var(--toy-primary-wash);
}

.unit-card--ability .unit-card__select:focus {
    background-color: var(--toy-primary-wash);
    border-color: var(--toy-focus);
}

.unit-card__ability-vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-image: url("project://database/Assets/UI/Shared/Icons/ability-flare.svg");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--toy-primary);
    transition-duration: 0.14s;
    transition-property: opacity;
}

/* A warm cast behind the card, not a graphic on top of it. At the old 0.42 the flare
   painted opaque brown shapes across the label; even at 0.13 its peak was still a
   solid brown. The amber border and label carry the state, so this only needs to
   warm the surface. */
.unit-card--ability .unit-card__ability-vignette {
    opacity: 0.06;
}

.unit-card__portrait {
    position: relative;
    width: 78px;
    min-width: 78px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: var(--toy-warm);
    border-right-width: var(--toy-stroke-thin);
    border-right-color: var(--toy-edge);
}

.unit-card__copy {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
    padding: 8px 12px;
}

/* Shared skeleton. The two strips are different components wearing one template,
   so each sets its own size where it needs to differ. */
.unit-card__name {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    color: var(--toy-text);
    letter-spacing: var(--toy-track-label);
    white-space: nowrap;
    overflow: hidden;
}

.unit-card__health {
    min-height: 14px;
    margin-top: 5px;
    flex-direction: row;
    align-items: center;
}

.unit-card__health-track {
    position: relative;
    flex-grow: 1;
    height: 9px;
    margin-right: 9px;
    overflow: hidden;
    background-color: var(--toy-inset);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-radius: 0;
}

/* The fill was danger red at every level on both teams, so its colour repeated
   what its width already said. UnitCardElement drives these three from the
   thresholds in TeamPalette, which the world-space bar over the unit reads too
   — the two bars show one number and used to disagree about its colour. */
.unit-card__health-fill {
    width: 0%;
    height: 100%;
    background-color: var(--toy-health-high);
    transition-duration: var(--toy-motion-fast);
    transition-property: background-color;
}

.unit-card__health-fill--high {
    background-color: var(--toy-health-high);
}

.unit-card__health-fill--warning {
    background-color: var(--toy-health-warning);
}

.unit-card__health-fill--critical {
    background-color: var(--toy-health-critical);
}

/* Drawn over the fill rather than under it, so the chunks survive at every
   length instead of disappearing as the bar empties. */
.unit-card__health-ticks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Shared/Textures/HealthTicks.png");
    background-repeat: repeat;
    background-size: 14px 8px;
}

.unit-card__health-value {
    min-width: 78px;
    font-size: 14px;
    color: var(--toy-text);
    -unity-text-align: middle-right;
}

.unit-card__ability {
    color: var(--toy-text-copy);
    white-space: normal;
}

/* === ABILITY CARDS ===

   The dock is five ability buttons, not a second roster.

   A unit's health, its position and its cooldown are all readable on the board
   itself: the bar above it, the square under it, and the charge dial cut into
   its base plate. What the board cannot take is the one order that is not a
   place — spend this unit's round on its ability instead of on movement — so
   that is the only thing these cards are for, and the ability is the headline
   with the unit as the kicker above it. That is the exact inverse of the contact
   cards along the top edge, which is what stops the two strips reading as one
   component printed at two sizes. */

/* Both lines hang off one left edge. Centred, they sat on two different widths
   and the kicker floated above the name aligned to nothing; the portrait is
   already a hard left edge, so the type may as well use it. Inherited by both
   labels, and set here because the card's button ancestor centres its text. */
.unit-card--friendly .unit-card__copy {
    -unity-text-align: middle-left;
}

/* Whose. The portrait beside it has already answered this, so the line only
   confirms it. De-emphasis is carried by size and tracking rather than by
   value: the muted step lands at 4.5:1 on a card, which is not a quiet label at
   eleven pixels, it is a squint. Held clear of the state mark on its right. */
.unit-card--friendly .unit-card__name {
    padding-right: 76px;
    font-size: 11px;
    color: var(--toy-text-copy);
}

/* What pressing the card orders, and the only word on it a player should have
   to hunt for. The display face, because this is chrome rather than prose. */
.unit-card--friendly .unit-card__ability {
    margin-top: 2px;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 19px;
    color: var(--toy-text);
    letter-spacing: var(--toy-track-label);
    white-space: nowrap;
    overflow: hidden;
}

/* Recharging, so the name is a fact about the unit rather than an offer. Kept a
   real step above muted: the count in the disc is what says unavailable, and it
   says it without relying on the colour. */
.unit-card--friendly.unit-card--ability-cooldown .unit-card__ability {
    color: var(--toy-text-copy);
}

/* Ordered. */
.unit-card--friendly.unit-card--ability .unit-card__ability {
    color: var(--toy-primary-copy);
}

/* A dead unit's card keeps its place so the dock does not reflow mid-round, and
   says so with a mark laid over the copy rather than a line stacked under it: a
   card sized for two lines cannot grow a third, and the one that tried was
   clipped top and bottom. Same treatment the contact strip already gives the
   same fact. */
.unit-card--friendly .unit-card__state {
    position: absolute;
    top: 0;
    right: 0;
    min-height: 13px;
    margin-top: 0;
    font-size: 11px;
}

.unit-card__state {
    min-height: 0;
    margin-top: 4px;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 13px;
    color: var(--toy-danger-copy);
    letter-spacing: var(--toy-track-label);
}

/* The ability slot is a disc, because every ability in every game of this shape
   is a disc: round frame, and a number over it while it recharges.

   It sits in the row rather than pinned over a corner of the card, so the card
   reads left to right as portrait, name, charge, and nothing has to reserve
   space for anything. Only the dock ever draws it — the contact strip hides its
   own — so its states below are written unscoped. */
.unit-card__flip-indicator {
    flex-shrink: 0;
    align-self: center;
    width: 38px;
    height: 38px;
    margin-right: 12px;
    align-items: center;
    justify-content: center;
    background-color: var(--toy-inset);
    border-width: 2px;
    border-color: var(--toy-edge-strong);
    border-radius: 50%;
    transition-duration: 0.14s;
    transition-property: border-color, background-color;
}

/* The flip glyph went with the mechanic that named it: a card with one face is
   not turned over, it is pressed. Its node stays on as the charged pip, which is
   what the disc shows when it has no count to show instead. */
.unit-card__flip-icon {
    position: absolute;
    width: 9px;
    height: 9px;
    background-color: var(--toy-text-copy);
    border-radius: 50%;
}

.unit-card__cooldown {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: 17px;
    -unity-text-align: middle-center;
    color: var(--toy-text);
}

.unit-card__select:hover .unit-card__flip-indicator {
    border-color: var(--toy-text-copy);
}

/* Ordered. The disc is the only place the accent is spent at full strength and
   only ever on the cards whose round is already committed, which is what keeps
   it meaning "this is the action" rather than "this is a card". */
.unit-card--ability .unit-card__flip-indicator {
    background-color: var(--toy-primary);
    border-color: var(--toy-primary-hover);
}

.unit-card--ability .unit-card__flip-icon {
    background-color: var(--toy-text-on-accent);
}

/* Recharging. The pip gives way to the rounds still to come, the same number the
   dial on the unit's own base plate is working through, so the count is legible
   without the colour and the two surfaces never disagree. */
.unit-card__flip-indicator--cooldown {
    background-color: var(--toy-inset);
    border-color: var(--toy-divider);
}

.unit-card__flip-indicator--cooldown .unit-card__flip-icon {
    display: none;
}

.unit-card__flip-indicator--cooldown .unit-card__cooldown {
    color: var(--toy-text-muted);
}

/* A dead unit has no round to spend, so its card drops the disc rather than
   dimming it. Faded, a charged pip still reads as an ability sitting ready, and
   the one thing this card must not say is "press me". */
.unit-card--disabled .unit-card__flip-indicator {
    display: none;
}

/* === ENEMY CONTACT CARDS === */

/* The enemy strip's whole identity is its leading rule, so it carries the team
   red the enemy units on the board are painted with, not the destructive-action
   red. */
.unit-card--enemy {
    min-height: 72px;
    background-color: var(--toy-surface-quiet);
    border-color: var(--toy-edge);
    border-left-color: var(--toy-team-enemy);
}

/* On a dark card "stronger" means brighter, so the active enemy ring steps up to
   the light copy red rather than down to the deep one. */
.unit-card--enemy-active {
    border-color: var(--toy-team-enemy-copy);
    border-left-color: var(--toy-team-enemy-copy);
}

.unit-card--enemy-eliminated {
    background-color: var(--toy-disabled-surface);
    border-color: var(--toy-disabled-border);
    border-left-color: var(--toy-text-muted);
}

.unit-card--enemy .unit-card__select {
    min-width: 0;
    background-color: var(--toy-transparent);
    border-width: 0;
    opacity: 1;
}

.unit-card--enemy .unit-card__select:disabled {
    background-color: var(--toy-transparent);
    opacity: 1;
}

.unit-card--enemy .unit-card__portrait {
    width: 52px;
    min-width: 52px;
    background-color: var(--toy-warm);
}

.unit-card--enemy .unit-card__copy {
    position: relative;
    justify-content: center;
    padding: 6px 9px;
}

.unit-card--enemy .unit-card__name {
    padding-right: 84px;
    font-size: 14px;
    white-space: nowrap;
}

.unit-card--enemy .unit-card__health-track {
    height: 7px;
}

.unit-card--enemy .unit-card__ability {
    margin-top: 3px;
    font-size: 12px;
    white-space: normal;
}

.unit-card--enemy .unit-card__state {
    position: absolute;
    top: 0;
    right: 0;
    min-height: 13px;
    margin-top: 0;
    font-size: 12px;
    color: var(--toy-danger-copy);
}

.unit-card--enemy-eliminated .unit-card__name,
.unit-card--enemy-eliminated .unit-card__ability,
.unit-card--enemy-eliminated .unit-card__health-value {
    color: var(--toy-text-muted);
}

.unit-card--enemy-eliminated .unit-card__health-fill {
    background-color: var(--toy-text-muted);
}

.unit-card--enemy-eliminated .unit-card__state {
    color: var(--toy-text-muted);
}

.unit-card--enemy .unit-card__flip-indicator,
.unit-card--enemy .unit-card__ability-vignette {
    display: none;
}

/* === OVERLAYS === */

.deployment-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--toy-space-xl);
    background-color: var(--toy-ground);
}

.toybox-ui.deployment-overlay .deployment-overlay__content {
    width: 640px;
    max-width: 92%;
    align-items: center;
    padding: var(--toy-space-xl);
    border-top-width: var(--toy-accent-rule);
    border-top-color: var(--toy-primary);
}

.deployment-overlay__mark {
    width: 120px;
    height: 4px;
    margin-bottom: var(--toy-space-lg);
    background-color: var(--toy-primary);
}

.deployment-overlay__title {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCapsObl-Regular UI SDF.asset");
    font-size: var(--toy-type-display);
    -unity-text-align: middle-center;
    color: var(--toy-text);
    letter-spacing: var(--toy-track-display);
}

.deployment-overlay__status {
    margin-top: var(--toy-space-md);
    font-size: var(--toy-type-body);
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--toy-text-muted);
}

.results-overlay {
    background-color: var(--toy-scrim);
}

.controls-overlay {
    background-color: var(--toy-scrim);
}

.settings-overlay {
    background-color: var(--toy-scrim);
}

/* Shorter than the controls sheet, so the phase banner above and the dock below stay readable
   behind it. The round does not stop for this panel and the player may be watching the timer while
   they reach for a level. */
.toybox-ui.settings-overlay .settings-panel {
    max-height: 62%;
    align-items: stretch;
}

.settings-live-note {
    margin-top: var(--toy-space-md);
    font-size: var(--toy-type-caption);
    white-space: normal;
}

/* The verdict is not a dialog, and it is not a centre-slam either.
 
   Boxing it turned the loudest beat in the game into a notification, so the
   panel gives up its plate, its border and its accent rule. But a huge
   exclamation dropped dead-centre over a dimmed match is one specific game's
   signature, and landing on it is imitation rather than influence. So the
   debrief is anchored to the left margin instead — the same command-rail idiom
   the title and character screens are built on — and reads as a block: eyebrow,
   rule, verdict, then the two things you can do about it. */
.results-overlay {
    align-items: flex-start;
    justify-content: center;
    padding-left: 104px;
    padding-right: var(--toy-space-xl);
}

.toybox-ui.results-overlay .results-panel {
    width: 900px;
    max-width: 88%;
    max-height: 88%;
    padding: 0;
    align-items: flex-start;
    justify-content: center;
    background-color: var(--toy-transparent);
    border-width: 0;
}

.toybox-ui.results-overlay .results-panel:focus {
    border-width: 0;
}

/* Capped in pixels, not per cent. The panel is content-sized now, so a
   percentage cap resolves against a height the content itself is setting: the
   view ends up shorter than what it holds and grows a scrollbar around three
   lines of text. */
.results-scroll {
    min-height: 0;
    max-height: 560px;
    width: 100%;
}

.results-scroll .unity-scroll-view__content-container {
    align-items: flex-start;
    padding-right: var(--toy-space-md);
}

.toybox-ui.results-overlay .section-label {
    align-self: flex-start;
    color: var(--toy-text-muted);
}

.results-mark {
    width: 260px;
    height: 3px;
    margin-top: var(--toy-space-md);
    margin-bottom: var(--toy-space-md);
    background-color: var(--toy-primary);
}

/* The verdict is the only thing anyone reads on this panel, so it gets the size
   a scoreboard gives it and nothing else on the sheet competes. */
/* Big enough to be the moment, not so big it is doing an impression of one.
   The verdict here is a sentence — "You win!", "Draw — both crews eliminated."
   — so it has to survive wrapping, which a single screen-filling word does not
   have to worry about. */
.results-status {
    margin-bottom: var(--toy-space-md);
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCapsObl-Regular UI SDF.asset");
    font-size: 58px;
    color: var(--toy-text-copy);
    letter-spacing: 3px;
    -unity-text-align: middle-left;
    text-shadow: 0 4px 16px var(--toy-shadow-stage);
    white-space: normal;
}

.results-status--victory {
    color: var(--toy-text);
}

.results-status--defeat {
    color: var(--toy-defeat);
}

.results-actions {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-start;
    margin-top: var(--toy-space-lg);
}

.results-button {
    min-width: 220px;
    min-height: 58px;
    margin-left: 0;
    margin-right: var(--toy-space-md);
    justify-content: center;
    font-size: var(--toy-type-title);
}

/* === BATTLE REPORT REVEAL === */

.report-empty {
    margin-top: var(--toy-space-sm);
    font-size: var(--toy-type-body);
    color: var(--toy-text-muted);
    white-space: normal;
}

.report-reveal {
    margin-top: var(--toy-space-sm);
}

.report-stepper {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--toy-space-sm);
    margin-bottom: var(--toy-space-sm);
}

.report-step-button {
    min-width: 124px;
    justify-content: center;
}

.report-round-label {
    flex-grow: 1;
    font-size: var(--toy-type-body-lg);
    -unity-text-align: middle-center;
    color: var(--toy-text);
}

/* Board and order list sit side by side so the panel spends its width instead of its height; the
   whole reveal has to fit without the board being cut in half by the scroll view. */
.report-body {
    flex-direction: row;
    align-items: flex-start;
}

.report-board-column {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--toy-space-md);
}

/* The painter letterboxes a 15:10 board inside whatever box it is given, so the height here only
   has to be close; it decides how much of the panel the picture is allowed to claim. */
.report-board {
    height: 306px;
    background-color: var(--toy-ground);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-radius: var(--toy-radius-md);
}

/* The team fills mirror TeamPalette and cannot move, and the red one only just
   carries white — so the numeral takes the fixed ink rather than --toy-text,
   which is a shade off white here and drops the enemy badge to 4.0:1. */
.report-board__badge {
    position: absolute;
    -unity-text-align: middle-center;
    color: var(--toy-text-on-team);
    background-color: var(--toy-team-friendly-deep);
    border-radius: 50%;
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-ground);
}

.report-board__badge--enemy {
    background-color: var(--toy-team-enemy-deep);
}

/* Above the board rather than below it: this is the sentence that answers "what just happened",
   and under a 300px board it lands past the fold of the scroll view. */
.report-summary {
    min-height: 20px;
    margin-bottom: var(--toy-space-sm);
    font-size: var(--toy-type-body);
    color: var(--toy-text-copy);
    white-space: normal;
}

.report-legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--toy-space-sm);
    margin-bottom: var(--toy-space-sm);
}

.report-legend__item {
    flex-direction: row;
    align-items: center;
    margin-right: var(--toy-space-md);
}

.report-legend__glyph {
    width: 14px;
    height: 14px;
    margin-right: var(--toy-space-xs);
    background-color: var(--toy-text-muted);
}

.report-legend__glyph--start {
    border-radius: 50%;
}

.report-legend__glyph--end {
    border-radius: 0;
}

/* Dashed strokes are the board's mark for "this was not the plan"; the swatch has to say the same
   thing, and a two-pixel dashed rule is the closest USS gets to the painted line. */
.report-legend__glyph--dodge {
    height: 0;
    background-color: var(--toy-transparent);
    border-top-width: 2px;
    border-top-color: var(--toy-text-muted);
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    opacity: 0.7;
}

.report-legend__glyph--ability {
    background-color: var(--toy-transparent);
    border-width: 2px;
    border-color: var(--toy-primary);
    border-radius: 50%;
}

.report-legend__glyph--dead {
    background-color: var(--toy-transparent);
    font-size: var(--toy-type-body);
    -unity-text-align: middle-center;
    color: var(--toy-danger-copy);
}

.report-legend__label {
    font-size: var(--toy-type-caption);
    color: var(--toy-text-muted);
}

/* Wide enough that "Moved 3 cells to (12, 4)" and an HP readout both fit on one row; below this the
   order text clips mid-coordinate, which reads as a rendering bug rather than a truncation. */
.report-orders {
    width: 368px;
    flex-shrink: 0;
    overflow: hidden;
}

.report-order-row {
    flex-direction: row;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
}

.report-order-row__badge {
    width: 20px;
    height: 20px;
    margin-right: var(--toy-space-sm);
    -unity-text-align: middle-center;
    font-size: var(--toy-type-caption);
    color: var(--toy-text-on-team);
    background-color: var(--toy-team-friendly-deep);
    border-radius: 50%;
}

.report-order-row--enemy .report-order-row__badge {
    background-color: var(--toy-team-enemy-deep);
}

.report-order-row__name {
    width: 92px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-label);
    color: var(--toy-team-friendly-copy);
    letter-spacing: var(--toy-track-label);
    overflow: hidden;
}

.report-order-row--enemy .report-order-row__name {
    color: var(--toy-team-enemy-copy);
}

/* The order text is the only part allowed to give up room; letting it grow unbounded pushed the
   whole column past the panel and produced a horizontal scrollbar. */
.report-order-row__order {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: var(--toy-type-label);
    color: var(--toy-text-copy);
    overflow: hidden;
}

.report-order-row__state {
    flex-shrink: 0;
    margin-left: var(--toy-space-xs);
    font-size: var(--toy-type-caption);
    color: var(--toy-text-muted);
}

.report-order-row--dead .report-order-row__order,
.report-order-row--dead .report-order-row__state {
    color: var(--toy-danger-copy);
}

.report-order-row--gone .report-order-row__name,
.report-order-row--gone .report-order-row__order,
.report-order-row--gone .report-order-row__state {
    color: var(--toy-text-muted);
}

.report-team-heading {
    margin-top: var(--toy-space-sm);
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-caption);
    color: var(--toy-text-muted);
    letter-spacing: var(--toy-track-label);
}

/* === BREAKPOINTS === */

/* Below this the board and the order list would each be too narrow to read, so the reveal becomes
   one column and the panel scrolls instead. */
.narrow .report-body,
.phone .report-body {
    flex-direction: column;
}

.narrow .report-board-column,
.phone .report-board-column {
    width: 100%;
    margin-right: 0;
}

.narrow .report-orders,
.phone .report-orders {
    width: 100%;
}

.phone .report-board,
.short .report-board {
    height: 220px;
}

.phone .report-order-row__name {
    width: 100px;
}

/* The dock reserves camera space rather than floating over the board, so it stays flush to the
   screen edges at every breakpoint; the camera does not paint the band behind it, and insetting it
   would leave that margin unpainted. */
.compact .hud-dock {
    padding-left: 12px;
    padding-right: 12px;
}

.compact .unit-card-host {
    width: 0;
    min-width: 240px;
    max-width: 300px;
}

.compact .enemy-unit-card-host {
    min-width: 210px;
    max-width: 280px;
}

.compact .unit-card__select {
    flex-grow: 1;
    width: 100%;
    min-width: 0;
}

.compact .unit-card__portrait {
    width: 48px;
    min-width: 48px;
}

.compact .unit-card__copy {
    padding: 6px 42px 6px 9px;
}

.compact .unit-card__name {
    font-size: 15px;
}

.compact .unit-card__ability {
    font-size: 10px;
}

.compact .unit-card__state {
    font-size: 10px;
}

.compact .unit-card--enemy .unit-card__name {
    padding-right: 78px;
}

.compact .unit-card--enemy .unit-card__state,
.compact .unit-card--enemy .unit-card__health-value {
    font-size: 11px;
}

/* The sizes above were written when both strips shared one hierarchy. An ability
   card inverts it, so it restates its own here rather than inheriting a 15px
   kicker over a 10px headline. The copy also stops reserving a column for the
   disc, which now sits in the row beside it. */
.compact .unit-card--friendly .unit-card__copy {
    padding: 6px 9px;
}

.compact .unit-card--friendly .unit-card__name {
    padding-right: 68px;
    font-size: 11px;
}

.compact .unit-card--friendly .unit-card__ability {
    font-size: 17px;
}

.compact .unit-card__flip-indicator {
    width: 34px;
    height: 34px;
    margin-right: 9px;
}

.compact .unit-card__flip-icon {
    width: 18px;
    height: 18px;
}

.compact .unit-card__cooldown {
    font-size: 15px;
}

.narrow .unit-card-host {
    width: 220px;
    min-width: 220px;
    max-width: 220px;
}

.narrow .enemy-unit-card-host {
    width: 210px;
    min-width: 210px;
}

.narrow .unit-card__portrait {
    display: none;
}

.narrow .unit-card__select {
    min-width: 0;
}

.narrow .escort-alert__copy {
    font-size: 56px;
}

.narrow .hill-status-readout {
    width: 244px;
}

.narrow .rejoin-notice {
    width: 244px;
}

.phone .hud-dock {
    padding-left: 10px;
    padding-right: 10px;
}

.phone .enemy-status-strip {
    padding-left: 10px;
    padding-right: 10px;
}

.phone .hud-top {
    left: 10px;
    right: 10px;
}

.phone .hud-dock__row {
    flex-direction: column;
    align-items: stretch;
}

.phone .unit-cards {
    flex-grow: 1;
    height: auto;
}

.phone .hud-header-actions {
    width: 100%;
    margin-left: 0;
    margin-top: 6px;
    justify-content: flex-end;
}

.phone .planning-commit {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 6px;
    padding-left: 8px;
}

.phone .planning-commit__status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 6px;
    font-size: 10px;
}

.phone .planning-commit__button {
    min-width: 92px;
    padding-left: 10px;
    padding-right: 10px;
}

.phone .hud-exit-button,
.phone .hud-controls-button,
.phone .hud-settings-button {
    min-height: 44px;
    padding-left: 8px;
    padding-right: 8px;
}

.phone .unit-card-host {
    width: 184px;
    min-width: 184px;
    max-width: 184px;
    margin-right: 6px;
}

.phone .unit-card-host--last {
    margin-right: 0;
}

.phone .unit-card {
    min-height: 92px;
}

.phone .unit-card__select {
    width: 100%;
    min-width: 0;
    min-height: 84px;
}

.phone .unit-card__copy {
    padding: 8px 42px 8px 9px;
}

.phone .unit-card__name {
    font-size: 15px;
}

.phone .unit-card__ability {
    font-size: 11px;
}

.phone .unit-card--friendly .unit-card__copy {
    padding: 8px 9px;
}

.phone .unit-card--friendly .unit-card__name {
    padding-right: 68px;
    font-size: 11px;
}

.phone .unit-card--friendly .unit-card__ability {
    font-size: 17px;
}

.phone .enemy-unit-cards {
    flex-grow: 0;
    height: 78px;
}

.phone .enemy-unit-card-host {
    width: 210px;
    min-width: 210px;
}

.phone .unit-card--enemy {
    min-height: 72px;
    flex-direction: row;
}

.phone .unit-card--enemy .unit-card__select {
    width: 100%;
    min-height: 0;
}

.phone .unit-card--enemy .unit-card__copy {
    padding: 5px 8px;
}

.phone .unit-card--enemy .unit-card__name {
    padding-right: 78px;
    font-size: 14px;
}

.phone .unit-card--enemy .unit-card__ability,
.phone .unit-card--enemy .unit-card__state,
.phone .unit-card--enemy .unit-card__health-value {
    font-size: 10px;
}

.phone .phase-notch .phase-label {
    font-size: 16px;
}

.phone .phase-notch .timer-label {
    margin-left: 12px;
    font-size: 22px;
}

.phone .escort-alert__copy {
    font-size: 34px;
}

.phone .hill-status-readout {
    top: 0;
    left: auto;
    right: 0;
    width: 210px;
    min-height: 62px;
    padding: 7px 10px 9px 10px;
    flex-direction: column;
    align-items: stretch;
}

.phone .hill-status-readout__key {
    display: none;
}

.phone .hill-status-readout__value {
    align-self: stretch;
}

/* Kept opposite the hill readout at every breakpoint: on a phone both can be up at once, and the
   one that says the match is paused must not be the one that gets covered. */
.phone .rejoin-notice {
    top: 0;
    left: 0;
    right: auto;
    width: 210px;
    min-height: 62px;
    padding: 7px 10px 9px 10px;
    flex-direction: column;
    align-items: stretch;
}

.phone .rejoin-notice__key {
    display: none;
}

.phone .rejoin-notice__value {
    align-self: stretch;
}

.phone .deployment-overlay {
    padding: var(--toy-space-panel-compact);
}

.phone .deployment-overlay__title {
    font-size: 28px;
}

.phone .results-status {
    font-size: 52px;
    letter-spacing: 2px;
}

.phone .results-overlay {
    padding-left: var(--toy-space-lg);
}

.phone .results-actions {
    flex-direction: column;
}

.phone .results-button {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    margin-top: var(--toy-space-sm);
}

.short .hud-dock {
    min-height: 0;
    padding-top: 8px;
    padding-bottom: 8px;
}

.short .target-feedback {
    min-height: 26px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.short .hud-exit-button,
.short .hud-controls-button,
.short .hud-settings-button {
    min-height: 44px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* The ability cards' own height is already the floor a short viewport wants, so
   there is nothing left here to take off them. */
.short .enemy-unit-card-host,
.short .unit-card--enemy {
    min-height: 72px;
}

.short .phase-notch .phase-label {
    font-size: 17px;
}

.short .phase-notch .timer-label {
    font-size: 24px;
}

.short .results-status {
    font-size: 68px;
    letter-spacing: 3px;
}

.phone.short .hud-exit-button,
.phone.short .hud-controls-button,
.phone.short .hud-settings-button {
    min-height: 44px;
    padding-top: 7px;
    padding-bottom: 7px;
}

.short .escort-alert {
    top: 20%;
}

.phone.short .hill-status-readout {
    left: auto;
    right: 0;
    top: 0;
    width: 56%;
    min-height: 54px;
    padding: 6px 10px 8px 10px;
}

.phone.short .rejoin-notice {
    left: 0;
    right: auto;
    top: 0;
    width: 42%;
    min-height: 54px;
    padding: 6px 10px 8px 10px;
}
