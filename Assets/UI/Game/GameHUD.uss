/* Match HUD — five floating widget clusters anchored to the screen edges
   (ArtDirection §5.5, "Game HUD"). The two full-bleed bars are retired: .enemy-status-strip
   and .hud-dock are now transparent positioning frames that pick nothing, and
   every fill lives on the widget inside them.

   ⚠ Game.unity's camera viewport rect must be full-screen (x 0, y 0, w 1, h 1).
   It was tuned to reserve a band for the retired top bar; leaving it at
   y 0.112 / height 0.83 letterboxes the board inside the new layout. */

.game-screen {
    background-color: var(--bp-transparent);
}

.hud-flash {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-color: var(--bp-transparent);
    transition-property: opacity;
    transition-duration: var(--bp-t-flash-out);
    transition-timing-function: var(--bp-ease-out);
}

/* The tint is an opaque token and the beat's strength is the element opacity,
   because var() cannot be nested inside an alpha colour. */
.hud-flash--friendly {
    background-color: var(--bp-blue);
}

.hud-flash--enemy {
    background-color: var(--bp-red);
}

.hud-flash--neutral {
    background-color: var(--bp-text);
}

.hud-flash--active {
    opacity: 0.07;
    transition-duration: var(--bp-t-flash-in);
}

.hud-flash--active.hud-flash--friendly {
    opacity: 0.1;
}

.hud-flash--active.hud-flash--enemy {
    opacity: 0.12;
}

.hud-flash--active.hud-flash--neutral {
    opacity: 0.07;
}

/* --- Top clusters ------------------------------------------------------------ */

.enemy-status-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 140px;
    background-color: var(--bp-transparent);
}

.enemy-unit-cards {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--bp-s4);
    height: 64px;
    flex-grow: 0;
}

.enemy-unit-cards .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
}

/* The hill readout floats over the right end of this same band, so King of the
   Hill keeps the row packed left where it clears the readout at full card width. */
.koth .enemy-unit-cards .unity-scroll-view__content-container {
    justify-content: flex-start;
    padding-left: var(--bp-s4);
}

.hud-top {
    position: absolute;
    left: var(--bp-s4);
    right: var(--bp-s4);
    top: var(--bp-s4);
    height: 62px;
}

.hud-top .hill-status-readout {
    position: absolute;
    top: 0;
    right: 0;
    width: 220px;
    height: 62px;
    padding: 6px var(--bp-s3);
    justify-content: center;
    background-color: var(--bp-panel);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-deck-4);
    border-radius: var(--bp-r-md);
    transition-property: border-color;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.hud-top .hill-status-readout__key {
    font-size: var(--bp-type-label);
    -unity-font-style: bold;
    color: var(--bp-text-3);
    letter-spacing: 0.6px;
}

.hud-top .hill-status-readout__value {
    margin-top: 2px;
    font-size: var(--bp-type-body);
    -unity-font-style: bold;
    color: var(--bp-text);
}

.hud-top .hill-status--blue {
    border-left-color: var(--bp-blue);
}

.hud-top .hill-status--red {
    border-left-color: var(--bp-red);
}

.hud-top .hill-status--contested {
    border-left-color: var(--bp-amber);
}

/* Three pips restate the streak graphically; the value string still carries it. */
.hill-streak {
    flex-direction: row;
    margin-top: 6px;
}

.hill-pip {
    width: 18px;
    height: 4px;
    margin-right: var(--bp-s1);
    background-color: var(--bp-deck-3);
    border-radius: var(--bp-r-sm);
    transition-property: background-color;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.hill-pip--last {
    margin-right: 0;
}

.hill-status--blue .hill-pip--filled {
    background-color: var(--bp-blue);
}

.hill-status--red .hill-pip--filled {
    background-color: var(--bp-red);
}

.hill-status--contested .hill-pip--filled {
    background-color: var(--bp-amber);
}

/* --- Phase readout -------------------------------------------------------------- */

.phase-notch {
    position: absolute;
    left: 0;
    right: 0;
    top: 92px;
    height: 34px;
    flex-direction: row;
    justify-content: center;
}

.phase-notch .phase-cluster {
    height: 34px;
    flex-direction: row;
    align-items: center;
    padding: 0 18px;
    background-color: var(--bp-panel);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
}

.phase-notch .phase-cluster__mark {
    width: 4px;
    height: 16px;
    margin-right: var(--bp-s3);
    background-color: var(--bp-text-3);
    border-radius: 1px;
    transition-property: background-color;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.phase-notch .phase-cluster__mark--friendly {
    background-color: var(--bp-amber);
}

.phase-notch .phase-cluster__mark--enemy {
    background-color: var(--bp-red);
}

.phase-notch .phase-cluster__mark--neutral {
    background-color: var(--bp-text-2);
}

/* The mark carries the phase state, so the longest strings stay maximally
   legible and the text colour never moves. */
.phase-notch .phase-label,
.phase-notch .phase-label--friendly,
.phase-notch .phase-label--enemy,
.phase-notch .phase-label--neutral {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-SemiBold UI SDF.asset");
    font-size: var(--bp-type-subtitle);
    color: var(--bp-text);
    letter-spacing: 1px;
}

.phase-notch .timer-label {
    margin-left: var(--bp-s4);
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    font-size: var(--bp-type-num-lg);
    -unity-font-style: bold;
    color: var(--bp-text);
    letter-spacing: 1px;
    transition-property: color;
    transition-duration: var(--bp-t-fast);
    transition-timing-function: linear;
}

.phase-notch .timer-label--urgent {
    color: var(--bp-amber);
}

/* --- Bottom clusters ---------------------------------------------------------------- */

.hud-dock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 168px;
    background-color: var(--bp-transparent);
}

.hud-dock__row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--bp-s4);
    flex-direction: row;
    align-items: flex-end;
    padding: 0 var(--bp-s4);
}

.target-feedback {
    position: absolute;
    left: var(--bp-s4);
    bottom: 124px;
    max-width: 560px;
    min-height: 20px;
    margin-top: 0;
}

.target-feedback--visible {
    opacity: 1;
}

.target-feedback--success {
    padding: 6px var(--bp-s3);
    background-color: var(--bp-green-surface);
    color: var(--bp-green-hi);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-green);
    border-radius: var(--bp-r-sm);
}

.target-feedback--error {
    padding: 6px var(--bp-s3);
    background-color: var(--bp-red-surface);
    color: var(--bp-red-hi);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-red);
    border-radius: var(--bp-r-sm);
}

.hud-header-actions {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-left: var(--bp-s4);
}

/* --- Commit control -------------------------------------------------------------------- */

.planning-commit {
    min-height: var(--bp-target);
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-right: var(--bp-s2);
    padding-left: var(--bp-s3);
    background-color: var(--bp-dock);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-amber);
    border-radius: var(--bp-r-md);
    transition-property: border-color;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-snap);
}

.planning-commit__status {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-ExtraBold UI SDF.asset");
    min-width: 78px;
    flex-shrink: 0;
    margin-right: var(--bp-s2);
    font-size: 11px;
    color: var(--bp-amber);
    letter-spacing: 1.8px;
    white-space: nowrap;
}

.toybox-ui .planning-commit__button {
    width: 132px;
    min-width: 132px;
    min-height: var(--bp-target);
    flex-shrink: 0;
    padding: 0 var(--bp-s3);
}

.planning-commit--ready {
    border-left-color: var(--bp-amber);
}

.planning-commit--ready .planning-commit__status {
    color: var(--bp-amber);
}

.planning-commit--sending,
.planning-commit--unlocking {
    border-left-color: var(--bp-text-3);
}

.planning-commit--sending .planning-commit__status,
.planning-commit--unlocking .planning-commit__status {
    color: var(--bp-text-2);
}

.planning-commit--waiting {
    border-left-color: var(--bp-blue);
}

.planning-commit--waiting .planning-commit__status {
    color: var(--bp-blue);
}

.planning-commit--locked {
    border-left-color: var(--bp-green);
}

.planning-commit--locked .planning-commit__status {
    color: var(--bp-green);
}

/* A ghost control everywhere else, but this one sits over the live board, so it
   takes an opaque dock fill rather than putting text on the deck. */
.toybox-ui .hud-controls-button {
    min-height: var(--bp-target);
    flex-shrink: 0;
    padding: 0 var(--bp-s3);
    background-color: var(--bp-dock);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
}

/* --bp-dock is --bp-deck-2 at 0.97, so this ladder starts one rung lower than a plain
   button's and runs deck-3 then deck-4. Hovering to deck-2 would be a no-op. */
.toybox-ui .hud-controls-button:hover {
    background-color: var(--bp-deck-3);
    border-color: var(--bp-line-3);
}

.toybox-ui .hud-controls-button:active {
    background-color: var(--bp-deck-4);
    border-color: var(--bp-line-2);
}

.toybox-ui .hud-controls-button:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

/* Dim via surface and text, never opacity: this control floats over the live board and
   fading it would let the board read through the fill. */
.toybox-ui .hud-controls-button:disabled {
    opacity: 1;
    background-color: var(--bp-deck-1);
    border-color: var(--bp-line-1);
    color: var(--bp-text-3);
}

/* --- Card hosts ---------------------------------------------------------------------------- */

.unit-cards {
    flex-grow: 1;
    min-width: 0;
    height: 92px;
}

.unit-cards .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
}

.unit-card-host {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0;
    width: 0;
    min-width: 200px;
    max-width: 236px;
    height: 92px;
    margin-right: var(--bp-s2);
}

.unit-card-host--last {
    margin-right: 0;
}

.enemy-unit-card-host {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 200px;
    min-width: 176px;
    max-width: 260px;
    height: 64px;
    margin-right: var(--bp-s2);
}

.enemy-unit-card-host--last {
    margin-right: 0;
}

/* --- Unit card — player variant ---------------------------------------------------------------- */

.unit-card {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: row;
    overflow: hidden;
    background-color: var(--bp-panel);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-bottom-width: var(--bp-edge);
    border-bottom-color: var(--bp-edge-dark);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-deck-4);
    border-radius: var(--bp-r-md);
    transition-property: background-color, border-color;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.unit-card--selected {
    background-color: var(--bp-deck-3);
    border-color: var(--bp-blue-line);
    border-left-color: var(--bp-blue);
}

.unit-card--ability {
    background-color: var(--bp-amber-surface);
    border-color: var(--bp-amber-border);
    border-left-color: var(--bp-amber);
}

.unit-card--ability.unit-card--selected {
    border-color: var(--bp-amber);
    border-left-color: var(--bp-amber);
}

.unit-card--disabled {
    opacity: 1;
    background-color: var(--bp-deck-1);
    border-color: var(--bp-line-1);
    border-left-color: var(--bp-red-dim);
}

.unit-card__select {
    position: relative;
    flex-grow: 1;
    width: 100%;
    min-width: 0;
    padding: 0;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    overflow: hidden;
    background-color: var(--bp-transparent);
    border-width: 0;
    border-radius: 0;
    transition-property: background-color, translate;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.unit-card__select:hover {
    background-color: var(--bp-deck-2);
}

.unit-card__select:active {
    background-color: var(--bp-deck-3);
    translate: 0 1px;
}

/* The ring is an overlay rather than a border so focusing a card never nudges
   the portrait and copy by the ring's width. */
.unit-card__focus-ring {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-transparent);
    transition-property: border-color;
    transition-duration: var(--bp-t-instant);
    transition-timing-function: var(--bp-ease-out);
}

.unit-card__select:focus .unit-card__focus-ring {
    border-color: var(--bp-focus-light);
}

.unit-card--ability .unit-card__select:hover {
    background-color: var(--bp-amber-border);
}

.unit-card--disabled .unit-card__select:hover,
.unit-card--disabled .unit-card__select:active {
    background-color: var(--bp-transparent);
    translate: 0 0;
}

.unit-card__ability-vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-image: url("project://database/Assets/UI/Shared/Icons/ability-flare.svg");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--bp-amber);
    transition-property: opacity;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.unit-card--ability .unit-card__ability-vignette {
    opacity: 0.35;
}

.unit-card__portrait {
    position: relative;
    width: 64px;
    min-width: 64px;
    /* Two ramp steps below the card fill. Depth is not emphasis: the ramp inverted for
       FIELD DAY but a recess still has to sit darker than whatever contains it. */
    background-color: var(--bp-deck-2);
    border-right-width: var(--bp-bw-hair);
    border-right-color: var(--bp-line-1);
    -unity-background-scale-mode: scale-to-fit;
}

.unit-card__copy {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
    padding: var(--bp-s2) 36px var(--bp-s2) var(--bp-s3);
}

.unit-card__name {
    font-size: var(--bp-type-body);
    -unity-font-style: bold;
    color: var(--bp-text);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.unit-card__ability {
    margin-top: 3px;
    font-size: var(--bp-type-body-sm);
    color: var(--bp-text-2);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.unit-card--ability .unit-card__ability {
    -unity-font-style: bold;
    color: var(--bp-amber-hi);
}

.unit-card--ability-cooldown .unit-card__ability {
    color: var(--bp-text-3);
}

.unit-card__state {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-ExtraBold UI SDF.asset");
    min-height: 0;
    margin-top: 3px;
    font-size: var(--bp-type-micro);
    color: var(--bp-red-hi);
    letter-spacing: 1.5px;
}

.unit-card--disabled .unit-card__name,
.unit-card--disabled .unit-card__ability {
    color: var(--bp-text-3);
}

/* --- Flip indicator / cooldown badge ------------------------------------------------------------- */

.unit-card__flip-indicator {
    position: absolute;
    right: var(--bp-s2);
    bottom: 6px;
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
}

.unit-card__flip-icon {
    position: absolute;
    width: 20px;
    height: 20px;
    background-image: url("project://database/Assets/UI/Shared/Icons/flip-card.svg");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--bp-text-3);
    transition-property: opacity, -unity-background-image-tint-color;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.unit-card--selected .unit-card__flip-icon {
    -unity-background-image-tint-color: var(--bp-blue);
}

.unit-card--ability .unit-card__flip-icon {
    -unity-background-image-tint-color: var(--bp-amber);
}

.unit-card__cooldown {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--bp-text-2);
}

.unit-card__flip-indicator--cooldown,
.unit-card--selected .unit-card__flip-indicator--cooldown {
    background-color: var(--bp-deck-0);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-3);
    border-radius: var(--bp-r-md);
}

.unit-card__flip-indicator--cooldown .unit-card__flip-icon,
.unit-card--selected .unit-card__flip-indicator--cooldown .unit-card__flip-icon {
    opacity: 0.22;
    -unity-background-image-tint-color: var(--bp-text-3);
}

.unit-card--disabled .unit-card__flip-indicator {
    display: none;
}

/* --- Unit card — enemy variant --------------------------------------------------------------------- */

.unit-card--enemy {
    height: 100%;
    background-color: var(--bp-panel);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-bottom-width: var(--bp-bw-hair);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-deck-4);
}

.unit-card--enemy-active {
    border-left-color: var(--bp-red);
}

.unit-card--enemy-eliminated {
    background-color: var(--bp-deck-1);
    border-left-color: var(--bp-deck-4);
}

.unit-card--enemy .unit-card__select {
    min-width: 0;
    background-color: var(--bp-transparent);
    border-width: 0;
    opacity: 1;
}

.unit-card--enemy .unit-card__select:hover,
.unit-card--enemy .unit-card__select:disabled {
    background-color: var(--bp-transparent);
    translate: 0 0;
    opacity: 1;
}

.unit-card--enemy .unit-card__portrait {
    width: 44px;
    min-width: 44px;
    background-color: var(--bp-deck-2);
}

.unit-card--enemy .unit-card__copy {
    position: relative;
    justify-content: center;
    padding: var(--bp-s1) var(--bp-s2);
}

.unit-card--enemy .unit-card__name {
    padding-right: 78px;
    font-size: var(--bp-type-body-sm);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.unit-card--enemy .unit-card__health {
    min-height: 12px;
    margin-top: 3px;
    flex-direction: row;
    align-items: center;
}

.unit-card__health-track {
    flex-grow: 1;
    height: 4px;
    margin-right: var(--bp-s2);
    overflow: hidden;
    background-color: var(--bp-deck-3);
    border-radius: var(--bp-r-sm);
}

.unit-card__health-fill {
    width: 0;
    height: 100%;
    background-color: var(--bp-red);
    transition-property: width;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.unit-card__health-value {
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    min-width: 72px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--bp-text-2);
    -unity-text-align: middle-right;
    letter-spacing: 0.4px;
}

.unit-card--enemy .unit-card__ability {
    margin-top: 2px;
    font-size: 11px;
    color: var(--bp-text-2);
}

.unit-card--enemy .unit-card__state {
    position: absolute;
    top: 0;
    right: 0;
    min-height: 12px;
    margin-top: 0;
    color: var(--bp-text-3);
}

.unit-card--enemy-active .unit-card__state {
    color: var(--bp-red-hi);
}

.unit-card--enemy-eliminated .unit-card__name,
.unit-card--enemy-eliminated .unit-card__ability,
.unit-card--enemy-eliminated .unit-card__health-value,
.unit-card--enemy-eliminated .unit-card__state {
    color: var(--bp-text-3);
}

.unit-card--enemy-eliminated .unit-card__health-fill {
    background-color: var(--bp-red-dim);
}

.unit-card--enemy .unit-card__flip-indicator,
.unit-card--enemy .unit-card__ability-vignette {
    display: none;
}

/* --- Deployment ------------------------------------------------------------------------------------- */

.deployment-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--bp-s6);
    /* Drops the board to the tabletop while crews are placed. Copy on this bed steps down the
       deck ramp rather than using ink: Palette §7.3 bans ink on table at 2.33:1 and names
       --bp-deck-0 as the replacement. */
    background-color: var(--bp-table);
}

.toybox-ui.deployment-overlay .deployment-overlay__content {
    width: 620px;
    max-width: 92%;
    align-items: center;
}

.deployment-overlay__mark {
    width: 88px;
    height: 6px;
    margin-top: var(--bp-s2);
    margin-bottom: var(--bp-s5);
    flex-direction: row;
    align-items: center;
}

.deployment-overlay__title {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-SemiBold UI SDF.asset");
    font-size: var(--bp-type-display);
    -unity-text-align: middle-center;
    color: var(--bp-deck-0);
    letter-spacing: 0.5px;
}

.deployment-overlay__status {
    margin-top: var(--bp-s3);
    font-size: var(--bp-type-body);
    -unity-text-align: middle-center;
    color: var(--bp-deck-1);
    white-space: normal;
}

/* --- Results ------------------------------------------------------------------------------------------ */

.results-overlay {
    background-color: var(--bp-scrim);
}

.controls-overlay {
    background-color: var(--bp-scrim);
}

.toybox-ui.results-overlay .results-panel {
    width: 620px;
    align-items: stretch;
}

.results-scroll {
    min-height: 0;
    max-height: 320px;
}

.results-scroll .unity-scroll-view__content-container {
    padding-right: var(--bp-s3);
}

/* A 3px rule with a 6px square at its left end, both in the outcome colour. */
.results-mark {
    width: 88px;
    height: 6px;
    margin-top: var(--bp-s2);
    margin-bottom: var(--bp-s3);
    flex-direction: row;
    align-items: center;
}

.results-mark__cap {
    width: 6px;
    height: 6px;
    background-color: var(--bp-amber);
}

.results-mark__bar {
    flex-grow: 1;
    height: 3px;
    background-color: var(--bp-amber);
}

.results-mark--win .results-mark__cap,
.results-mark--win .results-mark__bar {
    background-color: var(--bp-green);
}

.results-mark--loss .results-mark__cap,
.results-mark--loss .results-mark__bar {
    background-color: var(--bp-red);
}

.results-mark--draw .results-mark__cap,
.results-mark--draw .results-mark__bar {
    background-color: var(--bp-amber);
}

.results-status {
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-ExtraBold UI SDF.asset");
    margin-bottom: var(--bp-s2);
    font-size: 40px;
    color: var(--bp-text);
    white-space: normal;
}

.results-actions {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
}

.toybox-ui.results-overlay .results-button {
    min-width: 170px;
    min-height: var(--bp-target-lg);
    margin-left: var(--bp-s2);
}

/* --- .compact -------------------------------------------------------------------------------------------- */

.compact .enemy-unit-card-host {
    width: 176px;
    min-width: 176px;
}

.compact .unit-card-host {
    min-width: 176px;
    max-width: 200px;
}

.compact .unit-card__portrait {
    width: 48px;
    min-width: 48px;
}

.compact .unit-card--enemy .unit-card__portrait {
    width: 40px;
    min-width: 40px;
}

.compact .unit-card__copy {
    padding-right: 32px;
}

.compact .phase-notch,
.compact .phase-notch .phase-cluster {
    height: 30px;
}

.compact .phase-notch .timer-label {
    font-size: 22px;
}

.compact .unit-card--enemy .unit-card__name {
    padding-right: 74px;
}

/* --- .narrow ---------------------------------------------------------------------------------------------- */

.narrow .unit-card__portrait {
    display: none;
}

.narrow .enemy-unit-card-host {
    width: 176px;
    min-width: 176px;
    max-width: 176px;
}

.narrow .hud-top .hill-status-readout {
    width: 190px;
}

.narrow .hill-pip {
    width: 14px;
}

/* --- .phone ------------------------------------------------------------------------------------------------ */

.phone .hud-dock {
    height: 214px;
}

.phone .hud-dock__row {
    flex-direction: column;
    align-items: stretch;
    padding-left: var(--bp-s3);
    padding-right: var(--bp-s3);
}

.phone .hud-header-actions {
    width: 100%;
    margin-left: 0;
    margin-bottom: var(--bp-s2);
    justify-content: flex-end;
}

.phone .unit-cards {
    flex-grow: 0;
}

.phone .unit-card-host {
    flex-grow: 0;
    flex-basis: auto;
    width: 168px;
    min-width: 168px;
    max-width: 168px;
}

.phone .unit-card__copy {
    padding-right: 32px;
}

.phone .enemy-unit-card-host {
    width: 176px;
    min-width: 176px;
}

.phone .target-feedback {
    left: var(--bp-s3);
    bottom: 178px;
    max-width: 92%;
}

.phone .phase-notch .phase-label {
    font-size: 14px;
}

.phone .phase-notch .timer-label {
    margin-left: var(--bp-s3);
    font-size: 20px;
}

.phone .hill-status-readout {
    top: 0;
    left: auto;
    right: 0;
    width: 190px;
    height: 62px;
    padding: 6px var(--bp-s2);
    flex-direction: column;
    align-items: stretch;
}

.phone .hill-status-readout__key {
    display: none;
}

.phone .deployment-overlay {
    padding: var(--bp-s4);
}

.phone .deployment-overlay__title {
    font-size: 26px;
}

.phone .results-actions {
    flex-direction: column;
}

.phone .toybox-ui.results-overlay .results-button {
    width: 100%;
    margin-left: 0;
    margin-top: var(--bp-s2);
}

/* --- .short -------------------------------------------------------------------------------------------------- */

.short .phase-notch {
    top: 72px;
}

.short .target-feedback {
    bottom: 108px;
}

.short .unit-card-host {
    height: 92px;
}

.short .enemy-unit-card-host {
    height: 64px;
}

.phone.short .hill-status-readout {
    left: auto;
    right: 0;
    top: 0;
    width: 170px;
    height: 56px;
}

.phone.short .hill-streak {
    display: none;
}
