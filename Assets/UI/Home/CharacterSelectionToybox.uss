/* Crew selection — the §5.5 "grid of unit options as cards" realised as three columns with
   --bp-s5 gutters and --bp-s6 screen padding (ArtDirection §5.5, "Crew selection"). The column
   count is this file's choice; §5.5 specifies the card grid, not its arity. */

.roster-screen {
    background-color: var(--bp-transparent);
}

.roster-frame {
    padding: var(--bp-s6);
}

.roster-frame .unity-scroll-view__content-container {
    min-height: 100%;
    justify-content: flex-start;
}

.roster-columns {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

/* --- Left column ---------------------------------------------------------- */

.roster-aside {
    width: 300px;
    min-width: 300px;
    margin-right: var(--bp-s5);
}

.toybox-ui.roster-screen .roster-heading {
    margin-bottom: var(--bp-s5);
}

.roster-instruction {
    margin-top: var(--bp-s2);
    color: var(--bp-text-2);
    white-space: normal;
}

.toybox-ui.roster-screen .match-summary {
    margin-bottom: var(--bp-s4);
}

.summary-headline {
    margin-bottom: var(--bp-s3);
    font-size: var(--bp-type-title);
    -unity-font-style: bold;
    color: var(--bp-text);
}

.summary-row {
    min-height: 32px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: var(--bp-bw-hair);
    border-bottom-color: var(--bp-line-1);
}

.summary-row--last {
    border-bottom-width: 0;
}

.summary-row__key {
    font-size: var(--bp-type-label);
    -unity-font-style: bold;
    color: var(--bp-text-3);
    letter-spacing: 0.6px;
}

.summary-row__value {
    margin-left: var(--bp-s4);
    font-size: var(--bp-type-body);
    -unity-font-style: bold;
    color: var(--bp-text);
}

.toybox-ui.roster-screen .map-column {
    align-items: stretch;
}

.map-label {
    align-self: flex-start;
}

.map-preview {
    width: 100%;
    height: 168px;
    background-image: url("project://database/Assets/Images/MapPreview.png");
    -unity-background-scale-mode: scale-to-fit;
    background-color: var(--bp-deck-0);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-2);
    border-radius: var(--bp-r-md);
}

.map-caption {
    margin-top: var(--bp-s2);
    font-size: var(--bp-type-label);
    color: var(--bp-text-3);
}

/* Left empty on purpose so the 3D model reads behind the lower third. */
.roster-model-stage {
    flex-grow: 1;
    min-height: 120px;
}

/* --- Centre column --------------------------------------------------------- */

.roster-main {
    flex-grow: 1;
    min-width: 0;
    margin-right: var(--bp-s5);
}

.roster-options {
    flex-grow: 1;
    min-height: 0;
}

.roster-options .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

.unit-option {
    position: relative;
    flex-grow: 1;
    flex-basis: 0;
    width: 0;
    min-width: 176px;
    max-width: 220px;
    min-height: 0;
    height: 100%;
    margin-right: var(--bp-s2);
    padding: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    overflow: hidden;
    background-color: var(--bp-deck-1);
    color: var(--bp-text);
    border-width: var(--bp-bw-hair);
    border-top-color: var(--bp-line-1);
    border-right-color: var(--bp-line-2);
    border-left-color: var(--bp-line-2);
    border-bottom-width: var(--bp-edge);
    border-bottom-color: var(--bp-edge-dark);
    border-radius: var(--bp-r-md);
    -unity-text-align: upper-left;
    transition-property: background-color, border-color, border-width;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.unit-option:hover {
    background-color: var(--bp-deck-2);
    border-top-color: var(--bp-line-3);
    border-right-color: var(--bp-line-3);
    border-left-color: var(--bp-line-3);
}

.unit-option:hover .unit-option__portrait {
    scale: 1.03;
}

.unit-option:active {
    background-color: var(--bp-deck-3);
    border-bottom-width: var(--bp-bw-hair);
    translate: 0 1px;
}

.unit-option:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
    transition-duration: var(--bp-t-instant);
}

.unit-option:disabled,
.unit-option:disabled:hover {
    opacity: 1;
    background-color: var(--bp-deck-1);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-1);
    translate: 0 0;
}

.unit-option--selected,
.unit-option--selected:hover {
    background-color: var(--bp-deck-3);
    border-top-color: var(--bp-blue-line);
    border-right-color: var(--bp-blue-line);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-blue);
}

.unit-option--selected:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.unit-option--unavailable,
.unit-option--unavailable:hover,
.unit-option--unavailable:disabled,
.unit-option--unavailable:disabled:hover {
    opacity: 1;
    background-color: var(--bp-deck-1);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-1);
}

.unit-option--unavailable:hover .unit-option__portrait {
    scale: 1;
}

/* 4:3 portrait plate at the top of the card. */
.unit-option__portrait {
    height: 150px;
    flex-shrink: 0;
    /* Recess, not emphasis — stays darker than the option fill after the ramp inversion. */
    background-color: var(--bp-deck-2);
    -unity-background-scale-mode: scale-and-crop;
    border-bottom-width: var(--bp-bw-hair);
    border-bottom-color: var(--bp-line-1);
    transition-property: scale;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.unit-option--unavailable .unit-option__portrait {
    opacity: 0.35;
}

.unit-option__copy {
    flex-grow: 1;
    min-height: 0;
    padding: var(--bp-s3);
    overflow: hidden;
}

.unit-option__name {
    flex-shrink: 0;
    font-size: var(--bp-type-body);
    -unity-font-style: bold;
    color: var(--bp-text);
}

.unit-option--unavailable .unit-option__name {
    color: var(--bp-text-3);
}

/* USS has no line clamp; three lines of 13px copy is 54px. */
.unit-option__description {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    max-height: 54px;
    margin-top: var(--bp-s1);
    font-size: var(--bp-type-body-sm);
    color: var(--bp-text-2);
    white-space: normal;
    overflow: hidden;
}

.unit-option--unavailable .unit-option__description {
    color: var(--bp-text-3);
}

.unit-option__ability-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: var(--bp-s2);
}

.unit-option__ability-mark {
    width: 8px;
    height: 8px;
    margin-right: var(--bp-s2);
    background-color: var(--bp-amber);
    rotate: 45deg;
}

.unit-option__ability {
    flex-grow: 1;
    min-width: 0;
    font-size: var(--bp-type-body-sm);
    color: var(--bp-amber-hi);
    white-space: normal;
}

.unit-option--unavailable .unit-option__ability {
    color: var(--bp-text-3);
}

.unit-option--unavailable .unit-option__ability-mark {
    background-color: var(--bp-text-3);
}

.unit-option__status {
    position: absolute;
    top: var(--bp-s2);
    right: var(--bp-s2);
    height: 22px;
    padding: 0 var(--bp-s2);
    -unity-font-definition: url("project://database/Assets/Fonts/SairaCondensed/SairaCondensed-ExtraBold UI SDF.asset");
    background-color: var(--bp-deck-0);
    color: var(--bp-text-3);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-3);
    border-radius: var(--bp-r-sm);
    font-size: var(--bp-type-micro);
    -unity-text-align: middle-center;
    letter-spacing: 1.2px;
}

.unit-option--selected .unit-option__status {
    color: var(--bp-blue);
    border-color: var(--bp-blue-line);
}

.unit-option--unavailable .unit-option__status {
    color: var(--bp-text-3);
}

/* --- Right column ------------------------------------------------------------- */

.roster-crew {
    width: 320px;
    min-width: 320px;
}

.selected-roster {
    flex-shrink: 0;
}

.selected-slot {
    min-height: 64px;
    margin-bottom: var(--bp-s2);
    padding: 0 var(--bp-s3);
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background-color: var(--bp-deck-0);
    color: var(--bp-text-3);
    border-width: var(--bp-bw-hair);
    border-color: var(--bp-line-1);
    border-radius: var(--bp-r-md);
    -unity-text-align: middle-left;
    transition-property: background-color, border-color, border-width;
    transition-duration: var(--bp-t-base);
    transition-timing-function: var(--bp-ease-out);
}

.selected-slot:hover {
    background-color: var(--bp-deck-1);
    border-color: var(--bp-line-2);
}

.selected-slot:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
    transition-duration: var(--bp-t-instant);
}

.selected-slot:active {
    background-color: var(--bp-deck-2);
    translate: 0 1px;
}

.selected-slot:disabled,
.selected-slot:disabled:hover,
.selected-slot:disabled:active {
    opacity: 1;
    background-color: var(--bp-deck-0);
    border-color: var(--bp-line-1);
    translate: 0 0;
}

.selected-slot--filled,
.selected-slot--filled:disabled,
.selected-slot--filled:disabled:hover,
.selected-slot--filled:disabled:active {
    opacity: 1;
    background-color: var(--bp-deck-2);
    color: var(--bp-text);
    border-color: var(--bp-line-2);
    border-left-width: var(--bp-bw-rule);
    border-left-color: var(--bp-blue);
}

/* Hovering a filled slot removes the unit, so the rule turns red first. */
.selected-slot--filled:hover {
    background-color: var(--bp-deck-3);
    border-left-color: var(--bp-red);
}

.selected-slot--filled:focus {
    border-width: var(--bp-bw-focus);
    border-color: var(--bp-focus-light);
}

.selected-slot__index {
    width: 24px;
    min-width: 24px;
    margin-right: var(--bp-s3);
    -unity-font-definition: url("project://database/Assets/Fonts/CascadiaCode-VariableFont_wght UI SDF.asset");
    font-size: var(--bp-type-num);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--bp-text-3);
}

.selected-slot__portrait {
    display: none;
    width: 40px;
    min-width: 40px;
    height: 40px;
    margin-right: var(--bp-s3);
    /* Was deck-0 on a deck-0 slot, which reads as nothing at all once both are paper. */
    background-color: var(--bp-deck-2);
    border-radius: var(--bp-r-sm);
    -unity-background-scale-mode: scale-and-crop;
}

.selected-slot--filled .selected-slot__portrait {
    display: flex;
}

.selected-slot__copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
    overflow: hidden;
}

.selected-slot__name {
    font-size: var(--bp-type-body);
    color: var(--bp-text-3);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.selected-slot--filled .selected-slot__name {
    -unity-font-style: bold;
    color: var(--bp-text);
}

.selected-slot__detail {
    margin-top: 2px;
    font-size: var(--bp-type-body-sm);
    color: var(--bp-text-3);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.selected-slot--filled .selected-slot__detail {
    color: var(--bp-text-2);
}

.selection-status {
    margin-top: var(--bp-s3);
    margin-bottom: var(--bp-s3);
}

.toybox-ui.roster-screen .confirm-button {
    width: 100%;
    min-height: var(--bp-target-lg);
}

/* --- Responsive ------------------------------------------------------------------ */

.compact .roster-frame {
    padding: var(--bp-s5);
}

.compact .roster-aside {
    width: 272px;
    min-width: 272px;
    margin-right: var(--bp-s4);
}

.compact .roster-main {
    margin-right: var(--bp-s4);
}

.compact .roster-crew {
    width: 296px;
    min-width: 296px;
}

.compact .unit-option__portrait {
    height: 126px;
}

.compact .map-preview {
    height: 140px;
}

.narrow .roster-frame {
    padding: var(--bp-s4);
}

.narrow .roster-columns {
    flex-direction: column;
}

.narrow .roster-aside,
.narrow .roster-main,
.narrow .roster-crew {
    width: 100%;
    min-width: 0;
    margin-right: 0;
}

.narrow .roster-aside {
    margin-bottom: var(--bp-s4);
}

.narrow .roster-model-stage,
.narrow .map-column {
    display: none;
}

.narrow .roster-main {
    height: 300px;
    min-height: 300px;
    margin-bottom: var(--bp-s4);
}

.narrow .unit-option {
    flex-grow: 0;
    flex-basis: auto;
    width: 190px;
    max-width: 190px;
}

.narrow .selected-roster {
    flex-direction: row;
    flex-wrap: wrap;
}

.narrow .selected-slot {
    width: 19%;
    min-width: 0;
    margin-right: 1%;
}

.narrow .selected-slot__index {
    width: 16px;
    min-width: 16px;
    margin-right: var(--bp-s2);
    font-size: var(--bp-type-body);
}

.narrow .selected-slot__portrait,
.narrow .selected-slot--filled .selected-slot__portrait {
    display: none;
}

.narrow .selection-status {
    -unity-text-align: middle-left;
}

.phone .roster-frame {
    padding: var(--bp-s4);
}

.phone .roster-main {
    height: 286px;
    min-height: 286px;
}

.phone .unit-option {
    width: 168px;
    min-width: 168px;
    max-width: 168px;
}

.phone .unit-option__portrait {
    height: 112px;
}

.phone .unit-option__description {
    display: none;
}

/* Without the description there is no flexible child left to hold the ability
   line against the bottom of the card. */
.phone .unit-option__copy,
.short .unit-option__copy {
    justify-content: space-between;
}

.phone .selected-slot {
    width: 100%;
    margin-right: 0;
    min-height: var(--bp-target-phone);
}

.phone .selected-slot__detail {
    display: none;
}

.short .roster-frame {
    padding-top: var(--bp-s4);
    padding-bottom: var(--bp-s4);
}

.short .roster-instruction {
    display: none;
}

.short .roster-model-stage {
    display: none;
}

.short .unit-option__portrait {
    height: 104px;
}

.short .unit-option__description {
    display: none;
}

.short .map-preview {
    height: 120px;
}

.short .selected-slot {
    min-height: 52px;
}
