/* The crew screen: Overwatch's hero select, adapted to picking five.

   Two blocks over a lit 3D stage. The screen's statement sits at the top in
   type alone, with nothing beside it — no plate, no readout, no second column —
   so the stage is unobstructed across the full width under it. Everything you
   operate is one console anchored to the bottom edge: the portrait grid, the
   match rail beside it, and your five slots under both, separated by hairlines
   rather than by gaps. Three floating plates with stage showing between them is
   what made this screen read as three unrelated screenshots.

   The console is opaque, which is the one place this screen departs from the
   library's "a panel is a tint over the world". The world behind it is a
   character eight metres tall, and at the shared 0.9 it came through the
   portrait grid as a pale mass nobody could place. Above the console the stage
   is fully visible and the characters are framed in it; below, they are simply
   behind a solid object.

   The screen paints nothing of its own: .screen's --toy-ground is overridden
   immediately below so the stage camera shows through. That is why the vignette
   and the two scrims are in the markup rather than being decoration — without
   them the header is navy type on whatever the stage happens to be lit to. */

.roster-screen {
    background-color: var(--toy-transparent);
}

/* The scrim texture is a 4x256 alpha ramp with no intrinsic height, so it
   collapses to nothing unless it is given one. Most of its height is spent
   behind the console, where nothing can see it; what it is sized for is the
   last of its tail reaching the crews' boots, so they settle onto the console's
   top edge instead of being cut off at it. */
.roster-screen .toy-scrim-bottom {
    height: 70%;
}

/* The header is the one block on this screen with no plate under it, and the
   vignette does not cover it: its alpha is 36/255 at the frame edge and zero
   across the middle, so the title, the eyebrow and the instruction were reading
   against whatever the crew was lit to behind them.

   A left mask and not a top one, because the type is all in one corner. Ruled
   across the top it had to be deep enough to carry the instruction, which meant
   it also lay over the crews standing in the middle of the frame and bleached
   their heads to the colour of the page. Down the left it covers every line of
   type at full strength and stops before the first character. Its width is the
   title block's own plus a falloff. */
.roster-screen .roster-scrim {
    width: 640px;
}

/* No horizontal or bottom inset: the console runs to three edges of the frame,
   so the gutter belongs to the two blocks and not to the page. Inset, the
   console read as a card floating on the stage with a 24px sliver of backdrop
   under it, which is the one edge a bottom bar must not have.

   Two classes deep on purpose, unlike the rest of the composition rules here:
   the shared `.compact .screen-frame` is itself two deep and would otherwise
   put the whole inset back on every aspect narrower than 16:9. */
.roster-screen .roster-frame {
    padding: 30px 0 0 0;
}

.roster-frame .unity-scroll-view__content-container {
    min-height: 100%;
    justify-content: flex-start;
}

/* ------------------------------------------------------------------ header */

/* Type only, and nothing under it. The match readout used to sit at the far end
   of this row as a second plate, which turned the header into a two-column form
   and covered the top corner of the stage; it now lives in the console's match
   rail, beside the board it describes.

   The rule that used to close the header went with it. Ruled the full width of
   the frame it was the strongest horizontal in the composition and it separated
   the title from nothing — the console is the next thing down, and it draws its
   own top edge. It also capped the stage at 190px, which is not enough height
   for a character to be anything but a cropped head. */
.roster-header {
    align-items: flex-start;
    margin-right: 38px;
    margin-left: 38px;
    padding-bottom: var(--toy-space-sm);
}

/* Half the blur the shared title carries. The left mask now holds the whole
   type block off the stage, so the halo is only closing the gap under a
   descender; at 14px it was a haze around 46px of condensed caps and it read as
   the type being out of focus. */
.roster-title {
    margin-bottom: 6px;
    text-shadow: 0 1px 7px var(--toy-scrim);
}

/* The eyebrow sits on the stage with no plate under it, so it carries full ink
   rather than the muted step a heading gets inside a panel. Navy on the
   scrimmed periwinkle measures 3.8:1 unhelped, which is why the scrim above is
   not optional on this screen. */
.toybox-ui.roster-screen .roster-header .section-label {
    color: var(--toy-text);
}

/* A hole in the layout rather than an element. It eats the vertical slack so
   the header floats at the top and the console sits on the bottom edge; what
   shows through it is the stage, and how tall it is decides how much of a
   character you see. The crews stand on the console's top edge and reach up
   into the header band beside the title.

   Whatever is left and no more: it carries no floor of its own, so a catalog
   that needs a third row of tiles takes the height out of the stage rather than
   pushing the confirm button off the bottom of the screen, and a 32:9 letterbox
   simply has no stage. A floor here is also what left a strip of backdrop under
   the console on every aspect where the slack had nowhere else to go. */
.roster-model-stage {
    flex-grow: 1;
}

/* ----------------------------------------------------------------- console */

/* One plate for everything you operate. Opaque for the reason given at the top
   of the file. The horizontal padding is the frame gutter the header carries as
   a margin, so the word "Units" stands on the same line as the eyebrow above
   it; the vertical is tighter, because the console holds two bands of its own
   and a shared 24 outside both read as a margin around a margin. */
.roster-screen .roster-console {
    flex-shrink: 0;
    padding: var(--toy-space-panel-compact) 38px 22px 38px;
    background-color: var(--toy-surface);
}

/* No height of its own. The band is as tall as the taller of the two columns,
   which is the grid, which is as tall as the rows it happens to have — so a
   thirteenth unit lengthens the console and shortens the stage instead of being
   cut in half by a fixed band. Every breakpoint below therefore sets a column
   count and a cell height and nothing else. */
.roster-body {
    flex-shrink: 0;
    flex-direction: row;
}

/* The grid and the rail are divided by a line, not by a gap. The gap is what
   let the stage show between two panels that describe the same match. */
.unit-library {
    width: 74%;
    padding-right: var(--toy-space-lg);
    border-right-width: var(--toy-stroke-thin);
    border-right-color: var(--toy-divider);
}

.library-head {
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--toy-space-sm);
}

.library-head__label {
    margin-bottom: 0;
    flex-shrink: 0;
}

.class-chips {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: var(--toy-space-md);
}

/* Each chip is as wide as the word in it and no wider. Shrinking them to share
   the row out evenly cost every chip the same width regardless of its label, so
   "All" carried a pad of empty plate either side of it and "Controller" was
   ellipsed to fit the same box — with a third of the row still unused. The six
   of them together come to well under half the library head at every
   breakpoint, and the phone case grows them to fill instead. */
.roster-screen .class-chip {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 30px;
    margin: 0 0 0 var(--toy-space-xs);
    padding: 0 var(--toy-space-md);
    justify-content: center;
    border-radius: var(--toy-radius-sm);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-edge);
    font-size: var(--toy-type-caption);
    white-space: nowrap;
}

/* Sized by its content, not by the space left over: this is a grid that
   happens to sit in a ScrollView so a catalog taller than the screen can still
   be reached, not a scroll pane with a grid in it. */
.roster-options {
    flex-grow: 0;
    flex-shrink: 0;
}

.roster-options .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    align-content: flex-start;
}

/* An instantiated template arrives wrapped in a container, and it is the
   wrapper the grid lays out. Six to a row at a sixth of the width each, with
   the gutter as the wrapper's own padding so the sixths still add up to the
   width of the panel.

   Six and not five because the shipped catalog is twelve units, and twelve at
   five to a row is two full rows and a row of two. Every column count in this
   file divides twelve — six here, four on the narrower two, three on a phone —
   because a ragged last row and a band cutting the second row through its name
   plates are the two things this grid looked unfinished for. Add a thirteenth
   unit and it is a row of one; nothing clips, the console just grows. */
.unit-cell {
    flex-shrink: 0;
    width: 16.66%;
    height: 196px;
    padding: 0 var(--toy-space-md) var(--toy-space-md) 0;
}

/* The tile. Margin is stated because the default runtime theme puts three
   pixels around every Button, which read as an uneven gutter between portraits.

   The left border is three pixels in every state and only ever changes colour:
   growing it on hover moved the portrait sideways under the pointer. At rest it
   is the edge wash, which reads as a marker rail waiting to be lit. */
.unit-option {
    position: relative;
    width: 100%;
    min-width: 0;
    min-height: 0;
    height: 100%;
    margin: 0;
    padding: 0;
    flex-direction: column;
    align-items: stretch;
    overflow: hidden;
    background-color: var(--toy-surface-raised);
    color: var(--toy-text);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-top-color: var(--toy-edge-strong);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-edge);
    border-radius: var(--toy-radius-lg);
    -unity-text-align: upper-left;
    transition-duration: var(--toy-motion-fast);
    transition-property: background-color, border-color, color;
}

.unit-option:hover {
    background-color: var(--toy-select);
    color: var(--toy-text-on-deep);
    border-color: var(--toy-select);
    border-left-color: var(--toy-primary);
}

/* Pressing an already-chosen tile adds a second copy of that unit, so the
   selected plate has to answer the pointer as well as the empty one does. */
.unit-option:active,
.unit-option.unit-option--selected:active {
    background-color: var(--toy-select-pressed);
    border-color: var(--toy-select-pressed);
    border-left-color: var(--toy-primary);
}

.unit-option:focus {
    border-width: var(--toy-focus-emphasis);
    border-color: var(--toy-focus);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-primary);
}

/* Every tile goes disabled the moment the fifth slot fills, so the disabled
   plate has to be a resting state and not a warning. */
.unit-option:disabled,
.unit-option:disabled:hover {
    opacity: 1;
    background-color: var(--toy-disabled-surface);
    color: var(--toy-text-muted);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-disabled-border);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-disabled-border);
}

.unit-option.unit-option--selected,
.unit-option.unit-option--selected:disabled,
.unit-option.unit-option--selected:disabled:hover {
    opacity: 1;
    background-color: var(--toy-select);
    color: var(--toy-text-on-deep);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-select);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-primary);
}

/* A white ring on the white plate is not a ring, so focus steps the plate down
   and outlines it in the dark ink instead. */
.unit-option.unit-option--selected:focus,
.unit-option:hover:focus {
    background-color: var(--toy-select-pressed);
    border-width: var(--toy-focus-emphasis);
    border-color: var(--toy-text-on-deep);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-primary);
}

.unit-option.unit-option--unavailable,
.unit-option.unit-option--unavailable:disabled,
.unit-option.unit-option--unavailable:disabled:hover {
    opacity: 1;
    background-color: var(--toy-disabled-surface);
    color: var(--toy-text-muted);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-disabled-border);
}

/* Scaled to fit, never stretched, and the frame's aspect does not have to match
   the file's: the portraits are cut-outs on transparency, so what fills the rest
   of the frame is the bone plate the character is standing on and there is no
   letterbox to see. */
.unit-option__portrait {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
    background-color: var(--toy-warm);
    -unity-background-scale-mode: scale-to-fit;
}

/* Tint the picture rather than fading the tile, so an unavailable unit still
   reads as itself. */
.unit-option--unavailable .unit-option__portrait {
    -unity-background-image-tint-color: var(--toy-disabled-border);
}

.unit-option__name {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-title);
    -unity-font-style: normal;
    color: var(--toy-text);
    letter-spacing: var(--toy-track-title);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.unit-option:hover .unit-option__name,
.unit-option--selected .unit-option__name {
    color: var(--toy-text-on-deep);
}

.unit-option--unavailable .unit-option__name {
    color: var(--toy-text-muted);
}

/* Title plate under the portrait. Extra bottom inset lifts Oswald's caps,
   which sit low in the line box, onto the optical centre of the band. */
.unit-option__copy {
    height: 38px;
    flex-shrink: 0;
    padding: 0 8px 4px 8px;
    overflow: hidden;
    border-top-width: var(--toy-stroke-thin);
    border-top-color: var(--toy-edge);
}

/* The stack counter, flush into the corner. Inset from the edge it reads as a
   sticker on the picture; flush it reads as part of the frame. It only appears
   on a unit taken more than once — one copy is already announced by the plate
   inverting and the name plate turning blue, and a word saying so over every
   picked portrait was the loudest mark on the screen. Never give this a display
   property: the controller hides it with the shared .hidden class, which this
   rule would outrank. */
.unit-option__status {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 30px;
    min-height: 22px;
    padding: 2px 7px;
    background-color: var(--toy-primary);
    color: var(--toy-text-on-accent);
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-caption);
    -unity-font-style: normal;
    letter-spacing: var(--toy-track-label);
    -unity-text-align: middle-center;
}

.unit-option--unavailable .unit-option__status {
    background-color: var(--toy-disabled-surface);
    color: var(--toy-text-muted);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-disabled-border);
}

/* -------------------------------------------------------------- match rail */

/* The board and the rules that will be played on it, in one column: a 1v1
   tactics match is chosen on the map as much as on the crew, and splitting the
   two across opposite corners of the screen meant neither read as the answer to
   "what am I picking for". */
.match-rail {
    flex-grow: 1;
    min-width: 250px;
    padding-left: var(--toy-space-lg);
}

.match-rail__label {
    align-self: flex-start;
}

/* Sized 3:2 by hand, because that is the thumbnail's own shape and USS has no
   aspect-ratio property. Stretched to the rail it letterboxed on the grey the
   file already has baked into it, which read as a screenshot of a screenshot. */
.map-preview {
    width: 372px;
    max-width: 100%;
    height: 248px;
    align-self: center;
    background-image: url("project://database/Assets/Images/MapPreview.png");
    -unity-background-scale-mode: scale-to-fit;
    background-color: var(--toy-inset);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-top-color: var(--toy-edge-strong);
    border-radius: var(--toy-radius-md);
}

.map-caption {
    align-self: flex-start;
    margin-top: var(--toy-space-sm);
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-caption);
    -unity-font-style: normal;
    color: var(--toy-text-muted);
    letter-spacing: var(--toy-track-label);
}

/* The match readout. Keys and values are both display face because this is an
   instrument panel, not prose, and a hairline per row is the only structure it
   needs: boxing each pair produced a table nobody reads. */
.match-summary {
    margin-top: var(--toy-space-control-x);
}

.summary-row {
    min-height: 32px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-top-width: var(--toy-stroke-thin);
    border-top-color: var(--toy-divider);
}

.summary-row__key {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-caption);
    -unity-font-style: normal;
    color: var(--toy-text-muted);
    letter-spacing: var(--toy-track-label);
}

.summary-row__value {
    margin-left: var(--toy-space-panel-compact);
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-body-lg);
    -unity-font-style: normal;
    color: var(--toy-text);
    letter-spacing: var(--toy-track-title);
}

/* ------------------------------------------------------------------- crew */

/* Under both bands, divided from them by the same hairline the rail uses. */
.roster-screen .selection-dock {
    margin-top: var(--toy-space-panel-compact);
    padding-top: var(--toy-space-panel-compact);
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    border-top-width: var(--toy-stroke-thin);
    border-top-color: var(--toy-divider);
}

.selection-column {
    flex-grow: 1;
    min-width: 0;
}

/* A fixed band over the slots so "Your crew" keeps the same gap to them
   whichever breakpoint the dock is at. */
.selection-head {
    min-height: 26px;
    flex-direction: row;
    align-items: center;
}

.selection-head__label {
    margin-bottom: 0;
}

.selected-roster {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--toy-space-sm);
}

/* The five slots divide the strip between them rather than carrying a width per
   breakpoint: the dock is the full width of the console at every size, and a
   fixed slot left either a ragged gap at 1920 or an overflow at 1000. */
.selected-slot {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 78px;
    margin: 0 var(--toy-space-sm) 0 0;
    padding: 9px 12px;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    background-color: var(--toy-inset);
    color: var(--toy-text-copy);
    border-width: var(--toy-stroke-thin);
    border-color: var(--toy-edge);
    border-top-color: var(--toy-edge-strong);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-edge);
    border-radius: var(--toy-radius-md);
    -unity-text-align: middle-left;
    transition-duration: var(--toy-motion-fast);
    transition-property: background-color, border-color, color;
}

/* An empty slot is disabled, so it must not light up under the pointer: there is
   nothing in it to remove.

   Disabled is not the same as unreadable, and this is the well — the darkest
   surface on the paper theme. Muted ink measures 2.7:1 in here, so an empty
   slot carries copy and takes its de-emphasis from the missing portrait and
   the empty leading rule instead. */
.selected-slot:disabled,
.selected-slot:disabled:hover,
.selected-slot:disabled:active {
    opacity: 1;
    background-color: var(--toy-inset);
    color: var(--toy-text-copy);
    border-color: var(--toy-edge);
    border-top-color: var(--toy-edge-strong);
    border-left-color: var(--toy-edge);
}

.selected-slot.selected-slot--filled,
.selected-slot.selected-slot--filled:disabled,
.selected-slot.selected-slot--filled:disabled:hover,
.selected-slot.selected-slot--filled:disabled:active {
    opacity: 1;
    background-color: var(--toy-select);
    color: var(--toy-text-on-deep);
    border-color: var(--toy-select);
    border-left-color: var(--toy-primary);
}

.selected-slot--filled:hover {
    background-color: var(--toy-select-hover);
    border-color: var(--toy-select-hover);
    border-left-color: var(--toy-primary);
}

.selected-slot--filled:active {
    background-color: var(--toy-select-pressed);
    border-color: var(--toy-select-pressed);
    border-left-color: var(--toy-primary);
}

.selected-slot--filled:focus {
    background-color: var(--toy-select-pressed);
    border-width: var(--toy-focus-emphasis);
    border-color: var(--toy-text-on-deep);
    border-left-width: var(--toy-accent-rule);
    border-left-color: var(--toy-primary);
}

/* The numeral is the whole of an empty slot, so it is set at title size. Filled,
   it drops to the quiet ink and lets the unit name lead. */
.selected-slot__index {
    width: 24px;
    min-width: 24px;
    margin-right: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-title-lg);
    -unity-font-style: normal;
    color: var(--toy-text-copy);
    letter-spacing: var(--toy-track-title);
    -unity-text-align: middle-center;
}

.selected-slot--filled .selected-slot__index {
    color: var(--toy-text-on-accent-quiet);
}

/* 4:3, because the portrait file is, and 60 tall because that is the slot's
   whole inside — 78 less the 9 of padding top and bottom. The picture fills the
   frame edge to edge at those numbers; a square frame let it sit in a letterbox
   with a band of bare plate over and under it. USS has no aspect-ratio
   property, so the two numbers have to be kept in step by hand, and every
   breakpoint below that resizes one resizes both. */
.selected-slot__portrait {
    visibility: hidden;
    width: 80px;
    min-width: 80px;
    height: 60px;
    margin-right: var(--toy-space-md);
    background-color: var(--toy-warm);
    -unity-background-scale-mode: scale-to-fit;
}

/* Hidden, not undisplayed: an empty slot has to measure exactly what a filled
   one does, or the strip changes shape under you as the crew fills up and the
   numerals stop lining up with the row above. */
.selected-slot--filled .selected-slot__portrait {
    visibility: visible;
}

.selected-slot__copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
    overflow: hidden;
}

.selected-slot__name {
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-body-lg);
    -unity-font-style: normal;
    color: var(--toy-text-copy);
    letter-spacing: var(--toy-track-label);
    white-space: nowrap;
    overflow: hidden;
}

.selected-slot--filled .selected-slot__name {
    color: var(--toy-text-on-deep);
}

/* The ability line only exists once there is a unit to describe. Empty, the
   numeral and "Open slot" already say everything, and a second line of filler
   under them made five hollow slots look like five broken ones. */
.selected-slot__detail {
    display: none;
    margin-top: 2px;
    -unity-font-definition: url("project://database/Assets/Fonts/OswaldCaps/OswaldCaps-Regular UI SDF.asset");
    font-size: var(--toy-type-caption);
    -unity-font-style: normal;
    color: var(--toy-text-on-accent-quiet);
    letter-spacing: var(--toy-track-label);
    white-space: nowrap;
    overflow: hidden;
}

.selected-slot--filled .selected-slot__detail {
    display: flex;
}

/* Escort matches only: the slot the president takes over. */
.selected-slot--president,
.selected-slot--president:disabled,
.selected-slot--president:disabled:hover,
.selected-slot--president:disabled:active {
    border-left-color: var(--toy-primary);
}

.selected-slot--president .selected-slot__detail {
    display: flex;
    color: var(--toy-primary-copy);
}

.selected-slot--president.selected-slot--filled .selected-slot__detail {
    color: var(--toy-text-on-accent-quiet);
}

.confirm-column {
    width: 280px;
    min-width: 240px;
    margin-left: var(--toy-space-lg);
    align-items: stretch;
}

.roster-screen .selection-status {
    min-height: 22px;
    margin-bottom: var(--toy-space-sm);
    font-size: var(--toy-type-label);
    -unity-text-align: middle-right;
}

/* Composition has to outrank the shared button: .toybox-ui .button justifies to
   flex-start, so a plain .confirm-button rule left the check and the word parked
   against the left edge of a 280px plate. */
.roster-screen .confirm-button {
    width: 100%;
    min-height: 64px;
    margin: 0;
    justify-content: center;
}

.confirm-button__label {
    font-size: var(--toy-type-title);
    color: var(--toy-text-on-accent);
    letter-spacing: var(--toy-track-title);
}

.confirm-button:disabled {
    opacity: 1;
}

/* -------------------------------------------------------------------------
   Breakpoints. Every rule below is one class deep, which ties with the
   composition rules above and wins on order. Naming the screen class here too
   would bind each override to which element the controller happens to put the
   breakpoint class on, and that is not the element the screen class is on.

   The grid loses a column at each step rather than shrinking twelve tiles into
   the same row: a portrait under about 150px wide stops being a portrait. */

.compact .roster-scrim {
    width: 560px;
}

.compact .roster-header {
    margin-right: var(--toy-space-panel);
    margin-left: var(--toy-space-panel);
}

.compact .roster-console {
    padding-right: var(--toy-space-panel);
    padding-left: var(--toy-space-panel);
}

.compact .unit-cell {
    width: 25%;
    height: 204px;
}

.compact .map-preview {
    width: 318px;
    height: 212px;
}

.compact .selected-slot {
    min-height: 68px;
}

.compact .selected-slot__portrait {
    width: 64px;
    min-width: 64px;
    height: 48px;
}

.narrow .roster-scrim {
    width: 440px;
}

.narrow .roster-header {
    margin-right: var(--toy-space-panel-compact);
    margin-left: var(--toy-space-panel-compact);
}

.narrow .roster-console {
    padding-right: var(--toy-space-panel-compact);
    padding-left: var(--toy-space-panel-compact);
}

.narrow .roster-title {
    font-size: var(--toy-type-title-lg);
}

/* Under a thousand the rail goes below the grid rather than beside it, and the
   board thumbnail goes with the second column: the rules are the part of the
   rail you still need when there is no room to show the map. */
.narrow .roster-body {
    height: auto;
    flex-direction: column;
}

.narrow .unit-library {
    width: 100%;
    padding-right: 0;
    border-right-width: 0;
}

.narrow .unit-cell {
    width: 25%;
    height: 184px;
}

.narrow .match-rail {
    min-width: 0;
    margin-top: var(--toy-space-md);
    padding-top: var(--toy-space-md);
    padding-left: 0;
    border-top-width: var(--toy-stroke-thin);
    border-top-color: var(--toy-divider);
}

.narrow .map-preview {
    display: none;
}

.narrow .selection-dock {
    flex-direction: column;
    align-items: stretch;
}

.narrow .selection-column,
.narrow .confirm-column {
    width: 100%;
}

.narrow .confirm-column {
    min-width: 0;
    margin-left: 0;
    margin-top: var(--toy-space-control-top);
}

.narrow .selection-status {
    -unity-text-align: middle-left;
}

.narrow .class-chip {
    padding: 0 var(--toy-space-sm);
}

/* Below a thousand the dock stacks and the five slots split the whole width, so
   a slot is down to 130px with a numeral already in it. Same call the phone case
   makes, for the same reason: the name is what you are checking, so the picture
   goes rather than being cropped to nothing. Hidden in both states, so an empty
   slot still measures what a filled one does. */
.narrow .selected-slot__portrait,
.narrow .selected-slot--filled .selected-slot__portrait {
    display: none;
}

.phone .roster-scrim {
    width: 320px;
}

.phone .library-head {
    min-height: 0;
    flex-direction: column;
    align-items: stretch;
}

.phone .class-chips {
    margin-left: 0;
    margin-top: var(--toy-space-xs);
    justify-content: space-between;
}

.phone .class-chip {
    flex-grow: 1;
    margin-left: 2px;
    padding: 0 var(--toy-space-xs);
}

.phone .unit-cell {
    width: 33.33%;
    height: 168px;
    padding-right: var(--toy-space-sm);
    padding-bottom: var(--toy-space-sm);
}

/* Five slots across a phone leave room for a numeral and a name and nothing
   else. The portrait is the first thing to go because the name is the thing you
   are checking. */
.phone .selected-slot {
    min-height: var(--toy-target-phone);
    margin-right: var(--toy-space-xs);
    padding-left: 7px;
    padding-right: 7px;
}

.phone .selected-slot__portrait,
.phone .selected-slot--filled .selected-slot__portrait,
.phone .selected-slot__detail,
.phone .selected-slot--filled .selected-slot__detail {
    display: none;
}

.phone .selected-slot__index {
    width: 16px;
    min-width: 16px;
    margin-right: 5px;
    font-size: var(--toy-type-title);
}

.phone .selected-slot__name {
    font-size: var(--toy-type-caption);
    white-space: normal;
}

.short .roster-frame {
    padding-top: var(--toy-space-control-top);
}

.short .roster-console {
    padding-top: var(--toy-space-md);
    padding-bottom: var(--toy-space-md);
}

.short .roster-header {
    padding-bottom: var(--toy-space-sm);
}

.short .roster-title {
    font-size: var(--toy-type-title-lg);
}

.short .unit-cell {
    height: 186px;
}

.short .map-preview {
    width: 288px;
    height: 192px;
}

.short .selection-dock {
    margin-top: var(--toy-space-md);
    padding-top: var(--toy-space-md);
}

.short .selected-slot {
    min-height: 66px;
}

.short .selected-slot__portrait {
    width: 64px;
    min-width: 64px;
    height: 48px;
}

/* The handover curtain. Transparent and unpickable until the match is actually starting, so it
   costs this screen nothing while a crew is being picked. Driven from C# rather than by a USS
   transition because the load has to wait for it, and a transition cannot be waited on. */
.deploy-curtain {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-color: var(--toy-curtain);
}
