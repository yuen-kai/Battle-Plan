.roster-screen {
    background-color: rgb(5, 9, 15);
}

.roster-frame {
    justify-content: center;
    overflow: hidden;
}

.roster-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
}

.roster-heading {
    flex-grow: 1;
    padding-right: 24px;
}

.roster-instruction {
    margin-top: 8px;
    white-space: normal;
}

.match-summary {
    width: 310px;
    padding: 16px 20px;
}

.summary-row {
    min-height: 22px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.summary-row__key {
    font-size: 11px;
    color: rgb(118, 138, 155);
    letter-spacing: 1px;
}

.summary-row__value {
    margin-left: 18px;
    font-size: 12px;
    color: rgb(216, 225, 232);
    -unity-font-style: bold;
}

.roster-body {
    flex-grow: 1;
    min-height: 320px;
    flex-direction: row;
}

.unit-library {
    width: 68%;
    margin-right: 18px;
}

.roster-options {
    flex-grow: 1;
}

.roster-options .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: stretch;
}

.roster-options .unity-scroller--horizontal {
    min-height: 14px;
    background-color: rgb(9, 16, 24);
}

.roster-options .unity-scroller__low-button,
.roster-options .unity-scroller__high-button {
    background-color: rgb(18, 30, 42);
    border-color: rgb(57, 77, 94);
}

.roster-options .unity-base-slider__tracker {
    background-color: rgb(14, 24, 34);
    border-color: rgb(43, 60, 74);
}

.roster-options .unity-base-slider__dragger {
    background-color: rgb(61, 87, 106);
    border-color: rgb(89, 119, 141);
}

.unit-option {
    width: 190px;
    min-width: 190px;
    min-height: 250px;
    margin-right: 12px;
    padding: 0;
    background-color: rgb(16, 26, 37);
    border-width: 1px;
    border-color: rgb(54, 73, 90);
    border-radius: 2px;
    flex-direction: column;
    align-items: stretch;
    -unity-text-align: upper-left;
}

.unit-option:hover {
    background-color: rgb(22, 35, 48);
    border-color: rgb(103, 139, 165);
}

.unit-option:focus {
    border-color: rgb(235, 170, 58);
}

.unit-option__portrait {
    height: 150px;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(8, 14, 22);
}

.unit-option__copy {
    flex-grow: 1;
    padding: 14px;
}

.unit-option__name {
    margin-bottom: 6px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(238, 242, 245);
}

.unit-option__description {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(166, 179, 191);
    white-space: normal;
}

.unit-option__ability-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.unit-option__ability-mark {
    width: 7px;
    height: 7px;
    margin-right: 7px;
    background-color: rgb(229, 160, 55);
}

.unit-option__ability {
    font-size: 11px;
    color: rgb(222, 188, 125);
    white-space: normal;
}

.map-column {
    flex-grow: 1;
    min-width: 250px;
    justify-content: center;
    align-items: center;
    padding: 18px;
    background-color: rgba(8, 14, 22, 0.85);
    border-width: 1px;
    border-color: rgb(34, 49, 63);
    border-radius: 2px;
}

.map-label {
    align-self: flex-start;
}

.map-preview {
    width: 100%;
    max-width: 360px;
    height: 280px;
    background-image: url("project://database/Assets/Images/MapPreview.png");
    -unity-background-scale-mode: scale-to-fit;
}

.map-caption {
    margin-top: 12px;
    font-size: 11px;
    color: rgb(128, 145, 160);
    letter-spacing: 1px;
}

.selection-dock {
    min-height: 150px;
    margin-top: 18px;
    padding: 18px 22px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.selection-column {
    flex-grow: 1;
    min-width: 0;
}

.selected-roster {
    flex-direction: row;
}

.selected-slot {
    width: 185px;
    min-width: 150px;
    min-height: 68px;
    margin-right: 10px;
    padding: 8px 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(8, 15, 23);
    color: rgb(177, 190, 202);
    border-width: 1px;
    border-color: rgb(53, 72, 88);
    border-radius: 2px;
    -unity-text-align: middle-left;
}

.selected-slot:hover {
    background-color: rgb(16, 29, 40);
    border-color: rgb(83, 111, 132);
}

.selected-slot:focus {
    border-color: rgb(237, 174, 65);
}

.selected-slot--filled {
    background-color: rgb(22, 44, 61);
    border-color: rgb(70, 151, 207);
    color: rgb(235, 244, 250);
}

.selected-slot__index {
    width: 22px;
    margin-right: 7px;
    font-size: 11px;
    color: rgb(102, 123, 140);
    letter-spacing: 1px;
}

.selected-slot__portrait {
    display: none;
    width: 46px;
    min-width: 46px;
    height: 46px;
    margin-right: 9px;
    background-color: rgb(6, 12, 19);
    -unity-background-scale-mode: scale-and-crop;
}

.selected-slot--filled .selected-slot__portrait {
    display: flex;
}

.selected-slot__copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.selected-slot__name {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(213, 222, 229);
}

.selected-slot__detail {
    margin-top: 3px;
    font-size: 11px;
    color: rgb(123, 142, 158);
}

.selected-slot--filled .selected-slot__detail {
    color: rgb(130, 187, 224);
}

.confirm-column {
    width: 270px;
    min-width: 230px;
    margin-left: 14px;
    align-items: stretch;
}

.selection-status {
    min-height: 22px;
    margin-bottom: 6px;
    -unity-text-align: middle-right;
}

.confirm-button {
    width: 100%;
}

.compact .unit-option {
    width: 160px;
    min-width: 160px;
    min-height: 220px;
}

.compact .unit-option__portrait {
    height: 125px;
}

.compact .selected-slot {
    width: 160px;
    min-width: 140px;
}

.compact .match-summary {
    width: 275px;
}

.narrow .roster-header {
    align-items: flex-start;
}

.narrow .match-summary {
    width: 220px;
}

.narrow .roster-body {
    flex-direction: column;
}

.narrow .unit-library {
    width: 100%;
    min-height: 280px;
    margin-right: 0;
    margin-bottom: 12px;
}

.narrow .map-column {
    display: none;
}

.narrow .selection-dock {
    flex-direction: column;
    align-items: stretch;
}

.narrow .selection-column {
    width: 100%;
}

.narrow .confirm-column {
    width: 100%;
    min-width: 0;
    margin-left: 0;
    margin-top: 12px;
}

.narrow .selection-status {
    -unity-text-align: middle-left;
}

.phone .roster-header {
    flex-direction: column;
}

.phone .roster-heading {
    width: 100%;
    padding-right: 0;
}

.phone .match-summary {
    width: 100%;
    margin-top: 12px;
}

.phone .selected-roster {
    flex-direction: column;
}

.phone .selected-slot {
    width: 100%;
    margin-right: 0;
    margin-bottom: 7px;
}

.short .roster-header {
    margin-bottom: 12px;
}

.short .roster-instruction {
    margin-top: 4px;
    font-size: 11px;
}

.short .roster-body {
    min-height: 250px;
}

.short .unit-option {
    min-height: 190px;
}

.short .unit-option__portrait {
    height: 105px;
}

.short .unit-option__description {
    display: none;
}

.short .map-preview {
    height: 210px;
}

.short .selection-dock {
    min-height: 122px;
    margin-top: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.short .selected-slot {
    min-height: 58px;
}
