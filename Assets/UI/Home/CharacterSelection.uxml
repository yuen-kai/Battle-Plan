<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../Shared/BattlePlan.uss" />
    <ui:Style src="../Shared/TacticalToybox.uss" />
    <ui:Style src="CharacterSelectionToybox.uss" />
    <ui:VisualElement name="screen" class="screen toybox-screen toybox-ui roster-screen">
        <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="screen-frame roster-frame">
            <ui:VisualElement class="roster-columns">
                <ui:VisualElement class="roster-aside">
                    <ui:VisualElement class="roster-heading" picking-mode="Ignore">
                        <ui:Label text="Assemble your crew" class="title-xl" picking-mode="Ignore" />
                        <ui:Label name="roster-instruction" text="Pick 5. Repeats are allowed. Select a filled slot to remove it." class="label label--sm roster-instruction" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="toy-card match-summary" picking-mode="Ignore">
                        <ui:Label name="roster-count-label" text="Pick 5 units" class="summary-headline" picking-mode="Ignore" />
                        <ui:VisualElement class="summary-row" picking-mode="Ignore">
                            <ui:Label text="Mode" class="summary-row__key" picking-mode="Ignore" />
                            <ui:Label name="mode-summary" text="Elimination" class="summary-row__value" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="summary-row" picking-mode="Ignore">
                            <ui:Label text="Opponent" class="summary-row__key" picking-mode="Ignore" />
                            <ui:Label name="opponent-summary" text="Player" class="summary-row__value" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="summary-row summary-row--last" picking-mode="Ignore">
                            <ui:Label text="Visibility" class="summary-row__key" picking-mode="Ignore" />
                            <ui:Label name="fog-summary" text="Fog on" class="summary-row__value" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="toy-card map-column" picking-mode="Ignore">
                        <ui:Label text="The board" class="section-label map-label" picking-mode="Ignore" />
                        <ui:VisualElement name="map-preview" class="map-preview" picking-mode="Ignore" />
                        <ui:Label text="Industrial sector · 15 × 10" class="map-caption" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="roster-model-stage" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement class="roster-main">
                    <ui:Label text="All units" class="section-label" picking-mode="Ignore" />
                    <ui:ScrollView name="roster-options" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" class="roster-options" />
                </ui:VisualElement>

                <ui:VisualElement class="roster-crew">
                    <ui:Label text="Your crew" class="section-label" picking-mode="Ignore" />
                    <ui:VisualElement name="selected-roster" class="selected-roster" />
                    <ui:Label name="selection-status" class="status-line selection-status" />
                    <ui:Button name="confirm-selection-button" enabled="false" class="button button--primary confirm-button">
                        <ui:VisualElement class="toy-icon toy-icon--check" picking-mode="Ignore" />
                        <ui:Label text="Confirm" class="toy-button__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
