<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="unit-option-template" src="../Shared/Templates/UnitOption.uxml" />
    <ui:Template name="selected-slot-template" src="../Shared/Templates/SelectedSlot.uxml" />
    <ui:Style src="../Shared/BattlePlan.uss" />
    <ui:Style src="../Shared/TacticalToybox.uss" />
    <ui:Style src="CharacterSelectionToybox.uss" />
    <ui:VisualElement name="screen" class="screen toybox-screen toybox-ui roster-screen">
        <ui:VisualElement class="toy-vignette" picking-mode="Ignore" />
        <ui:VisualElement class="toy-scrim-left roster-scrim" picking-mode="Ignore" />
        <ui:VisualElement class="toy-scrim-bottom" picking-mode="Ignore" />
        <ui:ScrollView mode="Vertical" class="screen-frame roster-frame" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
            <ui:VisualElement class="roster-header" picking-mode="Ignore">
                <ui:Label text="Crew select" class="section-label" picking-mode="Ignore" />
                <ui:Label text="Assemble your crew" class="title-xl roster-title" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="roster-model-stage" picking-mode="Ignore" />

            <ui:VisualElement class="roster-console toy-panel">
                <ui:VisualElement class="roster-body">
                    <ui:VisualElement class="unit-library">
                        <ui:VisualElement class="library-head">
                            <ui:Label text="Units" class="section-label library-head__label" picking-mode="Ignore" />
                            <ui:VisualElement name="class-filters" class="class-chips" />
                        </ui:VisualElement>
                        <ui:ScrollView name="roster-options" mode="Vertical" class="roster-options" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
                    </ui:VisualElement>
                    <ui:VisualElement class="match-rail">
                        <ui:Label text="The match" class="section-label match-rail__label" picking-mode="Ignore" />
                        <ui:VisualElement name="map-preview" class="map-preview" picking-mode="Ignore" />
                        <ui:Label name="map-caption" text="Concourse · 15 × 10" class="map-caption" picking-mode="Ignore" />
                        <ui:VisualElement class="match-summary" picking-mode="Ignore">
                            <ui:VisualElement class="summary-row" picking-mode="Ignore">
                                <ui:Label text="Mode" class="summary-row__key" picking-mode="Ignore" />
                                <ui:Label name="mode-summary" text="Elimination" class="summary-row__value" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="summary-row" picking-mode="Ignore">
                                <ui:Label text="Opponent" class="summary-row__key" picking-mode="Ignore" />
                                <ui:Label name="opponent-summary" text="Player" class="summary-row__value" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="summary-row" picking-mode="Ignore">
                                <ui:Label text="Visibility" class="summary-row__key" picking-mode="Ignore" />
                                <ui:Label name="fog-summary" text="Fog on" class="summary-row__value" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="selection-dock">
                    <ui:VisualElement class="selection-column">
                        <ui:VisualElement class="selection-head" picking-mode="Ignore">
                            <ui:Label text="Your crew" class="section-label selection-head__label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="selected-roster" class="selected-roster" />
                    </ui:VisualElement>
                    <ui:VisualElement class="confirm-column">
                        <ui:Label name="selection-status" class="label label--muted selection-status" />
                        <ui:Button name="confirm-selection-button" enabled="false" class="button button--primary confirm-button">
                            <ui:VisualElement class="toy-icon toy-icon--check" picking-mode="Ignore" />
                            <ui:Label text="Confirm" class="toy-button__label confirm-button__label" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>

        <!-- Raised once both crews are in, so this screen is already gone before the match scene
             replaces it. Last in the tree because it has to cover every band and panel above. -->
        <ui:VisualElement name="deploy-curtain" class="deploy-curtain" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
